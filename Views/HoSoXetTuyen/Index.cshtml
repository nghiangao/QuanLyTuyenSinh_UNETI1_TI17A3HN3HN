@*
//Họ và tên: Nguyễn Đức Nghĩa
//Mã sinh viên: 23103100307
//Nội dung thực hiện: Giao diện danh sách hồ sơ xét tuyển, tìm kiếm, lọc, sắp xếp và phân trang LINQ (Task M4.1).
*@
@model QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.ViewModels.HoSoXetTuyenIndexViewModel
@using QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models

@{
    ViewData["Title"] = "Danh sách hồ sơ xét tuyển";
}

<div class="container-fluid py-3">
    <!-- Tiêu đề và thống kê -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h3 class="fw-bold text-primary mb-1">
                📋 Quản lý hồ sơ xét tuyển
            </h3>
            <p class="text-muted small mb-0">Module 4 - Tiếp nhận hồ sơ, sơ tuyển, theo dõi trạng thái và kiểm soát chỉ tiêu</p>
        </div>
    </div>

    <!-- 4 Cards thống kê nhanh -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm bg-primary bg-opacity-10 text-primary h-100">
                <div class="card-body py-3 d-flex align-items-center">
                    <div class="display-6 me-3">📁</div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.TotalAll</div>
                        <div class="small fw-semibold">Tổng số hồ sơ</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm bg-warning bg-opacity-10 text-dark h-100">
                <div class="card-body py-3 d-flex align-items-center">
                    <div class="display-6 me-3">⏳</div>
                    <div>
                        <div class="fs-4 fw-bold text-warning">@Model.TotalChoDuyet</div>
                        <div class="small fw-semibold">Hồ sơ chờ sơ tuyển</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm bg-info bg-opacity-10 text-info h-100">
                <div class="card-body py-3 d-flex align-items-center">
                    <div class="display-6 me-3">✅</div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.TotalDatSoTuyen</div>
                        <div class="small fw-semibold">Đạt sơ tuyển</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 shadow-sm bg-success bg-opacity-10 text-success h-100">
                <div class="card-body py-3 d-flex align-items-center">
                    <div class="display-6 me-3">🎓</div>
                    <div>
                        <div class="fs-4 fw-bold">@Model.TotalTrungTuyen</div>
                        <div class="small fw-semibold">Đã trúng tuyển</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>Thành công!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>Thông báo lỗi:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Khu vực Bộ lọc, Tìm kiếm và Sắp xếp -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-light py-2">
            <span class="fw-semibold text-secondary">🔍 Bộ lọc tìm kiếm & sắp xếp</span>
        </div>
        <div class="card-body">
            <form method="get" asp-action="Index">
                <div class="row g-2 mb-2">
                    <div class="col-md-5">
                        <label class="form-label small fw-semibold text-muted">Từ khóa tìm kiếm</label>
                        <input type="text" name="SearchKeyword" value="@Model.SearchKeyword" class="form-control"
                               placeholder="Nhập họ tên thí sinh hoặc tên ngành tuyển sinh..." />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted">Lọc theo Khoa</label>
                        <select name="MaKhoa" asp-items="Model.KhoaList" class="form-select">
                            <option value="">-- Tất cả các khoa --</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold text-muted">Lọc theo Trạng thái hồ sơ</label>
                        <select name="TrangThai" asp-items="Model.TrangThaiList" class="form-select">
                            <option value="">-- Tất cả trạng thái --</option>
                        </select>
                    </div>
                </div>

                <div class="row g-2 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted">Ngày nộp từ</label>
                        <input type="date" name="NgayNopTu" value="@(Model.NgayNopTu?.ToString("yyyy-MM-dd"))" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted">Ngày nộp đến</label>
                        <input type="date" name="NgayNopDen" value="@(Model.NgayNopDen?.ToString("yyyy-MM-dd"))" class="form-control" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-semibold text-muted">Sắp xếp theo</label>
                        <select name="SortOrder" class="form-select">
                            <option value="ngaynop_desc" selected="@(Model.SortOrder == "ngaynop_desc")">Ngày nộp mới nhất</option>
                            <option value="ngaynop_asc" selected="@(Model.SortOrder == "ngaynop_asc")">Ngày nộp cũ nhất</option>
                            <option value="hoten_asc" selected="@(Model.SortOrder == "hoten_asc")">Họ tên thí sinh (A - Z)</option>
                            <option value="hoten_desc" selected="@(Model.SortOrder == "hoten_desc")">Họ tên thí sinh (Z - A)</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            Lọc dữ liệu
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            Đặt lại
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Bảng danh sách hồ sơ xét tuyển -->
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold text-dark">
                Danh sách hồ sơ xét tuyển (@Model.TotalItems hồ sơ)
            </h5>
            <span class="badge bg-secondary">Trang @Model.PageNumber / @Math.Max(1, Model.TotalPages)</span>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-secondary">
                    <tr>
                        <th style="width: 70px;">Mã HS</th>
                        <th>Họ tên thí sinh</th>
                        <th>Ngành xét tuyển</th>
                        <th>Khoa</th>
                        <th class="text-center">Điểm THPT</th>
                        <th class="text-center">Tổ hợp</th>
                        <th>Ngày nộp</th>
                        <th class="text-center">Trạng thái</th>
                        <th class="text-center" style="width: 170px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Items.Any())
                    {
                        foreach (var item in Model.Items)
                        {
                            <tr>
                                <td class="fw-bold text-muted">#@item.MaHoSo</td>
                                <td>
                                    <div class="fw-bold text-dark">@item.HoTenThiSinh</div>
                                    <small class="text-muted">
                                        @item.GioiTinh | Sinh: @item.NgaySinh.ToString("dd/MM/yyyy")
                                    </small>
                                </td>
                                <td>
                                    <div class="fw-semibold">@item.TenNganh</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">@item.TenKhoa</span>
                                </td>
                                <td class="text-center fw-bold">
                                    @(item.DiemThiTHPT.HasValue ? item.DiemThiTHPT.Value.ToString("F2") : "—")
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary-subtle text-secondary border">@(string.IsNullOrWhiteSpace(item.ToHopThiSinh) ? "—" : item.ToHopThiSinh)</span>
                                </td>
                                <td>
                                    <div>@item.NgayNop.ToString("dd/MM/yyyy")</div>
                                    <small class="text-muted">@item.NgayNop.ToString("HH:mm")</small>
                                </td>
                                <td class="text-center">
                                    @switch (item.TrangThai)
                                    {
                                        case TrangThaiHoSo.ChoDuyet:
                                            <span class="badge bg-warning text-dark px-2 py-1">⏳ @item.TrangThai</span>
                                            break;
                                        case TrangThaiHoSo.DatSoTuyen:
                                            <span class="badge bg-info text-dark px-2 py-1">✅ @item.TrangThai</span>
                                            break;
                                        case TrangThaiHoSo.KhongDatSoTuyen:
                                            <span class="badge bg-danger px-2 py-1">❌ @item.TrangThai</span>
                                            break;
                                        case TrangThaiHoSo.ChoPhongVan:
                                            <span class="badge bg-primary px-2 py-1">📅 @item.TrangThai</span>
                                            break;
                                        case TrangThaiHoSo.DaPhongVan:
                                            <span class="badge bg-secondary px-2 py-1">🎤 @item.TrangThai</span>
                                            break;
                                        case TrangThaiHoSo.TrungTuyen:
                                            <span class="badge bg-success px-2 py-1">🎉 @item.TrangThai</span>
                                            break;
                                        case TrangThaiHoSo.KhongTrungTuyen:
                                            <span class="badge bg-dark px-2 py-1">🚫 @item.TrangThai</span>
                                            break;
                                        case TrangThaiHoSo.DaHuy:
                                            <span class="badge bg-secondary px-2 py-1">🗑️ @item.TrangThai</span>
                                            break;
                                        default:
                                            <span class="badge bg-light text-dark border">@item.TrangThai</span>
                                            break;
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.MaHoSo" class="btn btn-outline-info" title="Xem chi tiết hồ sơ">
                                            Chi tiết
                                        </a>
                                        @if (item.TrangThai == TrangThaiHoSo.ChoDuyet)
                                        {
                                            <a asp-action="SoTuyen" asp-route-id="@item.MaHoSo" class="btn btn-warning fw-semibold" title="Thực hiện sơ tuyển hồ sơ">
                                                Sơ tuyển
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <h5>Không tìm thấy hồ sơ xét tuyển nào phù hợp với điều kiện tìm kiếm.</h5>
                                <p class="small mb-0">Vui lòng thay đổi từ khóa hoặc bộ lọc để thử lại.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang Server-Side -->
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-between align-items-center py-3">
                <div class="text-muted small">
                    Hiển thị trang <strong>@Model.PageNumber</strong> / <strong>@Model.TotalPages</strong>
                    (Tổng cộng: <strong>@Model.TotalItems</strong> hồ sơ)
                </div>
                <nav aria-label="Phân trang hồ sơ">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber - 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchKeyword="@Model.SearchKeyword"
                               asp-route-maKhoa="@Model.MaKhoa"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-ngayNopTu="@(Model.NgayNopTu?.ToString("yyyy-MM-dd"))"
                               asp-route-ngayNopDen="@(Model.NgayNopDen?.ToString("yyyy-MM-dd"))"
                               asp-route-sortOrder="@Model.SortOrder">
                                &laquo; Trước
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@i"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-searchKeyword="@Model.SearchKeyword"
                                   asp-route-maKhoa="@Model.MaKhoa"
                                   asp-route-trangThai="@Model.TrangThai"
                                   asp-route-ngayNopTu="@(Model.NgayNopTu?.ToString("yyyy-MM-dd"))"
                                   asp-route-ngayNopDen="@(Model.NgayNopDen?.ToString("yyyy-MM-dd"))"
                                   asp-route-sortOrder="@Model.SortOrder">
                                    @i
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-pageNumber="@(Model.PageNumber + 1)"
                               asp-route-pageSize="@Model.PageSize"
                               asp-route-searchKeyword="@Model.SearchKeyword"
                               asp-route-maKhoa="@Model.MaKhoa"
                               asp-route-trangThai="@Model.TrangThai"
                               asp-route-ngayNopTu="@(Model.NgayNopTu?.ToString("yyyy-MM-dd"))"
                               asp-route-ngayNopDen="@(Model.NgayNopDen?.ToString("yyyy-MM-dd"))"
                               asp-route-sortOrder="@Model.SortOrder">
                                Sau &raquo;
                            </a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

