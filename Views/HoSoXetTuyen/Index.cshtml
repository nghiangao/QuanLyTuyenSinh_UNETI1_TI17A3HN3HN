    }

    .hs-blue {
        background: var(--soft);
        color: var(--primary);
    }

    .hs-amber {
        background: #fff5e3;
        color: #99611b;
    }

    .hs-green {
        background: #eaf6ee;
        color: #23734d;
    }

    .hs-red {
        background: #fceeef;
        color: #b43d43;
    }

    .hs-grey {
        background: #eef1f5;
        color: var(--muted);
    }

    .hs-empty {
        text-align: center;
        padding: 36px;
        color: var(--muted);
    }

    .hs-paging {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
        gap: 12px;
        flex-wrap: wrap;
    }

    .hs-paging .m {
        font-size: 12px;
        color: var(--muted);
    }

    .hs-ctl {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .hs-note {
        background: var(--soft);
        border-radius: 6px;
        padding: 16px;
    }

    .hs-note b {
        display: block;
        font-size: 13px;
        color: var(--primary);
        margin-bottom: 6px;
    }

    .hs-note span {
        font-size: 14px;
    }

    .hs-foot {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid var(--line);
