    }

    .hs-table th {
        background: var(--bg);
        color: var(--muted);
        font-weight: 600;
        font-size: 12px;
        text-align: left;
        padding: 13px 14px;
        white-space: nowrap;
    }

    .hs-table td {
        padding: 15px 14px;
        border-top: 1px solid var(--line);
        vertical-align: middle;
    }

    .hs-table tbody tr:hover td {
        background: #f8fafd;
    }

    .hs-table .id {
        font-weight: 600;
        white-space: nowrap;
    }

    .hs-table .sm {
        display: block;
        font-size: 12px;
