    }

    .hs-input:focus {
        outline: 2px solid var(--soft);
        border-color: var(--primary);
    }

    .hs-toggle {
        background: none;
        border: 0;
        padding: 0;
        margin: 16px 0;
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
        cursor: pointer;
    }

    .hs-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .hs-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        border: 1px solid var(--line);
        background: #fff;
        color: var(--ink);
        text-decoration: none;
        cursor: pointer;
        line-height: 1.3;
        white-space: nowrap;
    }

    .hs-btn:hover {
        background: var(--bg);
        color: var(--ink);
    }

    .hs-btn-primary {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
    }

    .hs-btn-primary:hover {
        background: #1a4786;
        color: #fff;
    }

    .hs-btn-sm {
        padding: 6px 12px;
        font-size: 12px;
    }

    .hs-btn.disabled {
        background: var(--bg);
        color: var(--muted);
