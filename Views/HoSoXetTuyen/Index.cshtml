        --ink: #182b46;
        --muted: #63738a;
        --line: #dee5ee;
        --bg: #f3f6fa;
        --primary: #2057a5;
        --soft: #eaf1fc;
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
        color: var(--ink);
    }

    .hs * {
        box-sizing: border-box;
    }

    .hs-crumb {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--primary);
        margin-bottom: 12px;
    }

    .hs h1 {
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 8px;
        line-height: 1.2;
    }

    .hs-sub {
        font-size: 14px;
        color: var(--muted);
        margin: 0 0 24px;
    }

    .hs-kpis {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 24px;
    }

    .hs-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .hs-card h2 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 16px;
    }

    .hs-kpi {
        padding: 20px;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .hs-kpi .l {
        font-size: 13px;
        color: var(--muted);
    }

    .hs-kpi .v {
        font-size: 30px;
        font-weight: 700;
        color: var(--primary);
        line-height: 1.2;
    }

    .hs-kpi .s {
        font-size: 12px;
        color: var(--muted);
    }

    .hs-grid {
        display: grid;
        gap: 20px;
    }

    .hs-grid-2 {
        grid-template-columns: 1fr 1fr;
    }

    .hs-field label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .hs-input {
