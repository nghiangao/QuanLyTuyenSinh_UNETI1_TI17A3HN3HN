    }

    .hs-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 8px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        background: var(--soft);
        color: var(--primary);
