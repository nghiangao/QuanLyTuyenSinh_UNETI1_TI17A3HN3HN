    }

    @@media (max-width:992px) {

        .hs-kpis,
        .hs-grid-2 {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="hs">
    <div class="hs-crumb">21 / Cán bộ tuyển sinh / Xử lý hồ sơ</div>
    <h1>Xử lý hồ sơ xét tuyển</h1>
    <p class="hs-sub">@Model.TotalAll hồ sơ · Tra cứu theo thí sinh, ngành và từng giai đoạn. Chỉ sơ tuyển hồ sơ Chờ
        duyệt.</p>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <strong>Thành công!</strong> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <strong>Thông báo lỗi:</strong> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
            </div>
        }

        @* ===== Chỉ số nhanh ===== *@
        <div class="hs-kpis">
            <div class="hs-card hs-kpi">
                <span class="l">Tất cả hồ sơ</span>
                <span class="v">@Model.TotalAll</span>
            </div>
            <div class="hs-card hs-kpi">
                <span class="l">Chờ duyệt</span>
                <span class="v">@Model.TotalChoDuyet</span>
            </div>
            <div class="hs-card hs-kpi">
                <span class="l">Đạt sơ tuyển</span>
                <span class="v">@Model.TotalDatSoTuyen</span>
                <span class="s">Chưa có lịch hiệu lực</span>
            </div>
        </div>

        @* ===== Tìm kiếm & bộ lọc ===== *@
        <form method="get" asp-action="Index" class="hs-card">
            <h2>Tìm kiếm &amp; bộ lọc</h2>
            <div class="hs-grid hs-grid-2">
                <div class="hs-field">
                    <label for="SearchKeyword">Tìm kiếm</label>
                    <input id="SearchKeyword" type="text" name="SearchKeyword" value="@Model.SearchKeyword" class="hs-input"
                           placeholder="Tên thí sinh hoặc tên ngành…" />
                </div>
                <div class="hs-field">
                    <label for="SortOrder">Sắp xếp</label>
                    <select id="SortOrder" name="SortOrder" class="hs-input">
                        <option value="ngaynop_desc" selected="@(Model.SortOrder == "ngaynop_desc")">Ngày nộp mới nhất
                        </option>
                        <option value="ngaynop_asc" selected="@(Model.SortOrder == "ngaynop_asc")">Ngày nộp cũ nhất</option>
                        <option value="hoten_asc" selected="@(Model.SortOrder == "hoten_asc")">Họ tên thí sinh (A – Z)
                        </option>
                        <option value="hoten_desc" selected="@(Model.SortOrder == "hoten_desc")">Họ tên thí sinh (Z – A)
                        </option>
                    </select>
                </div>
            </div>

            <button type="button" class="hs-toggle" id="hsToggle" aria-expanded="@(coLocNangCao ? "true" : "false")">
                Bộ lọc nâng cao <span id="hsIcon">@(coLocNangCao ? "▴" : "▾")</span>
            </button>

            <div id="hsAdvanced" style="display:@(coLocNangCao ? "block" : "none")">
                <div class="hs-grid" style="grid-template-columns:repeat(3,1fr)">
                    <div class="hs-field">
                        <label for="MaKhoa">Khoa</label>
                        <select id="MaKhoa" name="MaKhoa" asp-items="Model.KhoaList" class="hs-input">
                            <option value="">Tất cả khoa</option>
                        </select>
                    </div>
                    <div class="hs-field">
                        <label for="TrangThai">Trạng thái hồ sơ</label>
                        <select id="TrangThai" name="TrangThai" asp-items="Model.TrangThaiList" class="hs-input">
                            <option value="">Tất cả trạng thái</option>
                        </select>
                    </div>
                    <div class="hs-field">
                        <label>Ngày nộp từ – đến</label>
                        <div class="d-flex gap-2 align-items-center">
                            <input type="date" name="NgayNopTu" value="@tuNgay" class="hs-input" aria-label="Ngày nộp từ" />
                            <span>–</span>
                            <input type="date" name="NgayNopDen" value="@denNgay" class="hs-input"
                                   aria-label="Ngày nộp đến" />
                        </div>
                    </div>
                </div>
            </div>

            <div class="hs-actions">
                <button type="submit" class="hs-btn hs-btn-primary">Áp dụng</button>
                <a asp-action="Index" class="hs-btn">Xóa bộ lọc</a>
                @if (!string.IsNullOrWhiteSpace(Model.SearchKeyword))
                {
                    <a class="hs-chip" href="@BoLoc("searchKeyword")">Từ khóa: @Model.SearchKeyword ×</a>
                }
                @if (!string.IsNullOrEmpty(Model.MaKhoa?.ToString()))
                {
                    var tenKhoa = Model.KhoaList?.FirstOrDefault(x => x.Value == Model.MaKhoa?.ToString())?.Text ??
                Model.MaKhoa?.ToString();
                    <a class="hs-chip" href="@BoLoc("maKhoa")">Khoa: @tenKhoa ×</a>
                }
                @if (!string.IsNullOrEmpty(Model.TrangThai?.ToString()))
                {
                    <a class="hs-chip" href="@BoLoc("trangThai")">@Model.TrangThai ×</a>
                }
                @if (Model.NgayNopTu.HasValue || Model.NgayNopDen.HasValue)
                {
                    <a class="hs-chip" href="@BoLoc("ngayNop")">
                        Ngày nộp: @(Model.NgayNopTu?.ToString("dd/MM") ?? "…")–@(Model.NgayNopDen?.ToString("dd/MM") ?? "…") ×
                    </a>
                }
            </div>
            <p class="hs-hint">Điều kiện tìm kiếm, lọc và sắp xếp được giữ khi chuyển trang. Sắp xếp theo ngày nộp tăng /
                giảm hoặc tên thí sinh A–Z / Z–A.</p>
            </form>

            @* ===== Danh sách hồ sơ ===== *@
            <div class="hs-card">
                <h2>Danh sách hồ sơ</h2>
                <div class="hs-wrap">
                    <table class="hs-table">
                        <thead>
                            <tr>
                                <th>Mã hồ sơ</th>
                                <th>Thí sinh</th>
                                <th>Ngành</th>
                                <th>Ngày nộp</th>
                                <th>Trạng thái</th>
                                <th style="text-align:right">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in items)
                            {
                                <tr>
                                    <td class="id">HS@(item.MaHoSo.ToString().PadLeft(4, '0'))</td>
                                    <td>
                                        <strong>@item.HoTenThiSinh</strong>
                                        <span class="sm">
                                            @item.GioiTinh · Sinh @item.NgaySinh.ToString("dd/MM/yyyy")
                                            @if (item.DiemThiTHPT.HasValue)
                                            {
                                                <text> ·
@item.DiemThiTHPT.Value.ToString("F2")@(string.IsNullOrWhiteSpace(item.ToHopThiSinh)
                                    ? "" : " (" + item.ToHopThiSinh + ")")</text>
                                                }
                                            </span>
                                        </td>
                                        <td>@item.TenNganh<span class="sm">@item.TenKhoa</span></td>
                                        <td>@item.NgayNop.ToString("dd/MM/yyyy")<span class="sm">@item.NgayNop.ToString("HH:mm")</span>
                                        </td>
                                        <td><span class="@BadgeClass(item.TrangThai)">@item.TrangThai</span></td>
                                        <td style="text-align:right; white-space:nowrap">
                                            @* Thao tác phù hợp với từng trạng thái, không có đổi trạng thái tùy ý *@
                                            @switch (item.TrangThai)
                                            {
                                                case TrangThaiHoSo.ChoDuyet:
                                                    <a asp-action="SoTuyen" asp-route-id="@item.MaHoSo"
                                                       class="hs-btn hs-btn-sm hs-btn-primary">Sơ tuyển</a>
                                                    break;
                                                case TrangThaiHoSo.DatSoTuyen:
                                                    <a asp-controller="LichPhongVan" asp-action="Create" asp-route-maHoSo="@item.MaHoSo"
                                                       class="hs-btn hs-btn-sm hs-btn-primary">Lập lịch</a>
                                                    break;
                                                case TrangThaiHoSo.ChoPhongVan:
                                                    <a asp-controller="LichPhongVan" asp-action="Index" asp-route-tuKhoa="@item.MaHoSo"
                                                       class="hs-btn hs-btn-sm hs-btn-primary">Xem lịch</a>
                                                    break;
                                                case TrangThaiHoSo.DaPhongVan:
                                                    <a asp-controller="LichPhongVan" asp-action="Index" asp-route-tuKhoa="@item.MaHoSo"
                                                       class="hs-btn hs-btn-sm hs-btn-primary">Ghi kết quả</a>
                                                    break;
                                            }
                                            <a asp-action="Details" asp-route-id="@item.MaHoSo" class="hs-btn hs-btn-sm">Xem chi
                                                tiết</a>
                                            </td>
                                        </tr>
                                    }
                                    @if (!items.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="hs-empty">
                                                <strong>Không tìm thấy hồ sơ xét tuyển nào phù hợp.</strong><br />
                                                <span style="font-size:12px">Vui lòng thay đổi từ khóa hoặc bộ lọc để thử lại.</span>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="hs-paging">
                            <span class="m">@batDau–@ketThuc / @Model.TotalItems bản ghi · @Model.PageSize / trang</span>
                            <div class="hs-ctl">
                                <a class="hs-btn @(Model.HasPreviousPage ? "" : "disabled")"
                                   href="@Trang(Math.Max(Model.PageNumber - 1, 1))">‹ Trước</a>
                                <span class="hs-chip">Trang @Model.PageNumber / @tongTrang</span>
                                <a class="hs-btn @(Model.HasNextPage ? "" : "disabled")"
                                   href="@Trang(Math.Min(Model.PageNumber + 1, tongTrang))">Sau ›</a>
                            </div>
                        </div>
                    </div>

                    <div class="hs-note">
                        <b>Thao tác phù hợp với từng trạng thái</b>
                        <span>Chờ duyệt → Sơ tuyển; Đạt sơ tuyển → Lập lịch; Chờ phỏng vấn → Xem lịch; Đã phỏng vấn → Ghi kết quả. Không
                            có danh sách đổi trạng thái tùy ý.</span>
                        </div>

                        <div class="hs-foot">
                            <span>Đề tài 21 · Nhóm 5 · ASP.NET Core MVC</span>
                        </div>
                    </div>

                    @section Scripts {
                        <script>
                            (function () {
                                var tg = document.getElementById('hsToggle'), adv = document.getElementById('hsAdvanced'), ic = document.getElementById('hsIcon');
                                tg.addEventListener('click', function () {
                                    var open = adv.style.display === 'none';
                                    adv.style.display = open ? 'block' : 'none';
                                    ic.textContent = open ? '▴' : '▾';
                                    tg.setAttribute('aria-expanded', open);
                                });
                            })();
                        </script>
                    }
