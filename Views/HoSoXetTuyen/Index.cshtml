@*
//Họ và tên: Nguyễn Đức Nghĩa
//Mã sinh viên: 23103100307
//Nội dung thực hiện: Giao diện danh sách hồ sơ xét tuyển, tìm kiếm, lọc, sắp xếp và phân trang LINQ (Task M4.1).
//Dàn lại theo thiết kế Figma "21 · Xử lý hồ sơ xét tuyển": thao tác theo từng trạng thái,
//bộ lọc nâng cao thu gọn được, chip điều kiện lọc, phân trang giữ điều kiện.
//
//GHI CHÚ: các action đoán tên, cần đối chiếu với controller:
//  Lập lịch  -> LichPhongVan/Create (route maHoSo)
//  Xem lịch  -> LichPhongVan/Index  (route tuKhoa = mã hồ sơ)
//  Ghi kết quả -> HoSoXetTuyen/KetQua (route id)
*@
@model QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.ViewModels.HoSoXetTuyenIndexViewModel
@using QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models

@{
    ViewData["Title"] = "Xử lý hồ sơ xét tuyển";

    var items = Model.Items.ToList();
    int tongTrang = Math.Max(1, Model.TotalPages);
    int batDau = items.Count == 0 ? 0 : (Model.PageNumber - 1) * Model.PageSize + 1;
    int ketThuc = items.Count == 0 ? 0 : batDau + items.Count - 1;

    string tuNgay = Model.NgayNopTu?.ToString("yyyy-MM-dd") ?? "";
    string denNgay = Model.NgayNopDen?.ToString("yyyy-MM-dd") ?? "";
    bool coLocNangCao = !string.IsNullOrEmpty(Model.MaKhoa?.ToString())
                     || !string.IsNullOrEmpty(Model.TrangThai?.ToString())
                     || Model.NgayNopTu.HasValue || Model.NgayNopDen.HasValue;
    bool coLoc = coLocNangCao || !string.IsNullOrWhiteSpace(Model.SearchKeyword);

    // Liên kết phân trang, luôn giữ nguyên điều kiện tìm kiếm / lọc / sắp xếp
    string Trang(int p) => Url.Action("Index", new
    {
        pageNumber = p,
        pageSize = Model.PageSize,
        searchKeyword = Model.SearchKeyword,
        maKhoa = Model.MaKhoa,
        trangThai = Model.TrangThai,
        ngayNopTu = tuNgay == "" ? null : tuNgay,
        ngayNopDen = denNgay == "" ? null : denNgay,
        sortOrder = Model.SortOrder
    })!;

    // Bỏ một điều kiện lọc khi bấm vào chip ×
    string BoLoc(string ten) => Url.Action("Index", new
    {
        pageSize = Model.PageSize,
        searchKeyword = ten == "searchKeyword" ? null : Model.SearchKeyword,
        maKhoa = ten == "maKhoa" ? null : Model.MaKhoa?.ToString(),
        trangThai = ten == "trangThai" ? null : Model.TrangThai?.ToString(),
        ngayNopTu = ten == "ngayNop" || tuNgay == "" ? null : tuNgay,
        ngayNopDen = ten == "ngayNop" || denNgay == "" ? null : denNgay,
        sortOrder = Model.SortOrder
    })!;

    string BadgeClass(string? tt) => tt switch
    {
        TrangThaiHoSo.ChoDuyet => "hs-badge hs-amber",
        TrangThaiHoSo.TrungTuyen => "hs-badge hs-green",
        TrangThaiHoSo.KhongDatSoTuyen => "hs-badge hs-red",
        TrangThaiHoSo.KhongTrungTuyen => "hs-badge hs-red",
        TrangThaiHoSo.DaHuy => "hs-badge hs-grey",
        _ => "hs-badge hs-blue"   // Đạt sơ tuyển, Chờ phỏng vấn, Đã phỏng vấn
    };
}

<style>
