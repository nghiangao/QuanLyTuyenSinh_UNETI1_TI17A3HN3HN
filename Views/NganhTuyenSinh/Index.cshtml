@*
    Họ và tên: Đào Văn Khánh
    Mã sinh viên: 23103100125
    Nội dung thực hiện: Module 2.1-2.6 - Quản lý, tìm kiếm, lọc, sắp xếp và phân trang ngành.
*@
@model IEnumerable<NganhTuyenSinh>

@{
    ViewData["Title"] = "Ngành tuyển sinh";
    string? search = ViewBag.Search as string;
    int? maKhoa = ViewBag.MaKhoa as int?;
    string? toHop = ViewBag.ToHop as string;
    string? trangThai = ViewBag.TrangThai as string;
    decimal? diemToiThieu = ViewBag.DiemToiThieu as decimal?;
    string? tinhTrangNhanHoSo = ViewBag.TinhTrangNhanHoSo as string;
    string? sort = ViewBag.Sort as string;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <div>
        <h1 class="h3 mb-1">Ngành tuyển sinh</h1>
        <p class="text-muted mb-0">@ViewBag.TotalItems ngành phù hợp</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Thêm ngành</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Index" method="get" class="border rounded p-3 mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-12 col-md-4">
            <label for="search" class="form-label">Từ khóa</label>
            <input id="search" name="search" value="@search" class="form-control" placeholder="Tên ngành hoặc khoa" />
        </div>
        <div class="col-6 col-md-2">
            <label for="maKhoa" class="form-label">Khoa</label>
            <select id="maKhoa" name="maKhoa" asp-items="ViewBag.Khoas" class="form-select">
                <option value="">Tất cả khoa</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label for="toHop" class="form-label">Tổ hợp</label>
            <input id="toHop" name="toHop" value="@toHop" class="form-control" placeholder="A00, D01..." />
        </div>
        <div class="col-6 col-md-2">
            <label for="trangThai" class="form-label">Trạng thái</label>
            <select id="trangThai" name="trangThai" class="form-select">
                <option value="">Tất cả</option>
                @foreach (var state in new[] { TrangThaiNganh.ChuaMo, TrangThaiNganh.DangTuyen, TrangThaiNganh.TamDung, TrangThaiNganh.DaDong })
                {
                    <option value="@state" selected="@(state == trangThai)">@state</option>
                }
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label for="diemToiThieu" class="form-label">Điểm tối thiểu từ</label>
            <input id="diemToiThieu" name="diemToiThieu" type="number" min="0" max="30" step="0.01" value="@diemToiThieu" class="form-control" />
        </div>
        <div class="col-6 col-md-2">
            <label for="tinhTrangNhanHoSo" class="form-label">Hạn hồ sơ</label>
            <select id="tinhTrangNhanHoSo" name="tinhTrangNhanHoSo" class="form-select">
                <option value="">Tất cả</option>
                <option value="conHan" selected="@(tinhTrangNhanHoSo == "conHan")">Còn hạn nhận hồ sơ</option>
                <option value="hetHan" selected="@(tinhTrangNhanHoSo == "hetHan")">Đã hết hạn</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label for="sort" class="form-label">Sắp xếp</label>
            <select id="sort" name="sort" class="form-select">
                <option value="">Tên A-Z</option>
                <option value="ten_desc" selected="@(sort == "ten_desc")">Tên Z-A</option>
                <option value="han_asc" selected="@(sort == "han_asc")">Hạn nộp tăng dần</option>
                <option value="han_desc" selected="@(sort == "han_desc")">Hạn nộp giảm dần</option>
                <option value="chiTieu_asc" selected="@(sort == "chiTieu_asc")">Chỉ tiêu tăng dần</option>
                <option value="chiTieu_desc" selected="@(sort == "chiTieu_desc")">Chỉ tiêu giảm dần</option>
            </select>
        </div>
        <div class="col-6 col-md-2">
            <label for="pageSize" class="form-label">Số dòng</label>
            <select id="pageSize" name="pageSize" class="form-select">
                @foreach (var size in new[] { 10, 20, 50, 100 })
                {
                    <option value="@size" selected="@(size == (int)ViewBag.PageSize)">@size</option>
                }
            </select>
        </div>
        <div class="col-12 col-md-auto d-flex gap-2">
            <button type="submit" class="btn btn-primary">Áp dụng</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Ngành</th>
                <th>Khoa</th>
                <th>Tổ hợp</th>
                <th class="text-end">Chỉ tiêu</th>
                <th class="text-end">Điểm sàn</th>
                <th>Hạn nộp</th>
                <th>Trạng thái</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            var statusLabel = item.TrangThai != TrangThaiNganh.DangTuyen
                ? item.TrangThai
                : item.DangNhanHoSo
                    ? "Đang nhận hồ sơ"
                    : item.HetHan
                        ? "Đã hết hạn"
                        : "Chưa mở nhận hồ sơ";
            <tr>
                <td class="fw-semibold">@item.TenNganh</td>
                <td>@item.Khoa?.TenKhoa</td>
                <td>@item.ToHopXetTuyen</td>
                <td class="text-end">@item.ChiTieu</td>
                <td class="text-end">@item.DiemXetTuyenToiThieu.ToString("0.##")</td>
                <td>@item.HanNopHoSo.ToString("dd/MM/yyyy")</td>
                <td><span class="badge @(item.DangNhanHoSo ? "bg-success" : item.HetHan ? "bg-secondary" : "bg-warning text-dark")">@statusLabel</span></td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.MaNganh" class="btn btn-sm btn-outline-secondary">Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@item.MaNganh" class="btn btn-sm btn-outline-primary">Sửa</a>
                    <a asp-action="Delete" asp-route-id="@item.MaNganh" class="btn btn-sm btn-outline-danger">Xóa</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>

@if (!Model.Any())
{
    <p class="text-muted">Không tìm thấy ngành tuyển sinh phù hợp.</p>
}

<nav aria-label="Phân trang ngành tuyển sinh" class="d-flex flex-wrap justify-content-between align-items-center gap-2">
    <span class="text-muted">Trang @ViewBag.Page / @ViewBag.TotalPages</span>
    <ul class="pagination mb-0">
        <li class="page-item @((int)ViewBag.Page <= 1 ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-maKhoa="@maKhoa" asp-route-toHop="@toHop" asp-route-trangThai="@trangThai" asp-route-diemToiThieu="@diemToiThieu" asp-route-tinhTrangNhanHoSo="@tinhTrangNhanHoSo" asp-route-sort="@sort" asp-route-page="@((int)ViewBag.Page - 1)" asp-route-pageSize="@ViewBag.PageSize" aria-label="Trang trước">Trước</a>
        </li>
        @for (var pageNumber = 1; pageNumber <= (int)ViewBag.TotalPages; pageNumber++)
        {
            <li class="page-item @(pageNumber == (int)ViewBag.Page ? "active" : "")">
                <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-maKhoa="@maKhoa" asp-route-toHop="@toHop" asp-route-trangThai="@trangThai" asp-route-diemToiThieu="@diemToiThieu" asp-route-tinhTrangNhanHoSo="@tinhTrangNhanHoSo" asp-route-sort="@sort" asp-route-page="@pageNumber" asp-route-pageSize="@ViewBag.PageSize">@pageNumber</a>
            </li>
        }
        <li class="page-item @((int)ViewBag.Page >= (int)ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link" asp-action="Index" asp-route-search="@search" asp-route-maKhoa="@maKhoa" asp-route-toHop="@toHop" asp-route-trangThai="@trangThai" asp-route-diemToiThieu="@diemToiThieu" asp-route-tinhTrangNhanHoSo="@tinhTrangNhanHoSo" asp-route-sort="@sort" asp-route-page="@((int)ViewBag.Page + 1)" asp-route-pageSize="@ViewBag.PageSize" aria-label="Trang sau">Sau</a>
        </li>
    </ul>
</nav>