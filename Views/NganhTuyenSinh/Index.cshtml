@*
    Họ và tên: Đào Văn Khánh
    Mã sinh viên: 23103100125
    Nội dung thực hiện: Module 2.1-2.6 - Quản lý, tìm kiếm, lọc, sắp xếp và phân trang ngành.
    Dàn lại theo thiết kế Figma "16 · Quản lý ngành tuyển sinh": bộ lọc nâng cao thu gọn được, chip điều kiện lọc,
    cảnh báo ngành Đang tuyển đã hết hạn, hạn nộp có nhãn "Hết hạn", phân trang giữ điều kiện.

    Giữ nguyên hợp đồng với controller (ViewBag + tham số GET): search, maKhoa, toHop, trangThai, diemToiThieu,
    tinhTrangNhanHoSo, sort, page, pageSize.
    ViewBag tùy chọn cho dòng mô tả đầu trang: TongNganh, SoKhoa, SoDangTuyen, SoConHan, SoHetHan (không có vẫn chạy).
*@
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<NganhTuyenSinh>

@{
    ViewData["Title"] = "Quản lý ngành tuyển sinh";
    string? search = ViewBag.Search as string;
    int? maKhoa = ViewBag.MaKhoa as int?;
    string? toHop = ViewBag.ToHop as string;
    string? trangThai = ViewBag.TrangThai as string;
    decimal? diemToiThieu = ViewBag.DiemToiThieu as decimal?;
    string? tinhTrangNhanHoSo = ViewBag.TinhTrangNhanHoSo as string;
    string? sort = ViewBag.Sort as string;

    var ds = Model.ToList();
    int page = (int)ViewBag.Page;
    int totalPages = Math.Max(1, (int)ViewBag.TotalPages);
    int pageSize = (int)ViewBag.PageSize;
    int totalItems = (int)ViewBag.TotalItems;
    int batDau = ds.Count == 0 ? 0 : (page - 1) * pageSize + 1;
    int ketThuc = ds.Count == 0 ? 0 : batDau + ds.Count - 1;

    bool coLocNangCao = maKhoa.HasValue || !string.IsNullOrWhiteSpace(toHop) || !string.IsNullOrEmpty(trangThai)
                     || diemToiThieu.HasValue || !string.IsNullOrEmpty(tinhTrangNhanHoSo) || pageSize != 10;

    // Ngành Đang tuyển nhưng đã quá hạn nộp (trong trang hiện tại)
    var hetHan = ds.Where(x => x.TrangThai == TrangThaiNganh.DangTuyen && x.HetHan).ToList();

    string Trang(int p) => Url.Action("Index", new
    {
        search,
        maKhoa,
        toHop,
        trangThai,
        diemToiThieu,
        tinhTrangNhanHoSo,
        sort,
        page = p,
        pageSize
    })!;

    // Bỏ một điều kiện lọc khi bấm chip ×
    string BoLoc(string ten) => Url.Action("Index", new
    {
        search = ten == "search" ? null : search,
        maKhoa = ten == "maKhoa" ? null : maKhoa,
        toHop = ten == "toHop" ? null : toHop,
        trangThai = ten == "trangThai" ? null : trangThai,
        diemToiThieu = ten == "diem" ? null : diemToiThieu,
        tinhTrangNhanHoSo = ten == "han" ? null : tinhTrangNhanHoSo,
        sort,
        pageSize
    })!;

    string BadgeClass(string tt) =>
        tt == TrangThaiNganh.DangTuyen ? "ng-badge ng-green"
      : tt == TrangThaiNganh.TamDung ? "ng-badge ng-amber"
      : tt == TrangThaiNganh.ChuaMo ? "ng-badge ng-blue"
      : "ng-badge ng-grey";

    var khoaList = (ViewBag.Khoas as IEnumerable<SelectListItem>)?.ToList() ?? new List<SelectListItem>();
}

<style>
    .ng {
        --ink: #182b46;
        --muted: #63738a;
        --line: #dee5ee;
        --bg: #f3f6fa;
        --primary: #2057a5;
        --soft: #eaf1fc;
        --danger: #b43d43;
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
        color: var(--ink);
    }

    .ng * {
        box-sizing: border-box;
    }

    .ng-crumb {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--primary);
        margin-bottom: 12px;
    }

    .ng-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        margin-bottom: 24px;
    }

    .ng h1 {
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 8px;
        line-height: 1.2;
    }

    .ng-sub {
        font-size: 14px;
        color: var(--muted);
        margin: 0;
    }

    .ng-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .ng-card h2 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 16px;
    }

    .ng-grid {
        display: grid;
        gap: 20px;
    }

    .ng-grid-2 {
        grid-template-columns: 1fr 1fr;
    }

    .ng-grid-3 {
        grid-template-columns: repeat(3, 1fr);
        margin-bottom: 16px;
    }

    .ng-field label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .ng-input {
        width: 100%;
        padding: 12px;
        font-size: 14px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #fff;
        color: var(--ink);
    }

    .ng-input:focus {
        outline: 2px solid var(--soft);
        border-color: var(--primary);
    }

    .ng-toggle {
        background: none;
        border: 0;
        padding: 0;
        margin: 16px 0;
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
        cursor: pointer;
    }

    .ng-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .ng-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        border: 1px solid var(--line);
        background: #fff;
        color: var(--ink);
        text-decoration: none;
        cursor: pointer;
        line-height: 1.3;
        white-space: nowrap;
    }

    .ng-btn:hover {
        background: var(--bg);
        color: var(--ink);
    }

    .ng-btn-primary {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
    }

    .ng-btn-primary:hover {
        background: #1a4786;
        color: #fff;
    }

    .ng-btn-sm {
        padding: 6px 12px;
        font-size: 12px;
    }

    .ng-btn-danger {
        color: var(--danger);
        border-color: #f0c9cb;
    }

    .ng-btn-danger:hover {
        background: #fceeef;
        color: var(--danger);
    }

    .ng-btn.disabled {
        background: var(--bg);
        color: var(--muted);
        pointer-events: none;
    }

    .ng-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 8px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        background: var(--soft);
        color: var(--primary);
        text-decoration: none;
    }

    .ng-hint {
        font-size: 12px;
        color: var(--muted);
        margin: 12px 0 0;
    }

    .ng-alert {
        background: #fff5e3;
        border-radius: 6px;
        padding: 16px;
        margin-bottom: 24px;
    }

    .ng-alert b {
        display: block;
        font-size: 13px;
        color: #99611b;
        margin-bottom: 6px;
    }

    .ng-alert span {
        font-size: 14px;
    }

    .ng-wrap {
        border: 1px solid var(--line);
        border-radius: 6px;
        overflow-x: auto;
    }

    .ng-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .ng-table th {
        background: var(--bg);
        color: var(--muted);
        font-weight: 600;
        font-size: 12px;
        text-align: left;
        padding: 13px 14px;
        white-space: nowrap;
    }

    .ng-table td {
        padding: 15px 14px;
        border-top: 1px solid var(--line);
        vertical-align: middle;
    }

    .ng-table tbody tr:hover td {
        background: #f8fafd;
    }

    .ng-table .n {
        text-align: right;
    }

    .ng-table .sm {
        display: block;
        font-size: 12px;
        color: var(--muted);
        margin-top: 2px;
    }

    .ng-table .late {
        color: var(--danger);
        font-weight: 600;
    }

    .ng-badge {
        display: inline-block;
        padding: 4px 8px;
        font-size: 11px;
        font-weight: 600;
        border-radius: 6px;
        white-space: nowrap;
    }

    .ng-blue {
        background: var(--soft);
        color: var(--primary);
    }

    .ng-amber {
        background: #fff5e3;
        color: #99611b;
    }

    .ng-green {
        background: #eaf6ee;
        color: #23734d;
    }

    .ng-grey {
        background: #eef1f5;
        color: var(--muted);
    }

    .ng-tag {
        display: inline-block;
        padding: 2px 6px;
        margin: 0 4px 0 0;
        font-size: 11px;
        font-weight: 600;
        border-radius: 4px;
        background: #f3f6fa;
        border: 1px solid var(--line);
    }

    .ng-empty {
        text-align: center;
        padding: 36px;
        color: var(--muted);
    }

    .ng-paging {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
        gap: 12px;
        flex-wrap: wrap;
    }

    .ng-paging .m {
        font-size: 12px;
        color: var(--muted);
    }

    .ng-ctl {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .ng-foot {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid var(--line);
        padding-top: 16px;
        font-size: 11px;
        color: var(--muted);
    }

    @@media (max-width:992px) {

        .ng-grid-2,
        .ng-grid-3 {
            grid-template-columns: 1fr;
        }

        .ng-head {
            flex-direction: column;
        }
    }
</style>

<div class="ng">
    <div class="ng-crumb">16 / Cán bộ tuyển sinh / Ngành tuyển sinh</div>

    <div class="ng-head">
        <div>
            <h1>Quản lý ngành tuyển sinh</h1>
            <p class="ng-sub">
                @if (ViewBag.TongNganh != null)
                {
                    <text>@ViewBag.TongNganh ngành thuộc @ViewBag.SoKhoa khoa · @ViewBag.SoDangTuyen ngành Đang tuyển, trong
                        đó @ViewBag.SoConHan còn hạn và @ViewBag.SoHetHan đã hết hạn.</text>
                    }
                else
                    {
                        <text>@totalItems ngành phù hợp với điều kiện hiện tại.</text>
                    }
                </p>
            </div>
            <a asp-action="Create" class="ng-btn ng-btn-primary">+ Tạo ngành</a>
        </div>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success shadow-sm">@TempData["Success"]</div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger shadow-sm">@TempData["Error"]</div>
        }

        @* ===== Tìm kiếm & bộ lọc ===== *@
        <form asp-action="Index" method="get" class="ng-card">
            <h2>Tìm kiếm &amp; bộ lọc</h2>
            <div class="ng-grid ng-grid-2">
                <div class="ng-field">
                    <label for="search">Tìm kiếm</label>
                    <input id="search" name="search" value="@search" class="ng-input" placeholder="Tên ngành hoặc khoa…" />
                </div>
                <div class="ng-field">
                    <label for="sort">Sắp xếp</label>
                    <select id="sort" name="sort" class="ng-input">
                        <option value="">Tên ngành A–Z</option>
                        <option value="ten_desc" selected="@(sort == "ten_desc")">Tên ngành Z–A</option>
                        <option value="han_asc" selected="@(sort == "han_asc")">Hạn nộp tăng dần</option>
                        <option value="han_desc" selected="@(sort == "han_desc")">Hạn nộp giảm dần</option>
                        <option value="chiTieu_asc" selected="@(sort == "chiTieu_asc")">Chỉ tiêu tăng dần</option>
                        <option value="chiTieu_desc" selected="@(sort == "chiTieu_desc")">Chỉ tiêu giảm dần</option>
                    </select>
                </div>
            </div>

            <button type="button" class="ng-toggle" id="ngToggle" aria-expanded="@(coLocNangCao ? "true" : "false")">
                Bộ lọc nâng cao <span id="ngIcon">@(coLocNangCao ? "▴" : "▾")</span>
            </button>

            <div id="ngAdvanced" style="display:@(coLocNangCao ? "block" : "none")">
                <div class="ng-grid ng-grid-3">
                    <div class="ng-field">
                        <label for="maKhoa">Khoa</label>
                        <select id="maKhoa" name="maKhoa" asp-items="ViewBag.Khoas" class="ng-input">
                            <option value="">Tất cả khoa</option>
                        </select>
                    </div>
                    <div class="ng-field">
                        <label for="toHop">Tổ hợp</label>
                        <input id="toHop" name="toHop" value="@toHop" list="dsToHop" class="ng-input"
                               placeholder="Tất cả · A00 / A01 / D01" />
                        <datalist id="dsToHop">
                            <option value="A00" />
                            <option value="A01" />
                            <option value="D01" />
                        </datalist>
                    </div>
                    <div class="ng-field">
                        <label for="trangThai">Trạng thái</label>
                        <select id="trangThai" name="trangThai" class="ng-input">
                            <option value="">Tất cả trạng thái</option>
                            @foreach (var state in new[] { TrangThaiNganh.ChuaMo, TrangThaiNganh.DangTuyen,
                        TrangThaiNganh.TamDung, TrangThaiNganh.DaDong })
                            {
                                <option value="@state" selected="@(state == trangThai)">@state</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="ng-grid ng-grid-3">
                    <div class="ng-field">
                        <label for="diemToiThieu">Điểm tối thiểu từ</label>
                        <input id="diemToiThieu" name="diemToiThieu" type="number" min="0" max="30" step="0.01"
                               value="@diemToiThieu" class="ng-input" placeholder="0,00–30,00" />
                    </div>
                    <div class="ng-field">
                        <label for="tinhTrangNhanHoSo">Hạn nộp</label>
                        <select id="tinhTrangNhanHoSo" name="tinhTrangNhanHoSo" class="ng-input">
                            <option value="">Tất cả · Còn hạn / Hết hạn</option>
                            <option value="conHan" selected="@(tinhTrangNhanHoSo == "conHan")">Còn hạn nhận hồ sơ</option>
                            <option value="hetHan" selected="@(tinhTrangNhanHoSo == "hetHan")">Đã hết hạn</option>
                        </select>
                    </div>
                    <div class="ng-field">
                        <label for="pageSize">Số dòng mỗi trang</label>
                        <select id="pageSize" name="pageSize" class="ng-input">
                            @foreach (var size in new[] { 10, 20, 50, 100 })
                            {
                                <option value="@size" selected="@(size == pageSize)">@size</option>
                            }
                        </select>
                    </div>
                </div>
            </div>

            <div class="ng-actions">
                <button type="submit" class="ng-btn ng-btn-primary">Áp dụng</button>
                <a asp-action="Index" class="ng-btn">Xóa bộ lọc</a>
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <a class="ng-chip" href="@BoLoc("search")">Từ khóa: @search ×</a>
                }
                @if (maKhoa.HasValue)
                {
                    var tenKhoa = khoaList.FirstOrDefault(x => x.Value == maKhoa.Value.ToString())?.Text ??
                maKhoa.Value.ToString();
                    <a class="ng-chip" href="@BoLoc("maKhoa")">Khoa: @tenKhoa ×</a>
                }
                @if (!string.IsNullOrWhiteSpace(toHop))
                {
                    <a class="ng-chip" href="@BoLoc("toHop")">Tổ hợp: @toHop ×</a>
                }
                @if (!string.IsNullOrEmpty(trangThai))
                {
                    <a class="ng-chip" href="@BoLoc("trangThai")">@trangThai ×</a>
                }
                @if (diemToiThieu.HasValue)
                {
                    <a class="ng-chip" href="@BoLoc("diem")">Điểm ≥ @diemToiThieu.Value.ToString("0.##") ×</a>
                }
                @if (!string.IsNullOrEmpty(tinhTrangNhanHoSo))
                {
                    <a class="ng-chip" href="@BoLoc("han")">@(tinhTrangNhanHoSo == "conHan" ? "Còn hạn" : "Đã hết hạn") ×</a>
                }
            </div>
            <p class="ng-hint">Điều kiện tìm kiếm, lọc và sắp xếp được giữ khi chuyển trang.</p>
        </form>

        @* ===== Cảnh báo ngành Đang tuyển đã hết hạn ===== *@
        @if (hetHan.Any())
        {
            <div class="ng-alert">
                <b>@hetHan.Count ngành Đang tuyển đã hết hạn</b>
                <span>
                    @string.Join("; ", hetHan.Select(x => $"{x.TenNganh}: hạn {x.HanNopHoSo:dd/MM/yyyy}")).
                    Hết hạn được tính theo ngày, không phải trạng thái ngành; vẫn xử lý hồ sơ đã nộp.
                </span>
            </div>
        }

        @* ===== Danh mục ngành ===== *@
        <div class="ng-card">
            <h2>Danh mục · @totalItems ngành</h2>
            <div class="ng-wrap">
                <table class="ng-table">
                    <thead>
                        <tr>
                            <th>Mã / Ngành</th>
                            <th>Khoa</th>
                            <th>Tổ hợp</th>
                            <th class="n">Chỉ tiêu</th>
                            <th class="n">Điểm tối thiểu</th>
                            <th>Hạn nộp</th>
                            <th>Trạng thái</th>
                            <th class="n">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in ds)
                        {
                            var quaHan = item.TrangThai == TrangThaiNganh.DangTuyen && item.HetHan;
                            <tr>
                                <td><strong>N@(item.MaNganh.ToString().PadLeft(3, '0'))</strong> · @item.TenNganh</td>
                                <td>@item.Khoa?.TenKhoa</td>
                                <td>
                                    @foreach (var th in (item.ToHopXetTuyen ?? "").Split(new[] { ',', ';', '/' },
                                    StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                    {
                                        <span class="ng-tag">@th</span>
                                    }
                                </td>
                                <td class="n">@item.ChiTieu</td>
                                <td class="n"><strong>@item.DiemXetTuyenToiThieu.ToString("0.00")</strong></td>
                                <td>
                                    @item.HanNopHoSo.ToString("dd/MM/yyyy")
                                    @if (quaHan)
                                    {
                                        <span class="sm late">Hết hạn</span>
                                    }
                                </td>
                                <td>
                                    <span class="@BadgeClass(item.TrangThai)">@item.TrangThai</span>
                                    @if (item.DangNhanHoSo)
                                    {
                                        <span class="sm">Đang nhận hồ sơ</span>
                                    }
                                </td>
                                <td class="n" style="white-space:nowrap">
                                    <a asp-action="Details" asp-route-id="@item.MaNganh" class="ng-btn ng-btn-sm">Xem</a>
                                    <a asp-action="Edit" asp-route-id="@item.MaNganh" class="ng-btn ng-btn-sm">Sửa</a>
                                    <a asp-action="Delete" asp-route-id="@item.MaNganh"
                                       class="ng-btn ng-btn-sm ng-btn-danger">Xóa</a>
                                </td>
                            </tr>
                        }
                        @if (!ds.Any())
                        {
                            <tr>
                                <td colspan="8" class="ng-empty">Không tìm thấy ngành tuyển sinh phù hợp.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="ng-paging">
                <span class="m">@batDau–@ketThuc / @totalItems bản ghi · @pageSize / trang</span>
                <div class="ng-ctl">
                    <a class="ng-btn @(page <= 1 ? "disabled" : "")" href="@Trang(Math.Max(page - 1, 1))"
                       aria-label="Trang trước">‹ Trước</a>
                    <span class="ng-chip">Trang @(page) / @totalPages</span>
                    <a class="ng-btn @(page >= totalPages ? "disabled" : "")" href="@Trang(Math.Min(page + 1, totalPages))"
                       aria-label="Trang sau">Sau ›</a>
                </div>
            </div>
        </div>

        <p class="ng-hint" style="margin:0 0 24px">
            Trạng thái hợp lệ: Chưa mở / Đang tuyển / Tạm dừng / Đã đóng. Chỉ nhận hồ sơ khi Đang tuyển và trong khoảng ngày
            nhận hồ sơ, gồm cả ngày bắt đầu và hạn nộp.
        </p>

        <div class="ng-foot">
            <span>Đề tài 21 · Nhóm 5 · ASP.NET Core MVC</span>
        </div>
    </div>

    @section Scripts {
        <script>
            (function () {
                var tg = document.getElementById('ngToggle'), adv = document.getElementById('ngAdvanced'), ic = document.getElementById('ngIcon');
                tg.addEventListener('click', function () {
                    var open = adv.style.display === 'none';
                    adv.style.display = open ? 'block' : 'none';
                    ic.textContent = open ? '▴' : '▾';
                    tg.setAttribute('aria-expanded', open);
                });
            })();
        </script>
    }
