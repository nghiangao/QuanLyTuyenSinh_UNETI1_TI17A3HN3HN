@*
    Họ và tên: Đào Văn Khánh
    Mã sinh viên: 23103100125
    Nội dung thực hiện: Module 2.1 và 2.7 - Chi tiết ngành và tình trạng nhận hồ sơ.
*@
@model NganhTuyenSinh

@{
    ViewData["Title"] = "Chi tiết ngành tuyển sinh";
    var dangNhanHoSo = ViewBag.DangNhanHoSo is bool value && value;
    var statusLabel = Model.TrangThai != TrangThaiNganh.DangTuyen
        ? Model.TrangThai
        : dangNhanHoSo
            ? "Đang nhận hồ sơ"
            : Model.HetHan
                ? "Đã hết hạn"
                : "Chưa mở nhận hồ sơ";
}

<div class="container py-3" style="max-width: 850px">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="text-primary mb-1">@Model.TenNganh</h2>
            <span class="badge @(dangNhanHoSo ? "bg-success" : Model.HetHan ? "bg-secondary" : "bg-warning text-dark")">@statusLabel</span>
        </div>
        <div class="d-flex gap-2">
            @if (User.IsInRole(VaiTro.Admin) || User.IsInRole(VaiTro.CanBoTuyenSinh))
            {
                <a asp-action="Edit" asp-route-id="@Model.MaNganh" class="btn btn-outline-primary">Sửa ngành</a>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại</a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white fw-semibold">
            Thông tin chi tiết ngành
        </div>
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Khoa</dt>
                <dd class="col-sm-9 fw-semibold">@Model.Khoa?.TenKhoa</dd>
                <dt class="col-sm-3 text-muted">Chỉ tiêu</dt>
                <dd class="col-sm-9"><span class="badge bg-light text-dark border">@Model.ChiTieu thí sinh</span></dd>
                <dt class="col-sm-3 text-muted">Tổ hợp xét tuyển</dt>
                <dd class="col-sm-9"><span class="badge bg-info text-dark">@Model.ToHopXetTuyen</span></dd>
                <dt class="col-sm-3 text-muted">Điểm xét tuyển tối thiểu</dt>
                <dd class="col-sm-9 fw-bold text-primary">@Model.DiemXetTuyenToiThieu.ToString("0.##")</dd>
                <dt class="col-sm-3 text-muted">Thời gian nhận hồ sơ</dt>
                <dd class="col-sm-9">@Model.NgayBatDauNhanHoSo.ToString("dd/MM/yyyy") - @Model.HanNopHoSo.ToString("dd/MM/yyyy")</dd>
                @if (!string.IsNullOrWhiteSpace(Model.MoTaNganh))
                {
                    <dt class="col-sm-3 text-muted">Mô tả ngành</dt>
                    <dd class="col-sm-9">@Model.MoTaNganh</dd>
                }
                @if (!string.IsNullOrWhiteSpace(Model.YeuCauThiSinh))
                {
                    <dt class="col-sm-3 text-muted">Yêu cầu thí sinh</dt>
                    <dd class="col-sm-9">@Model.YeuCauThiSinh</dd>
                }
            </dl>
        </div>
        <div class="card-footer bg-white d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div>
                <a asp-action="CongKhai" class="btn btn-outline-secondary">Danh sách công khai</a>
            </div>
            <div>
                @if (User.IsInRole(VaiTro.ThiSinh) && dangNhanHoSo)
                {
                    <a asp-controller="HoSoThiSinh"
                       asp-action="NopHoSo"
                       asp-route-maNganh="@Model.MaNganh"
                       class="btn btn-success">
                        ✍️ Nộp hồ sơ xét tuyển
                    </a>
                }
            </div>
        </div>
    </div>
</div>
