@*
    Họ và tên: Đào Văn Khánh
    Mã sinh viên: 23103100125
    Nội dung thực hiện: Module 2.7 - Danh sách ngành công khai, tìm kiếm, lọc, sắp xếp và phân trang.
    Làm lại giao diện cho đồng bộ với bộ giao diện quản trị (Figma 13/16/21/23): cùng bảng màu, bộ lọc nâng cao,
    chip điều kiện lọc, nhóm lọc nhanh theo thời hạn hồ sơ, đếm ngược "Còn N ngày", phân trang có "…".
    Giữ nguyên hợp đồng với controller: ViewBag (Search, MaKhoa, ToHop, TrangThai, DiemToiThieu, TinhTrangNhanHoSo,
    Sort, Page, TotalPages, PageSize, TotalItems, Khoas) và tham số GET của action CongKhai.
*@
@using Microsoft.AspNetCore.Mvc.Rendering
@model IEnumerable<NganhTuyenSinh>

@{
    ViewData["Title"] = "Danh mục ngành tuyển sinh";
    string? search = ViewBag.Search as string;
    int? maKhoa = ViewBag.MaKhoa as int?;
    string? toHop = ViewBag.ToHop as string;
    string? trangThai = ViewBag.TrangThai as string;
    decimal? diemToiThieu = ViewBag.DiemToiThieu as decimal?;
    string? tinhTrangNhanHoSo = ViewBag.TinhTrangNhanHoSo as string;
    string? sort = ViewBag.Sort as string;

    var ds = Model.ToList();
    int trangHienTai = (int)ViewBag.Page;
    int totalPages = Math.Max((int)ViewBag.TotalPages, 1);
    int pageSize = (int)ViewBag.PageSize;
    int totalItems = (int)ViewBag.TotalItems;
    int batDau = ds.Count == 0 ? 0 : (trangHienTai - 1) * pageSize + 1;
    int ketThuc = ds.Count == 0 ? 0 : batDau + ds.Count - 1;

    // Bộ lọc nâng cao tự mở khi đang có điều kiện lọc
    bool coLocNangCao = maKhoa.HasValue
        || !string.IsNullOrWhiteSpace(toHop)
        || !string.IsNullOrWhiteSpace(trangThai)
        || diemToiThieu.HasValue;
    bool coLoc = coLocNangCao || !string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(sort)
        || !string.IsNullOrWhiteSpace(tinhTrangNhanHoSo);

    var khoaList = (ViewBag.Khoas as IEnumerable<SelectListItem>)?.ToList() ?? new List<SelectListItem>();
    var inv = System.Globalization.CultureInfo.InvariantCulture;
    string? diemStr = diemToiThieu?.ToString(inv);

    // Route values dùng chung cho liên kết phân trang
    var routeBase = new Dictionary<string, string>();
    if (!string.IsNullOrWhiteSpace(search)) routeBase["search"] = search!;
    if (maKhoa.HasValue) routeBase["maKhoa"] = maKhoa.Value.ToString();
    if (!string.IsNullOrWhiteSpace(toHop)) routeBase["toHop"] = toHop!;
    if (!string.IsNullOrWhiteSpace(trangThai)) routeBase["trangThai"] = trangThai!;
    if (diemStr != null) routeBase["diemToiThieu"] = diemStr;
    if (!string.IsNullOrWhiteSpace(tinhTrangNhanHoSo)) routeBase["tinhTrangNhanHoSo"] = tinhTrangNhanHoSo!;
    if (!string.IsNullOrWhiteSpace(sort)) routeBase["sort"] = sort!;
    routeBase["pageSize"] = pageSize.ToString();

    Dictionary<string, string> RouteForPage(int p) => new Dictionary<string, string>(routeBase) { ["page"] = p.ToString() };

    // Bỏ một điều kiện lọc khi bấm chip ×
    string BoLoc(string ten) => Url.Action("CongKhai", new
    {
        search = ten == "search" ? null : search,
        maKhoa = ten == "maKhoa" ? null : maKhoa?.ToString(),
        toHop = ten == "toHop" ? null : toHop,
        trangThai = ten == "trangThai" ? null : trangThai,
        diemToiThieu = ten == "diem" ? null : diemStr,
        tinhTrangNhanHoSo = ten == "han" ? null : tinhTrangNhanHoSo,
        sort,
        pageSize
    })!;

    // Nhóm lọc nhanh theo thời hạn hồ sơ (giữ các điều kiện khác, về trang 1)
    string LocNhanh(string? han) => Url.Action("CongKhai", new
    {
        search,
        maKhoa = maKhoa?.ToString(),
        toHop,
        trangThai,
        diemToiThieu = diemStr,
        tinhTrangNhanHoSo = string.IsNullOrEmpty(han) ? null : han,
        sort,
        pageSize
    })!;

    // Cửa sổ phân trang: tối đa 5 số trang quanh trang hiện tại
    int startPage = Math.Max(1, trangHienTai - 2);
    int endPage = Math.Min(totalPages, startPage + 4);
    startPage = Math.Max(1, endPage - 4);
}

<style>
    .cg {
        --ink: #182b46;
        --muted: #63738a;
        --line: #dee5ee;
        --bg: #f3f6fa;
        --primary: #2057a5;
        --soft: #eaf1fc;
        --danger: #b43d43;
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
        color: var(--ink);
    }

    .cg * {
        box-sizing: border-box;
    }

    .cg-title {
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 8px;
        line-height: 1.2;
    }

    .cg-sub {
        font-size: 14px;
        color: var(--muted);
        margin: 0 0 24px;
    }

    .cg-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .cg-card h2 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 16px;
    }

    .cg-grid {
        display: grid;
        gap: 20px;
    }

    .cg-grid-2 {
        grid-template-columns: 1fr 1fr;
    }

    .cg-grid-3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .cg-field label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .cg-input {
        width: 100%;
        padding: 12px;
        font-size: 14px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #fff;
        color: var(--ink);
    }

    .cg-input:focus {
        outline: 2px solid var(--soft);
        border-color: var(--primary);
    }

    .cg-toggle {
        display: inline-block;
        margin: 16px 0;
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
        text-decoration: none;
        cursor: pointer;
    }

    .cg-toggle:hover {
        color: var(--primary);
    }

    .cg-toggle .ic::after {
        content: "▾";
        margin-left: 4px;
    }

    .cg-toggle[aria-expanded="true"] .ic::after {
        content: "▴";
    }

    .cg-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .cg-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        border: 1px solid var(--line);
        background: #fff;
        color: var(--ink);
        text-decoration: none;
        cursor: pointer;
        line-height: 1.3;
        white-space: nowrap;
    }

    .cg-btn:hover {
        background: var(--bg);
        color: var(--ink);
    }

    .cg-btn-primary {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
    }

    .cg-btn-primary:hover {
        background: #1a4786;
        color: #fff;
    }

    .cg-btn-sm {
        padding: 6px 12px;
        font-size: 12px;
    }

    .cg-btn.disabled {
        background: var(--bg);
        color: #9aa8ba;
        pointer-events: none;
    }

    .cg-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 8px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        background: var(--soft);
        color: var(--primary);
        text-decoration: none;
    }

    .cg-quick {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 16px;
    }

    .cg-pill {
        padding: 6px 14px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 100px;
        border: 1px solid var(--line);
        background: #fff;
        color: var(--muted);
        text-decoration: none;
    }

    .cg-pill:hover {
        background: var(--bg);
        color: var(--ink);
    }

    .cg-pill.on {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
    }

    .cg-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 12px;
    }

    .cg-bar strong {
        color: var(--ink);
    }

    .cg-wrap {
        border: 1px solid var(--line);
        border-radius: 6px;
        overflow-x: auto;
    }

    .cg-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .cg-table th {
        background: var(--bg);
        color: var(--muted);
        font-weight: 600;
        font-size: 12px;
        text-align: left;
        padding: 13px 14px;
        white-space: nowrap;
    }

    .cg-table td {
        padding: 15px 14px;
        border-top: 1px solid var(--line);
        vertical-align: middle;
    }

    .cg-table tbody tr:hover td {
        background: #f8fafd;
    }

    .cg-table .n {
        text-align: right;
    }

    .cg-table .sm {
        display: block;
        font-size: 12px;
        color: var(--muted);
        margin-top: 2px;
    }

    .cg-table .nowrap {
        white-space: nowrap;
    }

    .cg-tag {
        display: inline-block;
        padding: 2px 6px;
        margin: 0 4px 2px 0;
        font-size: 11px;
        font-weight: 600;
        border-radius: 4px;
        background: #f3f6fa;
        border: 1px solid var(--line);
    }

    .cg-badge {
        display: inline-block;
        padding: 4px 8px;
        font-size: 11px;
        font-weight: 600;
        border-radius: 6px;
        white-space: nowrap;
    }

    .cg-green {
        background: #eaf6ee;
        color: #23734d;
    }

    .cg-red {
        background: #fceeef;
        color: var(--danger);
    }

    .cg-amber {
        background: #fff5e3;
        color: #99611b;
    }

    .cg-grey {
        background: #eef1f5;
        color: var(--muted);
    }

    .cg-late {
        color: var(--danger);
        font-weight: 600;
    }

    .cg-soon {
        color: #99611b;
        font-weight: 600;
    }

    .cg-empty {
        text-align: center;
        padding: 40px 16px;
    }

    .cg-empty p {
        margin: 0 0 6px;
    }

    .cg-paging {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
        gap: 12px;
        flex-wrap: wrap;
    }

    .cg-paging .m {
        font-size: 12px;
        color: var(--muted);
    }

    .cg-pages {
        display: flex;
        gap: 6px;
        align-items: center;
        flex-wrap: wrap;
    }

    .cg-page {
        min-width: 36px;
        height: 36px;
        padding: 0 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        border: 1px solid var(--line);
        background: #fff;
        color: var(--ink);
        text-decoration: none;
    }

    .cg-page:hover {
        background: var(--bg);
        color: var(--ink);
    }

    .cg-page.on {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
    }

    .cg-page.off {
        color: #9aa8ba;
        background: var(--bg);
        pointer-events: none;
    }

    .cg a:focus-visible,
    .cg button:focus-visible,
    .cg input:focus-visible,
    .cg select:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
    }

    @@media (max-width:992px) {

        .cg-grid-2,
        .cg-grid-3 {
            grid-template-columns: 1fr;
        }

        .cg-paging {
            justify-content: center;
        }
    }
</style>

<div class="cg">
    <h1 class="cg-title">Danh mục ngành tuyển sinh</h1>
    <p class="cg-sub">Xem điều kiện, chỉ tiêu và thời hạn nhận hồ sơ của từng ngành.</p>

    @* ===== Tìm kiếm & bộ lọc ===== *@
    <form asp-action="CongKhai" method="get" class="cg-card">
        <h2>Tìm ngành phù hợp</h2>
        <div class="cg-grid cg-grid-3" style="grid-template-columns:2fr 1fr 120px">
            <div class="cg-field">
                <label for="search">Từ khóa</label>
                <input id="search" name="search" value="@search" class="cg-input"
                       placeholder="Nhập tên ngành hoặc khoa" />
            </div>
            <div class="cg-field">
                <label for="sort">Sắp xếp</label>
                <select id="sort" name="sort" class="cg-input">
                    <option value="">Tên A–Z</option>
                    <option value="ten_desc" selected="@(sort == "ten_desc")">Tên Z–A</option>
                    <option value="han_asc" selected="@(sort == "han_asc")">Hạn nộp tăng dần</option>
                    <option value="han_desc" selected="@(sort == "han_desc")">Hạn nộp giảm dần</option>
                    <option value="chiTieu_asc" selected="@(sort == "chiTieu_asc")">Chỉ tiêu tăng dần</option>
                    <option value="chiTieu_desc" selected="@(sort == "chiTieu_desc")">Chỉ tiêu giảm dần</option>
                </select>
            </div>
            <div class="cg-field">
                <label for="pageSize">Số dòng</label>
                <select id="pageSize" name="pageSize" class="cg-input">
                    @foreach (var size in new[] { 10, 20, 50, 100 })
                    {
                        <option value="@size" selected="@(size == pageSize)">@size</option>
                    }
                </select>
            </div>
        </div>

        <a class="cg-toggle" data-bs-toggle="collapse" href="#locNangCao" role="button"
           aria-expanded="@(coLocNangCao ? "true" : "false")" aria-controls="locNangCao">
            Bộ lọc nâng cao <span class="ic"></span>
        </a>

        <div class="collapse @(coLocNangCao ? "show" : "")" id="locNangCao">
            <div class="cg-grid cg-grid-3" style="grid-template-columns:repeat(4,1fr)">
                <div class="cg-field">
                    <label for="maKhoa">Khoa</label>
                    <select id="maKhoa" name="maKhoa" asp-items="ViewBag.Khoas" class="cg-input">
                        <option value="">Tất cả khoa</option>
                    </select>
                </div>
                <div class="cg-field">
                    <label for="toHop">Tổ hợp xét tuyển</label>
                    <input id="toHop" name="toHop" value="@toHop" list="dsToHop" class="cg-input"
                           placeholder="Ví dụ: A00" />
                    <datalist id="dsToHop">
                        <option value="A00" />
                        <option value="A01" />
                        <option value="D01" />
                    </datalist>
                </div>
                <div class="cg-field">
                    <label for="trangThai">Trạng thái ngành</label>
                    <select id="trangThai" name="trangThai" class="cg-input">
                        <option value="">Tất cả</option>
                        @foreach (var state in new[] { TrangThaiNganh.ChuaMo, TrangThaiNganh.DangTuyen,
                        TrangThaiNganh.TamDung, TrangThaiNganh.DaDong })
                        {
                            <option value="@state" selected="@(state == trangThai)">@state</option>
                        }
                    </select>
                </div>
                <div class="cg-field">
                    <label for="diemToiThieu">Điểm sàn từ</label>
                    <input id="diemToiThieu" name="diemToiThieu" type="number" min="0" max="30" step="0.01"
                           value="@diemToiThieu" class="cg-input" placeholder="0,00–30,00" />
                </div>
            </div>
        </div>

        @* Giữ lại lọc nhanh khi bấm "Tìm ngành" *@
        @if (!string.IsNullOrWhiteSpace(tinhTrangNhanHoSo))
        {
            <input type="hidden" name="tinhTrangNhanHoSo" value="@tinhTrangNhanHoSo" />
        }

        <div class="cg-actions">
            <button type="submit" class="cg-btn cg-btn-primary">Tìm ngành</button>
            @if (coLoc)
            {
                <a asp-action="CongKhai" class="cg-btn">Xóa lọc</a>
            }
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <a class="cg-chip" href="@BoLoc("search")">Từ khóa: @search ×</a>
            }
            @if (maKhoa.HasValue)
            {
                var tenKhoa = khoaList.FirstOrDefault(x => x.Value == maKhoa.Value.ToString())?.Text ??
            maKhoa.Value.ToString();
                <a class="cg-chip" href="@BoLoc("maKhoa")">Khoa: @tenKhoa ×</a>
            }
            @if (!string.IsNullOrWhiteSpace(toHop))
            {
                <a class="cg-chip" href="@BoLoc("toHop")">Tổ hợp: @toHop ×</a>
            }
            @if (!string.IsNullOrWhiteSpace(trangThai))
            {
                <a class="cg-chip" href="@BoLoc("trangThai")">@trangThai ×</a>
            }
            @if (diemToiThieu.HasValue)
            {
                <a class="cg-chip" href="@BoLoc("diem")">Điểm sàn ≥ @diemToiThieu.Value.ToString("0.##") ×</a>
            }
        </div>
    </form>

    @* ===== Lọc nhanh theo thời hạn hồ sơ ===== *@
    <div class="cg-quick" role="group" aria-label="Lọc nhanh theo thời hạn hồ sơ">
        <a class="cg-pill @(string.IsNullOrEmpty(tinhTrangNhanHoSo) ? "on" : "")" href="@LocNhanh(null)">Tất cả</a>
        <a class="cg-pill @(tinhTrangNhanHoSo == "conHan" ? "on" : "")" href="@LocNhanh("conHan")">Đang nhận hồ sơ</a>
        <a class="cg-pill @(tinhTrangNhanHoSo == "hetHan" ? "on" : "")" href="@LocNhanh("hetHan")">Đã hết hạn</a>
    </div>

    <div class="cg-bar">
        <span>Tìm thấy <strong>@totalItems</strong> ngành</span>
        <span>Trang @trangHienTai / @totalPages</span>
    </div>

    @* ===== Danh sách ngành ===== *@
    <div class="cg-wrap">
        <table class="cg-table">
            <thead>
                <tr>
                    <th>Ngành</th>
                    <th>Tổ hợp</th>
                    <th class="n">Chỉ tiêu</th>
                    <th class="n">Điểm sàn</th>
                    <th>Thời hạn nhận hồ sơ</th>
                    <th>Tình trạng</th>
                    <th><span class="visually-hidden">Thao tác</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in ds)
                {
                    var statusLabel = item.TrangThai != TrangThaiNganh.DangTuyen
                        ? item.TrangThai
                        : item.DangNhanHoSo
                            ? "Đang nhận hồ sơ"
                            : item.HetHan
                                ? "Đã hết hạn"
                                : "Chưa mở nhận hồ sơ";
                    var badgeClass = item.TrangThai != TrangThaiNganh.DangTuyen
                        ? "cg-grey"
                        : item.DangNhanHoSo
                            ? "cg-green"
                            : item.HetHan
                                ? "cg-red"
                                : "cg-amber";
                    int conLai = (item.HanNopHoSo.Date - DateTime.Today).Days;
                    <tr>
                        <td>
                            <strong>@item.TenNganh</strong>
                            <span class="sm">@item.Khoa?.TenKhoa</span>
                        </td>
                        <td>
                            @foreach (var th in (item.ToHopXetTuyen ?? "").Split(new[] { ',', ';', '/' },
                            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                            {
                                <span class="cg-tag">@th</span>
                            }
                        </td>
                        <td class="n">@item.ChiTieu</td>
                        <td class="n"><strong>@item.DiemXetTuyenToiThieu.ToString("0.##")</strong></td>
                        <td class="nowrap">
                            @item.NgayBatDauNhanHoSo.ToString("dd/MM/yyyy") – @item.HanNopHoSo.ToString("dd/MM/yyyy")
                            @if (item.DangNhanHoSo)
                            {
                                if (conLai <= 7)
                                {
                                    <span class="sm cg-soon">@(conLai <= 0 ? "Hạn chót hôm nay" : $"Còn {conLai} ngày")</span>
                                }
                                else
                                {
                                    <span class="sm">Còn @conLai ngày</span>
                                }
                            }
                            else if (item.HetHan)
                            {
                                <span class="sm cg-late">Đã hết hạn</span>
                            }
                        </td>
                        <td><span class="cg-badge @badgeClass">@statusLabel</span></td>
                        <td class="n"><a asp-action="Details" asp-route-id="@item.MaNganh" class="cg-btn cg-btn-sm">Chi
                            tiết</a></td>
                        </tr>
                    }
                    @if (!ds.Any())
                    {
                        <tr>
                            <td colspan="7" class="cg-empty">
                                <p><strong>Không tìm thấy ngành phù hợp</strong></p>
                                <p style="color:var(--muted)">Thử bỏ bớt điều kiện lọc hoặc đổi từ khóa.</p>
                                @if (coLoc)
                                {
                                    <a asp-action="CongKhai" class="cg-btn cg-btn-sm">Xóa lọc</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (totalPages > 1)
        {
            <div class="cg-paging">
                <span class="m">@batDau–@ketThuc / @totalItems bản ghi · @pageSize / trang</span>
                <nav aria-label="Phân trang ngành tuyển sinh">
                    <div class="cg-pages">
                        <a class="cg-page @(trangHienTai <= 1 ? "off" : "")" asp-action="CongKhai"
                           asp-all-route-data="RouteForPage(trangHienTai - 1)">‹ Trước</a>
                        @if (startPage > 1)
                        {
                            <a class="cg-page" asp-action="CongKhai" asp-all-route-data="RouteForPage(1)">1</a>
                            @if (startPage > 2)
                            {
                                <span class="cg-page off">…</span>
                            }
                        }
                        @for (var pageNumber = startPage; pageNumber <= endPage; pageNumber++)
                        {
                            <a class="cg-page @(pageNumber == trangHienTai ? "on" : "")" asp-action="CongKhai"
                               asp-all-route-data="RouteForPage(pageNumber)"
                               aria-current="@(pageNumber == trangHienTai ? "page" : null)">@pageNumber</a>
                        }
                        @if (endPage < totalPages)
                        {
                            @if (endPage < totalPages - 1)
                            {
                                <span class="cg-page off">…</span>
                            }
                            <a class="cg-page" asp-action="CongKhai" asp-all-route-data="RouteForPage(totalPages)">@totalPages</a>
                        }
                        <a class="cg-page @(trangHienTai >= totalPages ? "off" : "")" asp-action="CongKhai"
                           asp-all-route-data="RouteForPage(trangHienTai + 1)">Sau ›</a>
                    </div>
                </nav>
            </div>
        }
    </div>
