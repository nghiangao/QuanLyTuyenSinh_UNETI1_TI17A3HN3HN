@*
    Họ và tên: Đào Văn Khánh
    Mã sinh viên: 23103100125
    Nội dung thực hiện: Module 2.1-2.2 - Giao diện cập nhật ngành và trạng thái tuyển sinh.
*@
@model NganhTuyenSinh

@{
    ViewData["Title"] = "Sửa ngành tuyển sinh";
}

<h1 class="h3 mb-3">Sửa ngành tuyển sinh</h1>
<form asp-action="Edit" asp-route-id="@Model.MaNganh" method="post" class="border rounded p-3">
    <input type="hidden" asp-for="MaNganh" />
    <partial name="_Form" model="Model" />
    <div class="d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}