@*
    Họ và tên: Đào Văn Khánh
    Mã sinh viên: 23103100125
    Nội dung thực hiện: Module 2.1-2.2 - Giao diện cập nhật ngành và trạng thái tuyển sinh.
*@
@model NganhTuyenSinh

@{
    ViewData["Title"] = "Sửa ngành tuyển sinh";
}

<div class="container py-3" style="max-width: 900px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary mb-0">Cập nhật ngành tuyển sinh</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại danh sách</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.MaNganh" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="MaNganh" />
                <partial name="_Form" model="Model" />
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
