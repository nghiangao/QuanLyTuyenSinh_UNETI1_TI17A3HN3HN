@*
    Họ và tên: Giang Mạnh Tường
    Mã sinh viên: 23103100155
    Nội dung thực hiện: Module 3.2 - Chi tiết thí sinh.
*@
@model QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models.ThiSinh

@{
    ViewData["Title"] = "Chi tiết thí sinh";

    // Hiển thị giá trị; nếu trống thì hiện chữ mờ, không coi là 0
    Microsoft.AspNetCore.Html.HtmlString Val(string? v, string trong) =>
        string.IsNullOrWhiteSpace(v)
            ? new Microsoft.AspNetCore.Html.HtmlString("<span class=\"ts-empty\">" + System.Net.WebUtility.HtmlEncode(trong) + "</span>")
            : new Microsoft.AspNetCore.Html.HtmlString(System.Net.WebUtility.HtmlEncode(v));

    var tenCuoi = (Model.HoTen ?? "").Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).LastOrDefault();
    var chuCai = string.IsNullOrEmpty(tenCuoi) ? "?" : tenCuoi.Substring(0, 1).ToUpper();
    var diem = Model.DiemThiTHPT?.ToString("0.##");
}

<style>
    .ts-detail {
        --ts-bg: #F3F6FA; --ts-surface: #FFFFFF; --ts-border: #DEE5EE;
        --ts-primary: #2057A5; --ts-info: #EAF1FC;
        --ts-text: #182B46; --ts-muted: #63738A;
        --ts-ok-bg: #EAF6EE; --ts-ok: #23734D;
        --ts-off-bg: #EEF0F3; --ts-off: #63738A;
        font-family: Inter, "Segoe UI", system-ui, -apple-system, Roboto, "Helvetica Neue", Arial, sans-serif;
        color: var(--ts-text);
        max-width: 1100px;
        padding: 8px 0 24px;
    }
    .ts-breadcrumb { font-size: 12px; font-weight: 600; color: var(--ts-primary); margin-bottom: 20px; }

    .ts-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 16px; margin-bottom: 24px; }
    .ts-head-main { display: flex; align-items: center; gap: 16px; min-width: 0; }
    .ts-avatar {
        width: 56px; height: 56px; border-radius: 50%; flex: none;
        background: var(--ts-info); color: var(--ts-primary);
        display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 700;
    }
    .ts-title { font-size: 28px; font-weight: 700; line-height: 1.2; margin: 0 0 6px; color: var(--ts-text); }
    .ts-sub { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; font-size: 14px; color: var(--ts-muted); margin: 0; }

    .ts-badge { display: inline-block; font-size: 12px; font-weight: 600; padding: 4px 8px; border-radius: 6px; }
    .ts-badge-ok { background: var(--ts-ok-bg); color: var(--ts-ok); }
    .ts-badge-off { background: var(--ts-off-bg); color: var(--ts-off); }

    .ts-btn {
        font-size: 14px; font-weight: 600; padding: 10px 16px; border-radius: 6px; line-height: 1.2;
        border: 1px solid var(--ts-border); background: var(--ts-surface); color: var(--ts-text);
        text-decoration: none; display: inline-block;
    }
    .ts-btn:hover { background: var(--ts-bg); color: var(--ts-text); }
    .ts-btn:focus-visible { outline: 2px solid var(--ts-primary); outline-offset: 2px; }

    .ts-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: start; }
    .ts-card { background: var(--ts-surface); border: 1px solid var(--ts-border); border-radius: 10px; padding: 24px; }
    .ts-card h2 { font-size: 18px; font-weight: 600; margin: 0 0 16px; color: var(--ts-text); }

    .ts-list { margin: 0; display: grid; grid-template-columns: 150px 1fr; row-gap: 14px; column-gap: 16px; }
    .ts-list dt { font-size: 13px; font-weight: 600; color: var(--ts-muted); }
    .ts-list dd { font-size: 14px; margin: 0; color: var(--ts-text); overflow-wrap: anywhere; }
    .ts-empty { color: var(--ts-muted); font-style: italic; }

    .ts-notice { background: var(--ts-info); border-radius: 6px; padding: 16px; margin-top: 20px; }
    .ts-notice strong { display: block; font-size: 14px; font-weight: 600; color: var(--ts-primary); margin-bottom: 6px; }
    .ts-notice span { font-size: 13px; line-height: 1.5; color: var(--ts-text); }

    @@media (max-width: 767.98px) {
        .ts-grid { grid-template-columns: 1fr; }
        .ts-list { grid-template-columns: 1fr; row-gap: 4px; }
        .ts-list dd { margin-bottom: 10px; }
        .ts-title { font-size: 24px; }
    }
</style>

<div class="ts-detail">
    <div class="ts-breadcrumb">19 / CÁN BỘ TUYỂN SINH / Thí sinh</div>

    <div class="ts-head">
        <div class="ts-head-main">
            <div class="ts-avatar" aria-hidden="true">@chuCai</div>
            <div>
                <h1 class="ts-title">@Model.HoTen</h1>
                <p class="ts-sub">
                    <span>Mã thí sinh @Model.MaThiSinh</span>
                    <span class="ts-badge @(Model.TrangThai ? "ts-badge-ok" : "ts-badge-off")">
                        @(Model.TrangThai ? "Hoạt động" : "Ngừng hoạt động")
                    </span>
                </p>
            </div>
        </div>
        <a asp-controller="ThiSinh" asp-action="Index" class="ts-btn">Quay lại danh sách</a>
    </div>

    <div class="ts-grid">
        <section class="ts-card">
            <h2>Thông tin cá nhân</h2>
            <dl class="ts-list">
                <dt>Họ tên</dt>
                <dd>@Model.HoTen</dd>

                <dt>Ngày sinh</dt>
                <dd>@Model.NgaySinh.ToString("dd/MM/yyyy")</dd>

                <dt>Giới tính</dt>
                <dd>@Model.GioiTinh</dd>

                <dt>Địa chỉ</dt>
                <dd>@Val(Model.DiaChi, "Chưa cập nhật")</dd>
            </dl>
        </section>

        <section class="ts-card">
            <h2>Liên hệ</h2>
            <dl class="ts-list">
                <dt>Số điện thoại</dt>
                <dd>@Val(Model.SoDienThoai, "Chưa cập nhật")</dd>

                <dt>Email</dt>
                <dd>@Val(Model.Email, "Chưa cập nhật")</dd>
            </dl>
        </section>

        <section class="ts-card">
            <h2>Học tập &amp; xét tuyển</h2>
            <dl class="ts-list">
                <dt>Trường THPT</dt>
                <dd>@Val(Model.TruongTHPT, "Chưa cập nhật")</dd>

                <dt>Tổ hợp xét tuyển</dt>
                <dd>@Val(Model.ToHopXetTuyen, "Chưa khai báo")</dd>

                <dt>Điểm thi THPT</dt>
                <dd>@Val(diem, "Chưa khai báo")</dd>

                <dt>Thành tích nổi bật</dt>
                <dd>@Val(Model.ThanhTichNoiBat, "Không có")</dd>
            </dl>
        </section>

        <section class="ts-card">
            <h2>Tài khoản liên kết</h2>
            <dl class="ts-list">
                <dt>Mã tài khoản</dt>
                <dd>@Model.MaTaiKhoan</dd>

                <dt>Tên đăng nhập</dt>
                <dd>@Val(Model.TaiKhoan?.TenDangNhap, "Chưa có")</dd>

                <dt>Hoạt động</dt>
                <dd>
                    <span class="ts-badge @(Model.TrangThai ? "ts-badge-ok" : "ts-badge-off")">
                        @(Model.TrangThai ? "Hoạt động" : "Ngừng hoạt động")
                    </span>
                </dd>
            </dl>
        </section>
    </div>

    <div class="ts-notice">
        <strong>Trạng thái hoạt động không phải trạng thái hồ sơ</strong>
        <span>Điểm và tổ hợp có thể để trống trên hồ sơ cá nhân và được hiển thị là "Chưa khai báo", không coi là 0. Các hồ sơ xét tuyển vẫn xử lý theo quy trình riêng.</span>
    </div>
</div>
