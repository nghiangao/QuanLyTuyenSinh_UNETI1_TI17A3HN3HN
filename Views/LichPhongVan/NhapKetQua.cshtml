@*
    Họ và tên: Mã Đức Thịnh
    Mã sinh viên: 23103100314
    Nội dung thực hiện: Module 5 – Form nhập / sửa kết quả phỏng vấn.
    Sau khi lưu, hồ sơ [Module 3/5] tự động chuyển Trúng tuyển / Không trúng tuyển.
*@
@model KetQuaXetTuyen

@{
    ViewData["Title"] = "Nhập kết quả phỏng vấn";
    var lich  = ViewBag.ThongTinLich  as LichPhongVan;
    var hoSo  = lich?.HoSoXetTuyen;
    int maLich = (int)ViewBag.MaLichPhongVan;
}

<div class="container py-3" style="max-width: 850px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary mb-0">Nhập kết quả phỏng vấn</h2>
        <a asp-action="Details" asp-route-id="@maLich" class="btn btn-outline-secondary">← Quay lại chi tiết</a>
    </div>

    @* ── Tóm tắt thông tin lịch (readonly, chỉ để đối chiếu) ── *@
    @if (lich != null)
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white fw-semibold">Thông tin lịch phỏng vấn #@lich.MaLichPhongVan</div>
            <div class="card-body py-3">
                <div class="row g-3">
                    <div class="col-sm-6 col-md-3">
                        <small class="text-muted d-block">Thí sinh</small>
                        <strong>@hoSo?.ThiSinh?.HoTen</strong>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <small class="text-muted d-block">Ngành xét tuyển</small>
                        <strong>@hoSo?.NganhTuyenSinh?.TenNganh</strong>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <small class="text-muted d-block">Thời gian phỏng vấn</small>
                        <strong>@lich.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</strong>
                    </div>
                    <div class="col-sm-6 col-md-3">
                        <small class="text-muted d-block">Người phỏng vấn</small>
                        <strong>@lich.NguoiPhongVan?.HoTen</strong>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="NhapKetQua" asp-route-id="@maLich" method="post">
                @Html.AntiForgeryToken()

                @* Hidden fields để giữ khóa chính khi sửa *@
                <input type="hidden" asp-for="MaKetQuaXetTuyen" />
                <input type="hidden" asp-for="MaHoSo" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="KetQua" class="form-label fw-semibold"></label>
                    <select asp-for="KetQua" class="form-select">
                        <option value="@KetQuaTuyen.TrungTuyen">@KetQuaTuyen.TrungTuyen</option>
                        <option value="@KetQuaTuyen.KhongTrungTuyen">@KetQuaTuyen.KhongTrungTuyen</option>
                    </select>
                    <span asp-validation-for="KetQua" class="text-danger"></span>
                    <div class="form-text">
                        Sau khi lưu, trạng thái hồ sơ sẽ tự động chuyển theo kết quả này (Trúng tuyển hoặc Không trúng tuyển).
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="DiemDanhGia" class="form-label fw-semibold"></label>
                    <input asp-for="DiemDanhGia" type="number" step="0.01" min="0" max="100"
                           class="form-control" placeholder="0 – 100 (không bắt buộc)" />
                    <span asp-validation-for="DiemDanhGia" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="NhanXet" class="form-label fw-semibold"></label>
                    <textarea asp-for="NhanXet" class="form-control" rows="4"
                              placeholder="Nhận xét năng lực, kiến thức, kỹ năng, thái độ của thí sinh..."></textarea>
                    <span asp-validation-for="NhanXet" class="text-danger"></span>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">💾 Lưu kết quả</button>
                    <a asp-action="Details" asp-route-id="@maLich" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
