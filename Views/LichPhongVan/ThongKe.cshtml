@*
    Họ và tên: Mã Đức Thịnh
    Mã sinh viên: 23103100314
    Nội dung thực hiện: Module 5 - Giao diện Thống kê báo cáo bằng LINQ (Đề mục 9.6: 10 báo cáo phân tích chuyên sâu),
    dàn lại theo thiết kế Figma "Thống kê tuyển sinh": bộ lọc phạm vi, 4 chỉ số tổng hợp, quy mô theo khoa,
    hồ sơ theo trạng thái, biểu đồ theo tháng, ngành nổi bật và bảng hiệu quả theo ngành.

    Bản đồ 10 báo cáo -> khối giao diện:
      1 NganhTheoKhoa            -> bảng "Quy mô và trúng tuyển theo khoa"
      2 HoSoTheoNganh            -> bảng "Hiệu quả tuyển sinh theo ngành"
      3 HoSoTheoTrangThai        -> "Số hồ sơ theo trạng thái"
      4 DatSoTuyenTheoNganh      -> cột "Đạt sơ tuyển" (bảng theo ngành)
      5 NganhNhieuHoSoNhat       -> thẻ "Ngành nhận nhiều hồ sơ nhất"
      6 TrungTuyenTheoKhoa       -> cột "Trúng tuyển" (bảng theo khoa)
      7 HoSoTheoThang + 8 LichTheoThang -> biểu đồ cột theo tháng
      9 TyLeQuaSoTuyenTheoNganh  -> cột "Tỷ lệ qua sơ tuyển"
      10 TyLeTrungTuyenTrenDaPV  -> thẻ "Tỷ lệ trúng tuyển" + "Đã phỏng vấn"

    Tham số GET view gửi lên: khoa, nganh, tuThang, denThang (định dạng yyyy-MM).
*@
@using System.Globalization
@model ThongKeViewModel

@{
    ViewData["Title"] = "Thống kê tuyển sinh";
    var inv = CultureInfo.InvariantCulture;

    string selKhoa = Context.Request.Query["khoa"].ToString();
    string selNganh = Context.Request.Query["nganh"].ToString();
    string tuThang = Context.Request.Query["tuThang"].ToString();
    string denThang = Context.Request.Query["denThang"].ToString();

    // ---- Số liệu tổng hợp (suy ra từ ViewModel hiện có) ----
    int tongHoSo = Model.HoSoTheoTrangThai.Sum(x => (int)x.SoLuong);
    int tongDatSoTuyen = Model.TyLeQuaSoTuyenTheoNganh.Sum(x => (int)x.SoDatSoTuyen);
    int soNganh = Model.HoSoTheoNganh.Count();
    int soKhoa = Model.NganhTheoKhoa.Count();
    var pv = Model.TyLeTrungTuyenTrenDaPV;
    double tyLeSoTuyen = tongHoSo == 0 ? 0 : tongDatSoTuyen * 100.0 / tongHoSo;

    string Pct(double v) => v.ToString("0.0", CultureInfo.GetCultureInfo("vi-VN")) + "%";
    string W(double v) => Math.Min(Math.Max(v, 0), 100).ToString("0.##", inv) + "%";

    // ---- Khoa: ghép số ngành/chỉ tiêu với số trúng tuyển ----
    var trungTuyenKhoa = Model.TrungTuyenTheoKhoa.ToDictionary(x => x.TenKhoa, x => (int)x.SoLuongTrungTuyen);
    int tongNganhKhoa = Model.NganhTheoKhoa.Sum(x => (int)x.SoLuongNganh);
    int tongChiTieu = Model.NganhTheoKhoa.Sum(x => (int)x.TongChiTieu);
    int tongTrung = trungTuyenKhoa.Values.Sum();

    // ---- Biểu đồ theo tháng: hợp nhất hồ sơ + lịch ----
    var thangs = Model.HoSoTheoThang.Select(x => (x.Nam, x.Thang))
                  .Union(Model.LichTheoThang.Select(x => (x.Nam, x.Thang)))
                  .OrderBy(x => x.Nam).ThenBy(x => x.Thang).ToList();
    int Hs(int n, int t) => Model.HoSoTheoThang.Where(x => x.Nam == n && x.Thang == t).Sum(x => (int)x.SoLuong);
    int Lich(int n, int t) => Model.LichTheoThang.Where(x => x.Nam == n && x.Thang == t).Sum(x => (int)x.SoLuong);
    int maxCot = Math.Max(1, thangs.Select(x => Math.Max(Hs(x.Nam, x.Thang), Lich(x.Nam,
x.Thang))).DefaultIfEmpty(1).Max());
    int tongHsThang = Model.HoSoTheoThang.Sum(x => (int)x.SoLuong);
    int tongLichThang = Model.LichTheoThang.Sum(x => (int)x.SoLuong);

    // ---- Bảng theo ngành: ghép HoSoTheoNganh + TyLeQuaSoTuyenTheoNganh ----
    var soTuyen = Model.TyLeQuaSoTuyenTheoNganh.ToDictionary(x => x.TenNganh, x => x);

    var mauTrangThai = new[] { "#996315", "#91a1b1", "#3267a8", "#087f82", "#6f85ac", "#24744e", "#b34545" };
    int maxTrangThai = Math.Max(1, Model.HoSoTheoTrangThai.Select(x => (int)x.SoLuong).DefaultIfEmpty(1).Max());
}

