<div class="tk">

    <div class="tk-crumb">
        <span>Điều hành tuyển sinh &nbsp;/&nbsp; Module 5 &nbsp;/&nbsp; Thống kê tuyển sinh</span>
        <span class="tk-pill">Dữ liệu minh họa</span>
    </div>

    <div class="tk-head">
        <div>
            <h1>Thống kê tuyển sinh</h1>
            <p>Từ quy mô đào tạo đến hiệu quả xét tuyển · Kỳ tuyển sinh đại học chính quy @DateTime.Now.Year.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Dashboard" class="tk-btn">Tổng quan</a>
            <a asp-action="Index" class="tk-btn">Danh sách lịch</a>
            <button type="button" class="tk-btn" onclick="window.print()">⬇ Xuất báo cáo</button>
        </div>
    </div>

    @* ===== Phạm vi báo cáo ===== *@
    <form method="get" class="tk-card tk-scope">
        <div class="tk-f">
            <label for="khoa">Khoa</label>
            <select id="khoa" name="khoa" class="tk-input">
                <option value="">Tất cả khoa</option>
                @foreach (var k in Model.NganhTheoKhoa)
                {
                    <option value="@k.TenKhoa" selected="@(k.TenKhoa == selKhoa)">@k.TenKhoa</option>
                }
            </select>
        </div>
        <div class="tk-f">
            <label for="nganh">Ngành</label>
            <select id="nganh" name="nganh" class="tk-input">
                <option value="">Tất cả ngành</option>
                @foreach (var n in Model.HoSoTheoNganh)
                {
                    <option value="@n.TenNganh" selected="@(n.TenNganh == selNganh)">@n.TenNganh</option>
                }
            </select>
        </div>
        <div class="tk-f">
            <label>Khoảng tháng</label>
            <div class="d-flex align-items-center gap-2">
                <input type="month" name="tuThang" value="@tuThang" class="tk-input" aria-label="Từ tháng" />
                <span>–</span>
                <input type="month" name="denThang" value="@denThang" class="tk-input" aria-label="Đến tháng" />
            </div>
        </div>
        <button type="submit" class="tk-btn tk-btn-teal">Xem báo cáo</button>
    </form>

    @* ===== 4 chỉ số tổng hợp ===== *@
    <div class="tk-kpis">
        <div class="tk-card tk-kpi">
            <span class="l">Hồ sơ trong kỳ</span>
            <span class="v">@tongHoSo</span>
            <span class="s">@soNganh ngành · @soKhoa khoa</span>
        </div>
        <div class="tk-card tk-kpi">
            <span class="l">Đạt sơ tuyển lũy kế</span>
            <span class="v">@tongDatSoTuyen / @tongHoSo</span>
            <span class="s">@Pct(tyLeSoTuyen) trên tổng hồ sơ đã nộp</span>
        </div>
        <div class="tk-card tk-kpi">
            <span class="l">Đã phỏng vấn lũy kế</span>
            <span class="v">@pv.TongHoSoDaPhongVan</span>
            <span class="s">@pv.SoHoSoTrungTuyen trúng + @pv.SoHoSoKhongTrungTuyen không trúng</span>
        </div>
        <div class="tk-card tk-kpi">
            <span class="l">Tỷ lệ trúng tuyển</span>
            <span class="v" style="color:var(--teal)">@Pct((double)pv.TyLeTrungTuyenPhanTram)</span>
            <span class="s">@pv.SoHoSoTrungTuyen trúng tuyển / @pv.TongHoSoDaPhongVan đã phỏng vấn lũy kế</span>
        </div>
    </div>

    @* ===== Quy mô theo khoa + Trạng thái hồ sơ ===== *@
    <div class="tk-row tk-row-2">
        <div class="tk-card">
            <h2>Quy mô và trúng tuyển theo khoa</h2>
            <p class="tk-sub">Số ngành, tổng chỉ tiêu và số hồ sơ có kết quả Trúng tuyển</p>
            <table class="tk-table">
                <thead>
                    <tr>
                        <th>Khoa</th>
                        <th class="n">Số ngành</th>
                        <th class="n">Chỉ tiêu</th>
                        <th class="n">Trúng tuyển</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model.NganhTheoKhoa)
                    {
                        <tr>
                            <td>@k.TenKhoa</td>
                            <td class="n" style="color:var(--muted)">@k.SoLuongNganh</td>
                            <td class="n" style="color:var(--muted)">@k.TongChiTieu</td>
                            <td class="n teal">@(trungTuyenKhoa.TryGetValue(k.TenKhoa, out var tt) ? tt : 0)</td>
                        </tr>
                    }
                    @if (!Model.NganhTheoKhoa.Any())
                    {
                        <tr>
                            <td colspan="4" class="tk-empty">Chưa có dữ liệu</td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td>Tổng cộng</td>
                        <td class="n">@tongNganhKhoa</td>
                        <td class="n">@tongChiTieu</td>
                        <td class="n">@tongTrung</td>
                    </tr>
                </tfoot>
            </table>
        </div>

        <div class="tk-card">
            <h2>Số hồ sơ theo trạng thái</h2>
            <p class="tk-sub">Trạng thái hiện tại · Tổng @tongHoSo hồ sơ</p>
            @{
                var i = 0;
            }
            @foreach (var t in Model.HoSoTheoTrangThai)
            {
                var mau = mauTrangThai[i++ % mauTrangThai.Length];
                <div class="tk-bar" title="@t.TyLePhanTram%">
                    <span class="lb">@t.TrangThai</span>
                    <div class="tr">
                        <div class="fl"
                             style="width:@W(tongHoSo == 0 ? 0 : (int)t.SoLuong * 100.0 / maxTrangThai); background:@mau">
                        </div>
                    </div>
                    <span class="nm">@t.SoLuong</span>
                </div>
            }
            <div class="tk-divider"></div>
            <p class="tk-note">Các nhóm trạng thái hiện tại không trùng nhau, nên số "Đạt sơ tuyển" hiện tại khác với số
                đã qua sơ tuyển lũy kế.</p>
            </div>
        </div>

        @* ===== Biểu đồ theo tháng + Ngành nổi bật ===== *@
        <div class="tk-row tk-row-3">
            <div class="tk-card">
                <h2>Hồ sơ nộp và lịch phỏng vấn theo tháng</h2>
                <p class="tk-sub">Hồ sơ theo ngày nộp · Lịch theo ngày bắt đầu, gồm cả lịch Đã hủy</p>
                <div class="tk-legend">
                    <span><i style="background:var(--teal)"></i>Hồ sơ nộp · @tongHsThang</span>
                    <span><i style="background:#1d405e"></i>Lịch phỏng vấn · @tongLichThang</span>
                </div>
                @if (!thangs.Any())
                {
                    <div class="tk-empty">Chưa có dữ liệu</div>
                }
                else
                {
                    <div class="tk-chart">
                        <div class="tk-axis"><span>@maxCot</span><span>@(maxCot / 2)</span><span>0</span></div>
                        <div class="tk-cols">
                            @foreach (var th in thangs)
                            {
                                var h = Hs(th.Nam, th.Thang);
                                var l = Lich(th.Nam, th.Thang);
                                <div class="tk-col">
                                    <div class="tk-pair">
                                        <div style="height:@W(h * 100.0 / maxCot); background:var(--teal)"><span
                                            style="color:var(--teal)">@h</span></div>
                                            <div style="height:@W(l * 100.0 / maxCot); background:#1d405e"><span
                                                style="color:#1d405e">@l</span></div>
                                            </div>
                                            <small>@th.Thang.ToString("00")/@th.Nam</small>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex flex-column" style="gap:20px">
                        @if (Model.NganhNhieuHoSoNhat != null)
                        {
                            var top = Model.NganhNhieuHoSoNhat;
                            var phanTramTop = tongHoSo == 0 ? 0 : (int)top.SoLuongHoSo * 100.0 / tongHoSo;
                            <div class="tk-hero">
                                <div class="t">🏆 Ngành nhận nhiều hồ sơ nhất</div>
                                <div class="name">@top.TenNganh</div>
                                <div class="big"><b>@top.SoLuongHoSo hồ sơ</b><span>@Pct(phanTramTop) tổng hồ sơ</span></div>
                                <div class="d">@top.TenKhoa · Chỉ tiêu @top.ChiTieu · Dẫn đầu trong @soNganh ngành tuyển sinh.</div>
                            </div>
                        }
                        <div class="tk-info">
                            <span>ⓘ</span>
                            <div>
                                <b>Mẫu số của các tỷ lệ</b>
                                Sơ tuyển: số đạt sơ tuyển lũy kế / số hồ sơ ngành. Trúng tuyển: số trúng tuyển / số đã phỏng vấn lũy
                                kế, gồm cả hồ sơ đã có kết quả.
                            </div>
                        </div>
                    </div>
                </div>

                @* ===== Hiệu quả theo ngành ===== *@
                <div>
                    <div class="tk-detail-head">
                        <div>
                            <h2>Hiệu quả tuyển sinh theo ngành</h2>
                            <p>Đủ @soNganh ngành · Số hồ sơ, sơ tuyển lũy kế và tỷ lệ qua sơ tuyển</p>
                        </div>
                        <span class="tk-pill tk-pill-teal">Số liệu lũy kế trong kỳ</span>
                    </div>
                    <div class="tk-card tk-big">
                        <div style="overflow-x:auto">
                            <table class="tk-table">
                                <thead>
                                    <tr>
                                        <th>Ngành tuyển sinh</th>
                                        <th class="n">Chỉ tiêu</th>
                                        <th class="n">Số hồ sơ</th>
                                        <th class="n">Đạt sơ tuyển<br />lũy kế</th>
                                        <th style="min-width:240px">Tỷ lệ qua sơ tuyển</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var n in Model.HoSoTheoNganh)
                                    {
                                        soTuyen.TryGetValue(n.TenNganh, out var st);
                                        int tong = st != null ? (int)st.TongHoSo : (int)n.SoLuongHoSo;
                                        int dat = st != null ? (int)st.SoDatSoTuyen : 0;
                                        double tl = st != null ? (double)st.TyLePhanTram : 0;
                                        <tr>
                                            <td style="font-weight:600">@n.TenNganh</td>
                                            <td class="n" style="color:var(--muted)">@n.ChiTieu</td>
                                            <td class="n" style="color:var(--muted)">@n.SoLuongHoSo</td>
                                            <td class="n teal">@dat</td>
                                            <td>
                                                <div class="tk-mini">
                                                    <div class="tr">
                                                        <div class="fl" style="width:@W(tl)"></div>
                                                    </div>
                                                    <span class="teal" style="white-space:nowrap">@(tong == 0 ? "—" : $"{dat}/{tong} ·                 {Pct(tl)}")</span>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    @if (!Model.HoSoTheoNganh.Any())
                                    {
                                        <tr>
                                            <td colspan="5" class="tk-empty">Chưa có dữ liệu</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td>Tổng cộng</td>
                                        <td class="n">@Model.HoSoTheoNganh.Sum(x => (int)x.ChiTieu)</td>
                                        <td class="n">@Model.HoSoTheoNganh.Sum(x => (int)x.SoLuongHoSo)</td>
                                        <td class="n">@tongDatSoTuyen</td>
                                        <td>@(tongHoSo == 0 ? "—" : $"{tongDatSoTuyen}/{tongHoSo} · {Pct(tyLeSoTuyen)}")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                    <p class="tk-note" style="margin-top:14px">Ngành chưa có hồ sơ vẫn được liệt kê để đủ phạm vi báo cáo; tỷ lệ
                        hiển thị "—" khi chưa có mẫu số.</p>
                    </div>

                    <div class="tk-foot">
                        <span>UNETI · Hệ thống quản lý tuyển sinh và hồ sơ xét tuyển</span>
                        <span>Dữ liệu tại @DateTime.Now.ToString("dd/MM/yyyy, HH:mm") · GMT+7</span>
                    </div>
                </div>
