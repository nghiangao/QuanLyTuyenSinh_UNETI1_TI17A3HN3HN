</style>

<div class="pv">
    <div class="pv-crumb">23 / Cán bộ tuyển sinh / Lịch phỏng vấn</div>

    <div class="pv-head">
        <div>
            <h1 class="pv-title">Quản lý lịch phỏng vấn</h1>
            <p class="pv-sub">
                @tongLich lịch ·
                @ds.Count(x => x.TrangThai == TrangThaiLich.DaHoanThanh) đã hoàn thành,
                @ds.Count(x => x.TrangThai == TrangThaiLich.DaLenLich) sắp tới,
                @ds.Count(x => x.TrangThai == TrangThaiLich.DaHuy) đã hủy.
                Xem lịch sử và thao tác theo trạng thái.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Dashboard" class="pv-btn">Tổng quan</a>
            <a asp-action="Create" class="pv-btn pv-btn-primary">+ Lập lịch phỏng vấn</a>
        </div>
    </div>

    @if (TempData["ThongBao"] != null)
    {
        <div class="alert alert-success shadow-sm">@TempData["ThongBao"]</div>
    }
    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger shadow-sm">@TempData["Loi"]</div>
    }

    @* ===== Tìm kiếm & bộ lọc ===== *@
    <form asp-action="Index" method="get" class="pv-card">
        <h2>Tìm kiếm &amp; bộ lọc</h2>
        <div class="pv-grid pv-grid-2">
            <div class="pv-field">
                <label for="tuKhoa">Tìm kiếm</label>
                <input id="tuKhoa" name="tuKhoa" value="@tuKhoa" class="pv-input"
                       placeholder="Mã hồ sơ, thí sinh hoặc người phỏng vấn…" />
            </div>
            <div class="pv-field">
                <label for="sapXep">Sắp xếp</label>
                <select id="sapXep" name="sapXep" class="pv-input">
                    <option value="batdau_asc" selected="@(sapXep == "batdau_asc")">Thời gian bắt đầu tăng dần</option>
                    <option value="batdau_desc" selected="@(sapXep == "batdau_desc")">Thời gian bắt đầu giảm dần
                    </option>
                    <option value="thisinh_asc" selected="@(sapXep == "thisinh_asc")">Tên thí sinh A → Z</option>
                </select>
            </div>
        </div>

        <button type="button" class="pv-toggle" id="pvToggleFilter" aria-expanded="@(coLoc ? "true" : "false")">
            Bộ lọc nâng cao <span id="pvToggleIcon">@(coLoc ? "▴" : "▾")</span>
        </button>

        <div id="pvAdvanced" style="display:@(coLoc ? "block" : "none")">
            <div class="pv-grid pv-grid-3">
                <div class="pv-field">
                    <label>Thời gian</label>
                    <div class="d-flex gap-2 align-items-center">
                        <input type="date" name="tuNgay" value="@tuNgay" class="pv-input" aria-label="Từ ngày" />
                        <span>–</span>
                        <input type="date" name="denNgay" value="@denNgay" class="pv-input" aria-label="Đến ngày" />
                    </div>
                </div>
                <div class="pv-field">
                    <label for="trangThai">Trạng thái lịch</label>
                    <select id="trangThai" name="trangThai" class="pv-input">
                        <option value="">Tất cả</option>
                        @foreach (var tt in new[] { TrangThaiLich.DaLenLich, TrangThaiLich.DaHoanThanh,
                        TrangThaiLich.DaHuy })
                        {
                            <option value="@tt" selected="@(tt.ToString() == trangThaiDangLoc)">@tt</option>
                        }
                    </select>
                </div>
                <div class="pv-field">
                    <label for="hinhThuc">Hình thức</label>
                    <select id="hinhThuc" name="hinhThuc" class="pv-input">
                        <option value="">Tất cả · Trực tiếp / Trực tuyến</option>
                        <option value="Trực tiếp" selected="@(hinhThucDangLoc == "Trực tiếp")">Trực tiếp</option>
                        <option value="Trực tuyến" selected="@(hinhThucDangLoc == "Trực tuyến")">Trực tuyến</option>
                    </select>
                </div>
            </div>
        </div>

        <div class="pv-actions">
            <button type="submit" class="pv-btn pv-btn-primary">Áp dụng</button>
            <a asp-action="Index" class="pv-btn">Xóa bộ lọc</a>
            @if (!string.IsNullOrEmpty(tuNgay) && DateTime.TryParse(tuNgay, out var dtTu))
            {
                <a class="pv-chip" href="@UrlGiu(1, null, "tuNgay")">Từ @dtTu.ToString("dd/MM/yyyy") ×</a>
            }
            @if (!string.IsNullOrEmpty(denNgay) && DateTime.TryParse(denNgay, out var dtDen))
            {
                <a class="pv-chip" href="@UrlGiu(1, null, "denNgay")">Đến @dtDen.ToString("dd/MM/yyyy") ×</a>
            }
            @if (!string.IsNullOrEmpty(trangThaiDangLoc))
            {
                <a class="pv-chip" href="@UrlGiu(1, null, "trangThai")">@trangThaiDangLoc ×</a>
            }
            @if (!string.IsNullOrEmpty(hinhThucDangLoc))
            {
                <a class="pv-chip" href="@UrlGiu(1, null, "hinhThuc")">@hinhThucDangLoc ×</a>
            }
        </div>
        <p class="pv-hint">Điều kiện tìm kiếm, lọc và sắp xếp được giữ khi chuyển trang.</p>
    </form>

    @* ===== Danh sách lịch ===== *@
    <div class="pv-card">
        <h2>Danh sách lịch · @DateTime.Now.Year</h2>
        <div class="pv-table-wrap">
            <table class="pv-table">
                <thead>
                    <tr>
                        <th>Mã lịch / Hồ sơ</th>
                        <th>Thí sinh</th>
                        <th>Thời gian</th>
                        <th>Người phỏng vấn</th>
                        <th>Hình thức / Nơi</th>
                        <th>Trạng thái</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in ds)
                    {
                        var dangChon = chon != null && item.MaLichPhongVan == chon.MaLichPhongVan;
                        <tr class="pv-row @(dangChon ? "active" : "")" data-href="@UrlGiu(null, item.MaLichPhongVan)">
                            <td class="pv-id">@item.MaLichPhongVan · @item.MaHoSo</td>
                            <td>@item.HoSoXetTuyen?.ThiSinh?.HoTen</td>
                            <td>@item.ThoiGianBatDau.ToString("dd/MM") ·
                                @item.ThoiGianBatDau.ToString("HH:mm")–@item.ThoiGianKetThuc.ToString("HH:mm")</td>
                                <td>@item.NguoiPhongVan?.HoTen</td>
                                <td>@item.HinhThucPhongVan@(string.IsNullOrWhiteSpace(item.DiaDiemHoacLienKet) ? "" : " · " +
                                                                item.DiaDiemHoacLienKet)</td>
                                    <td><span class="@BadgeClass(item.TrangThai)">@item.TrangThai</span></td>
                                    <td class="text-end">
                                        <a asp-action="Details" asp-route-id="@item.MaLichPhongVan" class="pv-btn"
                                           style="padding:6px 10px">Chi tiết</a>
                                    </td>
                                </tr>
                            }
                            @if (!ds.Any())
                            {
                                <tr>
                                    <td colspan="7" class="pv-empty">Chưa có lịch phỏng vấn nào phù hợp.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="pv-paging">
                    <span class="pv-muted">@batDau–@ketThuc / @tongBanGhi bản ghi · @pageSize / trang</span>
                    <div class="pv-paging-ctl">
                        <a class="pv-btn @(trang <= 1 ? "disabled" : "")" href="@UrlGiu(Math.Max(trang - 1, 1))">‹ Trước</a>
                        <span class="pv-chip">Trang @trang / @tongTrang</span>
                        <a class="pv-btn @(trang >= tongTrang ? "disabled" : "")"
                           href="@UrlGiu(Math.Min(trang + 1, tongTrang))">Sau ›</a>
                    </div>
                </div>
                <p class="pv-hint">Hiển thị @ds.Count / @tongBanGhi lịch, gồm lịch đã hủy. Toàn đợt có @tongLich lịch.</p>
            </div>

            @* ===== Chi tiết đang chọn ===== *@
            @if (chon != null)
            {
                var daLenLich = chon.TrangThai == TrangThaiLich.DaLenLich;
                var daHuy = chon.TrangThai == TrangThaiLich.DaHuy;
                var choNhap = chon.TrangThai == TrangThaiLich.DaHoanThanh
                                && chon.HoSoXetTuyen?.TrangThai == TrangThaiHoSo.DaPhongVan;
                var moTa = $"{chon.MaLichPhongVan} · {chon.MaHoSo}, {chon.ThoiGianBatDau:dd/MM/yyyy HH:mm}–{chon.ThoiGianKetThuc:HH:mm}";

                <div class="pv-card">
                    <h2>Chi tiết đang chọn · @chon.MaLichPhongVan</h2>
                    <div class="pv-grid pv-grid-2">
                        <dl class="pv-dl">
                            <dt>Mã lịch</dt>
                            <dd>@chon.MaLichPhongVan</dd>
                            <dt>Hồ sơ / Thí sinh</dt>
                            <dd>@chon.MaHoSo · @chon.HoSoXetTuyen?.ThiSinh?.HoTen</dd>
                            <dt>Ngành</dt>
                            <dd>@chon.HoSoXetTuyen?.NganhTuyenSinh?.TenNganh</dd>
                            <dt>Bắt đầu</dt>
                            <dd>@chon.ThoiGianBatDau.ToString("dd/MM/yyyy · HH:mm")</dd>
                            <dt>Kết thúc</dt>
                            <dd>@chon.ThoiGianKetThuc.ToString("dd/MM/yyyy · HH:mm")</dd>
                        </dl>
                        <dl class="pv-dl">
                            <dt>Hình thức</dt>
                            <dd>@chon.HinhThucPhongVan</dd>
                            <dt>Địa điểm</dt>
                            <dd>@chon.DiaDiemHoacLienKet</dd>
                            <dt>Người phỏng vấn</dt>
                            <dd>@chon.NguoiPhongVan?.HoTen</dd>
                            <dt>Ghi chú</dt>
                            <dd>@(string.IsNullOrWhiteSpace(chon.GhiChu) ? "—" : chon.GhiChu)</dd>
                            <dt>Trạng thái lịch</dt>
                            <dd><span class="@BadgeClass(chon.TrangThai)">@chon.TrangThai</span></dd>
                        </dl>
                    </div>
                    <dl class="pv-dl" style="margin-top:12px">
                        <dt>Trạng thái hồ sơ</dt>
                        <dd>@chon.HoSoXetTuyen?.TrangThai</dd>
                        <dt>Khoa</dt>
                        <dd>@chon.HoSoXetTuyen?.NganhTuyenSinh?.Khoa?.TenKhoa</dd>
                    </dl>

                    <div class="pv-note">
                        <strong>Lịch hiệu lực của @chon.MaHoSo</strong>
                        <span>Chỉ một lịch hiệu lực cho mỗi hồ sơ. Lịch đã hủy được giữ trong lịch sử, không còn tham gia kiểm tra
                            trùng lịch.</span>
                        </div>

                        <div class="pv-actions" style="margin-top:0">
                            @if (daLenLich)
                            {
                                <a asp-action="Details" asp-route-id="@chon.MaLichPhongVan" class="pv-btn pv-btn-primary">Chi tiết lịch</a>
                                <button type="button" class="pv-btn pv-btn-danger" data-pv-modal="huy" data-id="@chon.MaLichPhongVan"
                                        data-mota="@moTa">Hủy lịch</button>
                                <button type="button" class="pv-btn" data-pv-modal="hoanthanh" data-id="@chon.MaLichPhongVan"
                                        data-mota="@moTa">Hoàn thành phỏng vấn</button>
                            }
                            else
                            {
                                <a asp-action="Details" asp-route-id="@chon.MaLichPhongVan" class="pv-btn">Chi tiết lịch</a>
                                <span class="pv-btn disabled">Hủy lịch</span>
                                <span class="pv-btn disabled">Hoàn thành phỏng vấn</span>
                            }
                            @if (choNhap)
                            {
                                <a asp-action="NhapKetQua" asp-route-id="@chon.MaLichPhongVan" class="pv-btn pv-btn-warning">Nhập kết
                                    quả</a>
                                }
                                <a asp-controller="HoSoXetTuyen" asp-action="Details" asp-route-id="@chon.MaHoSo" class="pv-btn">Xem hồ sơ
                                    @chon.MaHoSo</a>
                                </div>
                                @if (daHuy)
                                {
                                    <p class="pv-hint">Lịch đã hủy · Chỉ xem. Lịch cũ vẫn được lưu, không được hoàn thành hoặc sửa thành lịch mới.
                                    </p>
                                }
                            </div>

                            @* ===== Lịch sử của hồ sơ ===== *@
                            <div class="pv-card">
                                <h2>Lịch sử của hồ sơ @chon.MaHoSo</h2>
                                <div class="pv-table-wrap">
                                    <table class="pv-table">
                                        <thead>
                                            <tr>
                                                <th>Mã lịch</th>
                                                <th>Thời gian</th>
                                                <th>Người phỏng vấn</th>
                                                <th>Hình thức / Nơi</th>
                                                <th>Trạng thái</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var h in lichSu)
                                            {
                                                <tr>
                                                    <td class="pv-id">@h.MaLichPhongVan</td>
                                                    <td>@h.ThoiGianBatDau.ToString("dd/MM/yyyy · HH:mm")–@h.ThoiGianKetThuc.ToString("HH:mm")</td>
                                                    <td>@h.NguoiPhongVan?.HoTen</td>
                                                    <td>@h.HinhThucPhongVan@(string.IsNullOrWhiteSpace(h.DiaDiemHoacLienKet) ? "" : " · " +
                                                                                    h.DiaDiemHoacLienKet)</td>
                                                        <td><span class="@BadgeClass(h.TrangThai)">@h.TrangThai</span></td>
                                                    </tr>
                                                }
                                                @if (!lichSu.Any())
                                                {
                                                    <tr>
                                                        <td colspan="5" class="pv-empty">Hồ sơ này chưa có lịch nào khác.</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                    <p class="pv-hint">Không xóa lịch cũ; khi hủy, bản ghi không còn tham gia kiểm tra trùng lịch.</p>
                                </div>
                            }

                            <div class="pv-foot">
                                <span>Đề tài 21 · Nhóm 5 · ASP.NET Core MVC</span>
                            </div>
                        </div>

                        @* ===== Hộp xác nhận Hủy / Hoàn thành ===== *@
                        <div class="pv-modal-bg" id="pvModalBg" role="dialog" aria-modal="true">
                            <form method="post" id="pvModalForm" class="pv-modal">
                                @Html.AntiForgeryToken()
                                <h3 id="pvModalTitle"></h3>
                                <p id="pvModalBody"></p>
                                <div class="d-flex gap-2">
                                    <button type="button" class="pv-btn" id="pvModalCancel">Quay lại</button>
                                    <button type="submit" class="pv-btn" id="pvModalOk"></button>
                                </div>
                            </form>
                        </div>

                        @section Scripts {
                            <script>
                                (function () {
                                    // Mở/đóng bộ lọc nâng cao
                                    const tg = document.getElementById('pvToggleFilter'), adv = document.getElementById('pvAdvanced'), ic = document.getElementById('pvToggleIcon');
                                    tg.addEventListener('click', function () {
                                        const open = adv.style.display === 'none';
                                        adv.style.display = open ? 'block' : 'none';
                                        ic.textContent = open ? '▴' : '▾';
                                        tg.setAttribute('aria-expanded', open);
                                    });

                                    // Bấm dòng để chọn lịch (trừ khi bấm vào nút/liên kết)
                                    document.querySelectorAll('tr.pv-row').forEach(function (tr) {
                                        tr.addEventListener('click', function (e) {
                                            if (e.target.closest('a,button,form')) return;
                                            window.location = tr.dataset.href;
                                        });
                                    });

                                    // Hộp xác nhận
                                    const bg = document.getElementById('pvModalBg'), form = document.getElementById('pvModalForm'),
                                        title = document.getElementById('pvModalTitle'), body = document.getElementById('pvModalBody'),
                                        ok = document.getElementById('pvModalOk');
                                    const cfg = {
                                        huy: {
                                            title: 'Xác nhận hủy lịch', action: '@Url.Action("Huy")', okText: 'Hủy lịch', okClass: 'pv-btn pv-btn-danger',
                                            body: function (m) { return 'Hủy ' + m + '? Giữ bản ghi lịch sử; lịch hủy không còn hiệu lực. Không tự coi hồ sơ là Đã hủy.'; }
                                        },
                                        hoanthanh: {
                                            title: 'Xác nhận hoàn thành', action: '@Url.Action("HoanThanh")', okText: 'Hoàn thành', okClass: 'pv-btn pv-btn-primary',
                                            body: function (m) { return m + ' đã diễn ra? Khi xác nhận, lịch chuyển Đã hoàn thành và hồ sơ chuyển Đã phỏng vấn.'; }
                                        }
                                    };
                                    document.querySelectorAll('[data-pv-modal]').forEach(function (btn) {
                                        btn.addEventListener('click', function () {
                                            const c = cfg[btn.dataset.pvModal];
                                            title.textContent = c.title;
                                            body.textContent = c.body(btn.dataset.mota);
                                            ok.textContent = c.okText; ok.className = c.okClass;
                                            form.action = c.action + '/' + encodeURIComponent(btn.dataset.id);
                                            bg.classList.add('open');
                                        });
                                    });
                                    function dong() { bg.classList.remove('open'); }
                                    document.getElementById('pvModalCancel').addEventListener('click', dong);
                                    bg.addEventListener('click', function (e) { if (e.target === bg) dong(); });
                                    document.addEventListener('keydown', function (e) { if (e.key === 'Escape') dong(); });
                                })();
                            </script>
                        }
