        background: #fff;
        color: var(--pv-ink);
        text-decoration: none;
        cursor: pointer;
        line-height: 1.3;
    }

    .pv-btn:hover {
        background: var(--pv-bg);
        color: var(--pv-ink);
    }

    .pv-btn-primary {
        background: var(--pv-primary);
        border-color: var(--pv-primary);
        color: #fff;
    }

    .pv-btn-primary:hover {
        background: #1a4786;
        color: #fff;
    }

    .pv-btn-danger {
        background: var(--pv-danger);
        border-color: var(--pv-danger);
        color: #fff;
    }

    .pv-btn-danger:hover {
        background: #9a3338;
        color: #fff;
    }

    .pv-btn-warning {
        background: #f5b942;
        border-color: #f5b942;
        color: #3d2b00;
    }

    .pv-btn[disabled],
    .pv-btn.disabled {
        background: var(--pv-bg);
        color: var(--pv-muted);
        border-color: var(--pv-line);
        cursor: not-allowed;
        pointer-events: none;
    }

    .pv-grid {
        display: grid;
        gap: 20px;
    }

    .pv-grid-2 {
        grid-template-columns: 1fr 1fr;
    }

    .pv-grid-3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .pv-field label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .pv-input {
        width: 100%;
        padding: 12px;
        font-size: 14px;
        border: 1px solid var(--pv-line);
        border-radius: 6px;
        background: #fff;
        color: var(--pv-ink);
    }

    .pv-input:focus {
        outline: 2px solid var(--pv-primary-soft);
        border-color: var(--pv-primary);
    }

    .pv-toggle {
        background: none;
        border: 0;
        padding: 0;
        margin: 16px 0;
        font-size: 13px;
        font-weight: 600;
        color: var(--pv-ink);
        cursor: pointer;
    }

    .pv-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .pv-hint {
        font-size: 12px;
        color: var(--pv-muted);
        margin: 12px 0 0;
    }

    .pv-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 8px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        background: var(--pv-primary-soft);
        color: var(--pv-primary);
        text-decoration: none;
    }

    .pv-table-wrap {
        border: 1px solid var(--pv-line);
        border-radius: 6px;
        overflow-x: auto;
    }

    .pv-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .pv-table th {
        background: var(--pv-bg);
        color: var(--pv-muted);
        font-weight: 600;
        font-size: 12px;
        text-align: left;
        padding: 13px 14px;
        white-space: nowrap;
    }

    .pv-table td {
        padding: 15px 14px;
        border-top: 1px solid var(--pv-line);
        vertical-align: middle;
    }

    .pv-table tr.pv-row {
        cursor: pointer;
    }

    .pv-table tr.pv-row:hover td {
