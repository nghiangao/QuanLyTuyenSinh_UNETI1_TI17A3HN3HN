    @@media (max-width: 992px) {

        .pv-grid-2,
        .pv-grid-3 {
            grid-template-columns: 1fr;
        }

        .pv-head {
            flex-direction: column;
        }

        .pv-dl {
            grid-template-columns: 130px 1fr;
        }
