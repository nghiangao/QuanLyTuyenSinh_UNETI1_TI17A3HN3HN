    }

    .pv-table tr.pv-row.active td {
        background: var(--pv-primary-soft);
    }

    .pv-table .pv-id {
        font-weight: 600;
    }

    .pv-badge {
        display: inline-block;
        padding: 4px 8px;
        font-size: 11px;
        font-weight: 600;
        border-radius: 6px;
        white-space: nowrap;
    }

    .pv-badge-primary {
        background: var(--pv-primary-soft);
        color: var(--pv-primary);
    }

    .pv-badge-success {
        background: var(--pv-success-soft);
        color: var(--pv-success);
    }

    .pv-badge-danger {
        background: var(--pv-danger-soft);
        color: var(--pv-danger);
    }

    .pv-empty {
        text-align: center;
        padding: 32px;
        color: var(--pv-muted);
    }

    .pv-paging {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
        gap: 12px;
        flex-wrap: wrap;
    }

    .pv-paging .pv-muted {
        font-size: 12px;
        color: var(--pv-muted);
    }

    .pv-paging-ctl {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .pv-dl {
        display: grid;
        grid-template-columns: 170px 1fr;
        gap: 12px 20px;
        margin: 0;
        font-size: 14px;
    }

    .pv-dl dt {
        color: var(--pv-muted);
        font-weight: 400;
    }

    .pv-dl dd {
        margin: 0;
        font-weight: 500;
    }

    .pv-note {
        background: var(--pv-primary-soft);
        border-radius: 6px;
        padding: 16px;
        margin: 16px 0;
    }

    .pv-note strong {
        display: block;
        font-size: 13px;
        color: var(--pv-primary);
        margin-bottom: 6px;
    }

    .pv-note span {
        font-size: 14px;
    }

    .pv-foot {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid var(--pv-line);
        padding-top: 16px;
        font-size: 11px;
        color: var(--pv-muted);
    }

    .pv-modal-bg {
        position: fixed;
        inset: 0;
        background: rgba(24, 43, 70, .45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1055;
        padding: 16px;
    }

    .pv-modal-bg.open {
        display: flex;
    }

    .pv-modal {
        background: #fff;
        border-radius: 10px;
        border: 1px solid var(--pv-line);
        padding: 20px;
        width: 100%;
        max-width: 400px;
    }

    .pv-modal h3 {
        font-size: 15px;
        font-weight: 700;
        margin: 0 0 14px;
    }

    .pv-modal p {
