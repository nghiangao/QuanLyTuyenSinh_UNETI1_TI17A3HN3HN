@*
    Họ và tên: Mã Đức Thịnh
    Mã sinh viên: 23103100314
    Nội dung thực hiện: Module 5 - Giao diện "Quản lý lịch phỏng vấn" (theo thiết kế Figma 23).
    - Tìm kiếm, sắp xếp, bộ lọc nâng cao (thời gian / trạng thái / hình thức), phân trang giữ điều kiện lọc.
    - Bảng danh sách: bấm dòng để xem "Chi tiết đang chọn" + "Lịch sử của hồ sơ".
    - Hoàn thành / Hủy chỉ dùng được khi "Đã lên lịch" (có hộp xác nhận); lịch đã hủy chỉ xem.
    - Nút "Nhập kết quả" hiện khi lịch hoàn thành và hồ sơ đang "Đã phỏng vấn".

    GHI CHÚ: các tham số GET view đọc thêm: tuKhoa, sapXep, tuNgay, denNgay, trangThai, hinhThuc, trang, chon.
    ViewBag tùy chọn (không có vẫn chạy): Trang, TongTrang, TongBanGhi, PageSize, TongLich, Chon.
    Tên thuộc tính đoán theo model, cần đối chiếu: item.MaHoSo, item.GhiChu, item.HoSoXetTuyen.Khoa.
*@
@model IEnumerable<LichPhongVan>

@{
    ViewData["Title"] = "Quản lý lịch phỏng vấn";

    var ds = Model.ToList();
    var q = Context.Request.Query;

    string? trangThaiDangLoc = (ViewBag.TrangThai as string) ?? q["trangThai"].ToString();
    string hinhThucDangLoc = q["hinhThuc"].ToString();
    string tuKhoa = q["tuKhoa"].ToString();
    string sapXep = string.IsNullOrEmpty(q["sapXep"]) ? "batdau_asc" : q["sapXep"].ToString();
    string tuNgay = q["tuNgay"].ToString();
    string denNgay = q["denNgay"].ToString();

    int trang = (ViewBag.Trang as int?) ?? 1;
    int tongTrang = (ViewBag.TongTrang as int?) ?? 1;
    int tongBanGhi = (ViewBag.TongBanGhi as int?) ?? ds.Count;
    int pageSize = (ViewBag.PageSize as int?) ?? Math.Max(ds.Count, 1);
    int tongLich = (ViewBag.TongLich as int?) ?? tongBanGhi;
    int batDau = ds.Count == 0 ? 0 : (trang - 1) * pageSize + 1;
    int ketThuc = ds.Count == 0 ? 0 : batDau + ds.Count - 1;

    bool coLoc = !string.IsNullOrEmpty(tuNgay) || !string.IsNullOrEmpty(denNgay)
              || !string.IsNullOrEmpty(trangThaiDangLoc) || !string.IsNullOrEmpty(hinhThucDangLoc);

    string chonId = (ViewBag.Chon?.ToString()) ?? q["chon"].ToString();
    var chon = ds.FirstOrDefault(x => x.MaLichPhongVan.ToString() == chonId) ?? ds.FirstOrDefault();

    var lichSu = chon == null
        ? new List<LichPhongVan>()
        : ds.Where(x => x.HoSoXetTuyen?.ThiSinh?.HoTen == chon.HoSoXetTuyen?.ThiSinh?.HoTen
                     && x.MaLichPhongVan != chon.MaLichPhongVan)
            .OrderByDescending(x => x.ThoiGianBatDau).ToList();

    // Tạo URL giữ nguyên điều kiện tìm kiếm / lọc / sắp xếp hiện tại
    string UrlGiu(int? trangMoi = null, object? chonMoi = null, string? boQua = null)
    {
        var p = new Dictionary<string, string?>();
        foreach (var k in new[] { "tuKhoa", "sapXep", "tuNgay", "denNgay", "trangThai", "hinhThuc" })
        {
            if (k == boQua) continue;
            var v = q[k].ToString();
            if (!string.IsNullOrEmpty(v)) p[k] = v;
        }
        if (trangMoi.HasValue) p["trang"] = trangMoi.Value.ToString();
        else if (!string.IsNullOrEmpty(q["trang"])) p["trang"] = q["trang"].ToString();
        if (chonMoi != null) p["chon"] = chonMoi.ToString();
        var qs = string.Join("&", p.Select(kv => $"{kv.Key}={Uri.EscapeDataString(kv.Value ?? "")}"));
        return Url.Action("Index") + (qs.Length > 0 ? "?" + qs : "");
    }

    string BadgeClass(string? tt) =>
        tt == TrangThaiLich.DaLenLich ? "pv-badge pv-badge-primary"
      : tt == TrangThaiLich.DaHoanThanh ? "pv-badge pv-badge-success"
      : "pv-badge pv-badge-danger";
}

