    }

    .pv-sub {
        font-size: 14px;
        color: var(--pv-muted);
        margin: 0;
    }

    .pv-card {
        background: var(--pv-card);
        border: 1px solid var(--pv-line);
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .pv-card h2 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 16px;
    }

    .pv-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
