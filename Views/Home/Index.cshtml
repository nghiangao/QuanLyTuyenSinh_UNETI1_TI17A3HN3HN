@*
    Họ và tên: Mã Đức Thịnh
    Mã sinh viên: 23103100314
    Nội dung thực hiện: Giao diện Trang chủ hệ thống - Tự động nhận diện Session / Vai trò và phân chia giao diện:
    1. Khách (Chưa đăng nhập)
    2. Admin (Quản trị viên)
    3. Cán bộ tuyển sinh
    4. Thí sinh
    (Giao diện mới đồng bộ theo thiết kế Figma)
*@
@model HomeDashboardViewModel

@{
    ViewData["Title"] = "Trang chủ Tuyển Sinh UNETI";

    string TenTrangThai(string s) => s switch
    {
        "ChoDuyet" => "Chờ duyệt",
        "DatSoTuyen" => "Đạt sơ tuyển",
        "KhongDatSoTuyen" => "Không đạt sơ tuyển",
        "ChoPhongVan" => "Chờ phỏng vấn",
        "DaPhongVan" => "Đã phỏng vấn",
        "TrungTuyen" => "Trúng tuyển",
        "KhongTrungTuyen" => "Không trúng tuyển",
        _ => s
    };
    string MauTrangThai(string s) => s switch
    {
        "ChoDuyet" => "ui-pill--amber",
        "DatSoTuyen" or "ChoPhongVan" => "ui-pill--blue",
        "DaPhongVan" => "ui-pill--teal",
        "TrungTuyen" => "ui-pill--green",
        "KhongDatSoTuyen" or "KhongTrungTuyen" => "ui-pill--red",
        _ => "ui-pill--muted"
    };
}

@if (!Model.IsAuthenticated)
{
    @* ===================== 1. KHÁCH VÃNG LAI ===================== *@
    <section class="ui-hero">
        <div class="ui-hero__text">
            <span class="ui-pill ui-pill--teal">Cổng tuyển sinh đại học 2026</span>
            <h1>Hệ thống quản lý tuyển sinh &amp; hồ sơ xét tuyển</h1>
            <p>
                Cổng thông tin tuyển sinh trực tuyến của Trường Đại học Kinh tế - Kỹ thuật Công nghiệp (UNETI).
                Nộp hồ sơ, theo dõi sơ tuyển, lịch phỏng vấn và kết quả trúng tuyển nhanh chóng, minh bạch.
            </p>
            <div class="ui-hero__actions">
                <a asp-controller="NganhTuyenSinh" asp-action="CongKhai" class="ui-btn ui-btn--light">
                    <partial name="_Icon" model='("graduation-cap", 16)' /><span>Xem các ngành đang tuyển</span>
                </a>
                <a asp-controller="TaiKhoan" asp-action="DangNhap" class="ui-btn ui-btn--primary">
                    <span>Đăng nhập hệ thống</span>
                </a>
                <a asp-controller="LichPhongVan" asp-action="LichCuaToi" class="ui-btn ui-btn--ghost">
                    <partial name="_Icon" model='("search", 16)' /><span>Tra cứu lịch &amp; kết quả</span>
                </a>
            </div>
        </div>
        <div class="ui-hero__stats">
            <div><strong>@Model.TongSoNganhDangTuyen</strong><span>Ngành đang tuyển</span></div>
            <div><strong>@Model.TongSoKhoa</strong><span>Khoa đào tạo</span></div>
        </div>
    </section>

    <section class="ui-grid ui-grid--3">
        <article class="ui-feature">
            <span class="ui-feature__icon"><partial name="_Icon" model='("graduation-cap", 22)' /></span>
            <h3>Ngành đào tạo đa dạng</h3>
            <p>Hơn @Model.TongSoNganhDangTuyen ngành đang mở tuyển sinh thuộc @Model.TongSoKhoa khoa chuyên môn của nhà trường.</p>
            <a asp-controller="NganhTuyenSinh" asp-action="CongKhai" class="ui-link">Xem ngành tuyển sinh →</a>
        </article>
        <article class="ui-feature">
            <span class="ui-feature__icon"><partial name="_Icon" model='("files", 22)' /></span>
            <h3>Nộp hồ sơ trực tuyến</h3>
            <p>Khai báo hồ sơ thí sinh, chọn ngành và nộp hồ sơ xét tuyển mọi lúc, mọi nơi, không cần đến trực tiếp.</p>
            <a asp-controller="TaiKhoan" asp-action="DangNhap" class="ui-link">Đăng nhập để nộp hồ sơ →</a>
        </article>
        <article class="ui-feature">
            <span class="ui-feature__icon"><partial name="_Icon" model='("search", 22)' /></span>
            <h3>Theo dõi &amp; tra cứu 24/7</h3>
            <p>Theo dõi tiến độ sơ duyệt, xem lịch phỏng vấn trực tiếp/trực tuyến và nhận kết quả trúng tuyển.</p>
            <a asp-controller="LichPhongVan" asp-action="LichCuaToi" class="ui-link">Tra cứu kết quả ngay →</a>
        </article>
    </section>

    <article class="ui-card">
        <header class="ui-card__head">
            <div>
                <h2>Các ngành đang nhận hồ sơ tuyển sinh</h2>
                <p>Đăng ký xét tuyển sớm để tăng cơ hội trúng tuyển</p>
            </div>
            <a asp-controller="NganhTuyenSinh" asp-action="CongKhai" class="ui-link">Xem tất cả ngành →</a>
        </header>

        @if (Model.NganhDangTuyen.Any())
        {
            <div class="ui-cards">
                @foreach (var ng in Model.NganhDangTuyen)
                {
                    <div class="ui-mini">
                        <span class="ui-pill ui-pill--green">Đang nhận hồ sơ</span>
                        <strong>@ng.TenNganh</strong>
                        <span>Khoa: @ng.Khoa?.TenKhoa</span>
                        <span>Chỉ tiêu: <b>@ng.ChiTieu</b> · Tổ hợp: @ng.ToHopXetTuyen</span>
                        <span>Điểm tối thiểu: <b class="ui-text-red">@ng.DiemXetTuyenToiThieu.ToString("0.00")</b></span>
                        <span class="ui-mini__deadline">Hạn nộp: @ng.HanNopHoSo.ToString("dd/MM/yyyy")</span>
                        <a asp-controller="NganhTuyenSinh" asp-action="Details" asp-route-id="@ng.MaNganh" class="ui-link">Chi tiết ngành →</a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="ui-empty">Hiện chưa có ngành nào trong thời gian nhận hồ sơ.</div>
        }
    </article>

    <article class="ui-card">
        <header class="ui-card__head">
            <div>
                <h2>Quy trình tuyển sinh 5 bước tại UNETI</h2>
                <p>Từ đăng nhập đến nhận kết quả trúng tuyển</p>
            </div>
        </header>
        <div class="ui-steps">
            <div class="ui-step"><b>1</b><strong>Đăng nhập tài khoản</strong><span>Dùng tài khoản thí sinh được cấp hoặc đăng ký mới</span></div>
            <div class="ui-step"><b>2</b><strong>Khai báo hồ sơ</strong><span>Cập nhật thông tin cá nhân, trường THPT, điểm thi và tổ hợp</span></div>
            <div class="ui-step"><b>3</b><strong>Nộp hồ sơ ngành</strong><span>Chọn ngành còn hạn nộp và gửi nguyện vọng trực tuyến</span></div>
            <div class="ui-step"><b>4</b><strong>Sơ tuyển &amp; phỏng vấn</strong><span>Cán bộ duyệt sơ tuyển và xếp lịch phỏng vấn (nếu có)</span></div>
            <div class="ui-step ui-step--last"><b>5</b><strong>Nhận kết quả</strong><span>Tra cứu kết quả trúng tuyển và hoàn thiện thủ tục nhập học</span></div>
        </div>
    </article>
}
else if (Model.VaiTro == VaiTro.Admin)
{
    @* ===================== 2. QUẢN TRỊ VIÊN ===================== *@
    <div class="ui-breadcrumb"><span>Trang chủ &nbsp;/&nbsp; Bàn làm việc quản trị</span></div>

    <div class="ui-pagehead">
        <div class="ui-pagehead__text">
            <h1>Bàn làm việc quản trị hệ thống <span class="ui-pill ui-pill--red">Admin</span></h1>
            <p>Xin chào, <strong>@Model.HoTen</strong>! Bạn có toàn quyền quản trị danh mục, phân quyền và giám sát toàn hệ thống.</p>
        </div>
        <a asp-controller="LichPhongVan" asp-action="ThongKe" class="ui-btn ui-btn--outline">
            <partial name="_Icon" model='("clipboard-check", 16)' /><span>Báo cáo thống kê LINQ</span>
        </a>
        <a asp-controller="LichPhongVan" asp-action="Dashboard" class="ui-btn ui-btn--primary">
            <partial name="_Icon" model='("chart-no-axes-combined", 16)' /><span>Dashboard 9 chỉ số</span>
        </a>
    </div>

    <section class="ui-grid ui-grid--4">
        <article class="ui-kpi ui-kpi--primary">
            <div class="ui-kpi__head"><span class="ui-kpi__label">Tổng hồ sơ xét tuyển</span><partial name="_Icon" model='("files", 19)' /></div>
            <div class="ui-kpi__value">@Model.TongSoHoSo</div>
            <div class="ui-kpi__note">Toàn bộ nguyện vọng nộp</div>
        </article>
        <article class="ui-kpi">
            <div class="ui-kpi__head"><span class="ui-kpi__label">Tổng thí sinh</span><partial name="_Icon" model='("users", 19)' /></div>
            <div class="ui-kpi__value">@Model.TongSoThiSinh</div>
            <div class="ui-kpi__note">Đã tạo tài khoản/hồ sơ</div>
        </article>
        <article class="ui-kpi">
            <div class="ui-kpi__head"><span class="ui-kpi__label">Ngành đang tuyển</span><partial name="_Icon" model='("graduation-cap", 19)' /></div>
            <div class="ui-kpi__value">@Model.TongSoNganhDangTuyen</div>
            <div class="ui-kpi__note">Đang mở cổng nhận hồ sơ</div>
        </article>
        <article class="ui-kpi">
            <div class="ui-kpi__head"><span class="ui-kpi__label">Lịch PV sắp tới</span><partial name="_Icon" model='("calendar-days", 19)' /></div>
            <div class="ui-kpi__value">@Model.SoLichPhongVanSapToi</div>
            <div class="ui-kpi__note">Đã lên lịch, chưa diễn ra</div>
        </article>
    </section>

    <article class="ui-card">
        <header class="ui-card__head">
            <div>
                <h2>Trung tâm điều hành các phân hệ</h2>
                <p>Truy cập nhanh 6 module của hệ thống</p>
            </div>
        </header>
        <div class="ui-modules">
            <a asp-controller="Khoa" asp-action="Index" class="ui-module">
                <span class="ui-module__icon"><partial name="_Icon" model='("building-2", 20)' /></span>
                <strong>Module 1: Khoa &amp; Tài khoản</strong>
                <span>Quản lý thêm, sửa, xóa khoa chuyên môn; kiểm soát ràng buộc khoa đang có ngành tuyển sinh.</span>
            </a>
            <a asp-controller="NganhTuyenSinh" asp-action="Index" class="ui-module">
                <span class="ui-module__icon"><partial name="_Icon" model='("graduation-cap", 20)' /></span>
                <strong>Module 2: Ngành tuyển sinh</strong>
                <span>Quản lý ngành, chỉ tiêu, tổ hợp xét tuyển, hạn nộp hồ sơ; tìm kiếm và phân trang.</span>
            </a>
            <a asp-controller="ThiSinh" asp-action="Index" class="ui-module">
                <span class="ui-module__icon"><partial name="_Icon" model='("users", 20)' /></span>
                <strong>Module 3: Quản lý thí sinh</strong>
                <span>Giám sát danh sách thí sinh, điểm thi THPT, tổ hợp và thành tích.</span>
            </a>
            <a asp-controller="HoSoXetTuyen" asp-action="Index" class="ui-module">
                <span class="ui-module__icon"><partial name="_Icon" model='("files", 20)' /></span>
                <strong>Module 4: Sơ tuyển hồ sơ</strong>
                <span>Thẩm định sơ tuyển (Đạt / Không đạt), cập nhật nhận xét và cảnh báo vượt chỉ tiêu.</span>
            </a>
            <a asp-controller="LichPhongVan" asp-action="Index" class="ui-module">
                <span class="ui-module__icon"><partial name="_Icon" model='("calendar-days", 20)' /></span>
                <strong>Module 5: Lịch &amp; Kết quả</strong>
                <span>Lập lịch phỏng vấn (chống trùng lịch), ghi nhận điểm 0-100, xác nhận trúng tuyển.</span>
            </a>
            <a asp-controller="LichPhongVan" asp-action="Dashboard" class="ui-module">
                <span class="ui-module__icon"><partial name="_Icon" model='("chart-no-axes-combined", 20)' /></span>
                <strong>M5.5 &amp; M5.6: Báo cáo LINQ</strong>
                <span>Dashboard 9 chỉ số tuyển sinh và 10 chuyên đề thống kê phân tích bằng LINQ.</span>
            </a>
        </div>
    </article>
}
else if (Model.VaiTro == VaiTro.CanBoTuyenSinh || Model.VaiTro == VaiTro.CanBo)
{
    @* ===================== 3. CÁN BỘ TUYỂN SINH ===================== *@
    <div class="ui-breadcrumb"><span>Trang chủ &nbsp;/&nbsp; Bàn làm việc cán bộ tuyển sinh</span></div>

    <div class="ui-pagehead">
        <div class="ui-pagehead__text">
            <h1>Bàn làm việc cán bộ tuyển sinh <span class="ui-pill ui-pill--teal">Cán bộ</span></h1>
            <p>Xin chào, <strong>@Model.HoTen</strong>! Hãy theo dõi và xử lý các hồ sơ xét tuyển và lịch phỏng vấn hôm nay.</p>
        </div>
        <a asp-controller="HoSoXetTuyen" asp-action="Index" class="ui-btn ui-btn--outline">
            <partial name="_Icon" model='("files", 16)' /><span>Duyệt hồ sơ sơ tuyển</span>
        </a>
        <a asp-controller="LichPhongVan" asp-action="Create" class="ui-btn ui-btn--primary">
            <partial name="_Icon" model='("plus", 16)' /><span>Lập lịch phỏng vấn mới</span>
        </a>
    </div>

    <section class="ui-grid ui-grid--4">
        <article class="ui-kpi ui-kpi--primary">
            <div class="ui-kpi__head"><span class="ui-kpi__label">Hồ sơ chờ duyệt</span><partial name="_Icon" model='("files", 19)' /></div>
            <div class="ui-kpi__value">@Model.SoHoSoChoDuyet</div>
            <div class="ui-kpi__note">Cần sơ tuyển ngay</div>
        </article>
        <article class="ui-kpi">
            <div class="ui-kpi__head"><span class="ui-kpi__label">Hồ sơ đạt sơ tuyển</span><partial name="_Icon" model='("clipboard-check", 19)' /></div>
            <div class="ui-kpi__value">@Model.SoHoSoDatSoTuyen</div>
            <div class="ui-kpi__note">Sẵn sàng lập lịch phỏng vấn</div>
        </article>
        <article class="ui-kpi">
            <div class="ui-kpi__head"><span class="ui-kpi__label">Lịch PV sắp tới</span><partial name="_Icon" model='("calendar-days", 19)' /></div>
            <div class="ui-kpi__value">@Model.SoLichPhongVanSapToi</div>
            <div class="ui-kpi__note">Lịch chưa diễn ra</div>
        </article>
        <article class="ui-kpi">
            <div class="ui-kpi__head"><span class="ui-kpi__label">Hồ sơ trúng tuyển</span><partial name="_Icon" model='("badge-check", 19)' /></div>
            <div class="ui-kpi__value">@Model.SoHoSoTrungTuyen</div>
            <div class="ui-kpi__note">Đã ghi nhận kết quả</div>
        </article>
    </section>

    <article class="ui-card">
        <header class="ui-card__head">
            <div>
                <h2>Các tác vụ xử lý chính trong ngày</h2>
                <p>Theo thứ tự quy trình nghiệp vụ</p>
            </div>
        </header>
        <div class="ui-modules ui-modules--3">
            <a asp-controller="HoSoXetTuyen" asp-action="Index" class="ui-module">
                <span class="ui-module__icon"><partial name="_Icon" model='("files", 20)' /></span>
                <strong>1. Tiếp nhận &amp; duyệt sơ tuyển</strong>
                <span>Kiểm tra thông tin thí sinh, đối chiếu tổ hợp môn và đánh giá Đạt / Không đạt sơ tuyển (M4).</span>
            </a>
            <a asp-controller="LichPhongVan" asp-action="Create" class="ui-module">
                <span class="ui-module__icon"><partial name="_Icon" model='("calendar-days", 20)' /></span>
                <strong>2. Sắp xếp lịch phỏng vấn</strong>
                <span>Lập lịch cho thí sinh đã đạt sơ tuyển, kiểm tra không trùng lịch thí sinh và người phỏng vấn (M5).</span>
            </a>
            <a asp-controller="LichPhongVan" asp-action="Index" class="ui-module">
                <span class="ui-module__icon"><partial name="_Icon" model='("badge-check", 20)' /></span>
                <strong>3. Hoàn thành &amp; nhập kết quả</strong>
                <span>Đánh dấu lịch đã diễn ra, nhập điểm đánh giá (0-100) và phê duyệt kết quả trúng tuyển (M5).</span>
            </a>
        </div>
    </article>
}
else if (Model.VaiTro == VaiTro.ThiSinh)
{
    @* ===================== 4. THÍ SINH ===================== *@
    <div class="ui-breadcrumb"><span>Trang chủ &nbsp;/&nbsp; Cổng thông tin thí sinh</span></div>

    <div class="ui-pagehead">
        <div class="ui-pagehead__text">
            <h1>Cổng thông tin thí sinh <span class="ui-pill ui-pill--green">Thí sinh</span></h1>
            <p>Xin chào, <strong>@Model.HoTen</strong>! Theo dõi nguyện vọng xét tuyển và lịch phỏng vấn của bạn tại đây.</p>
        </div>
        <a asp-controller="ThiSinh" asp-action="ThongTinCaNhan" class="ui-btn ui-btn--outline">
            <partial name="_Icon" model='("user", 16)' /><span>Cập nhật thông tin cá nhân</span>
        </a>
        <a asp-controller="NganhTuyenSinh" asp-action="CongKhai" class="ui-btn ui-btn--primary">
            <partial name="_Icon" model='("graduation-cap", 16)' /><span>Chọn ngành &amp; nộp hồ sơ mới</span>
        </a>
    </div>

    @if (Model.ThongTinThiSinh == null || !Model.ThongTinThiSinh.DiemThiTHPT.HasValue)
    {
        <div class="ui-alert ui-alert--warn" role="alert">
            <partial name="_Icon" model='("triangle-alert", 18)' />
            <div class="ui-alert__body">
                <strong>Bạn chưa hoàn thiện hồ sơ cá nhân / điểm thi THPT!</strong>
                <p>Hãy cập nhật họ tên, ngày sinh, số điện thoại, tổ hợp và điểm thi THPT để đủ điều kiện nộp hồ sơ xét tuyển.</p>
            </div>
            <a asp-controller="ThiSinh" asp-action="ThongTinCaNhan" class="ui-btn ui-btn--primary">Cập nhật ngay →</a>
        </div>
    }
    else
    {
        <section class="ui-grid ui-grid--4">
            <article class="ui-metric">
                <span class="ui-metric__label">Họ và tên</span>
                <span class="ui-metric__text">@Model.ThongTinThiSinh.HoTen</span>
            </article>
            <article class="ui-metric">
                <span class="ui-metric__label">Trường THPT</span>
                <span class="ui-metric__text">@(Model.ThongTinThiSinh.TruongTHPT ?? "Chưa cập nhật")</span>
            </article>
            <article class="ui-metric">
                <span class="ui-metric__label">Tổ hợp xét tuyển</span>
                <span class="ui-metric__text ui-text-teal">@(Model.ThongTinThiSinh.ToHopXetTuyen ?? "Chưa có")</span>
            </article>
            <article class="ui-metric">
                <span class="ui-metric__label">Điểm thi THPT</span>
                <span class="ui-metric__value ui-text-red">@(Model.ThongTinThiSinh.DiemThiTHPT?.ToString("0.00") ?? "—")</span>
            </article>
        </section>
    }

    <article class="ui-card">
        <header class="ui-card__head">
            <div>
                <h2>Các nguyện vọng xét tuyển của bạn</h2>
                <p>@Model.DanhSachHoSoCuaToi.Count hồ sơ · sắp xếp theo ngày nộp mới nhất</p>
            </div>
        </header>

        @if (!Model.DanhSachHoSoCuaToi.Any())
        {
            <div class="ui-empty">
                Bạn chưa nộp hồ sơ xét tuyển nào. Hãy chọn một ngành đang mở tuyển sinh để nộp nguyện vọng.
                <div style="margin-top:14px">
                    <a asp-controller="NganhTuyenSinh" asp-action="CongKhai" class="ui-btn ui-btn--primary">Khám phá các ngành đang tuyển</a>
                </div>
            </div>
        }
        else
        {
            <div class="ui-tablewrap">
                <table class="ui-table">
                    <thead>
                        <tr>
                            <th>Mã hồ sơ</th>
                            <th>Ngành đăng ký</th>
                            <th>Khoa đào tạo</th>
                            <th>Ngày nộp</th>
                            <th>Trạng thái</th>
                            <th>Lịch phỏng vấn</th>
                            <th>Kết quả</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var hs in Model.DanhSachHoSoCuaToi)
                        {
                            var tt = hs.TrangThai.ToString();
                            var lichMoiNhat = hs.LichPhongVans.OrderByDescending(l => l.ThoiGianBatDau).FirstOrDefault();
                            <tr>
                                <td class="ui-muted">#@hs.MaHoSo</td>
                                <td><strong>@hs.NganhTuyenSinh?.TenNganh</strong></td>
                                <td>@hs.NganhTuyenSinh?.Khoa?.TenKhoa</td>
                                <td>@hs.NgayNop.ToString("dd/MM/yyyy")</td>
                                <td><span class="ui-pill @MauTrangThai(tt)">@TenTrangThai(tt)</span></td>
                                <td>
                                    @if (lichMoiNhat != null)
                                    {
                                        <strong>@lichMoiNhat.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</strong>
                                        <div class="ui-muted">(@lichMoiNhat.HinhThucPhongVan)</div>
                                    }
                                    else
                                    {
                                        <span class="ui-muted">Chưa có lịch</span>
                                    }
                                </td>
                                <td>
                                    @if (hs.KetQuaXetTuyen != null)
                                    {
                                        var kq = hs.KetQuaXetTuyen;
                                        <span class="ui-pill @(kq.KetQua == KetQuaTuyen.TrungTuyen ? "ui-pill--green" : "ui-pill--red")">@kq.KetQua</span>
                                        @if (kq.DiemDanhGia.HasValue)
                                        {
                                            <div class="ui-muted">@kq.DiemDanhGia điểm</div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="ui-muted">Đang xét duyệt</span>
                                    }
                                </td>
                                <td class="ui-right">
                                    <a asp-controller="HoSoThiSinh" asp-action="TheoDoi" class="ui-btn ui-btn--outline ui-btn--sm">Chi tiết</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </article>
}
