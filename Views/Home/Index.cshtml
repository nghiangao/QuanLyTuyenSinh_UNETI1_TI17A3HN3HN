@*
    Họ và tên: Mã Đức Thịnh
    Mã sinh viên: 23103100314
    Nội dung thực hiện: Giao diện Trang chủ hệ thống - Tự động nhận diện Session / Vai trò và phân chia giao diện:
    1. Khách (Chưa đăng nhập)
    2. Admin (Quản trị viên)
    3. Cán bộ tuyển sinh
    4. Thí sinh
*@
@model HomeDashboardViewModel

@{
    ViewData["Title"] = "Trang chủ Tuyển Sinh UNETI";
}

@* =========================================================================
   TRƯỜNG HỢP 1: KHÁCH VÃNG LAI (CHƯA ĐĂNG NHẬP)
   ========================================================================= *@
@if (!Model.IsAuthenticated)
{
    @* Hero Banner *@
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border border-primary border-opacity-25" 
         style="background: linear-gradient(135deg, #eef4ff 0%, #ffffff 100%);">
        <div class="container-fluid py-3">
            <span class="badge bg-primary px-3 py-2 fs-6 mb-3">🎓 Cổng Tuyển Sinh Đại Học 2026</span>
            <h1 class="display-5 fw-bold text-primary mb-3">Hệ Thống Quản Lý Tuyển Sinh & Hồ Sơ Xét Tuyển</h1>
            <p class="col-md-9 fs-5 text-muted mb-4">
                Chào mừng bạn đến với Cổng thông tin tuyển sinh trực tuyến trường Đại học Kinh tế - Kỹ thuật Công nghiệp (UNETI). 
                Đăng ký tài khoản, nộp hồ sơ trực tuyến, theo dõi tiến độ sơ tuyển, lịch phỏng vấn và kết quả trúng tuyển nhanh chóng, minh bạch.
            </p>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="NganhTuyenSinh" asp-action="CongKhai" class="btn btn-primary btn-lg px-4 fw-semibold">
                    🎓 Xem các ngành đang tuyển
                </a>
                <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-outline-primary btn-lg px-4 fw-semibold">
                    🔑 Đăng nhập hệ thống
                </a>
                <a asp-controller="LichPhongVan" asp-action="LichCuaToi" class="btn btn-outline-secondary btn-lg px-4 fw-semibold">
                    🔍 Tra cứu lịch & kết quả
                </a>
            </div>
        </div>
    </div>

    @* 3 Thẻ tính năng nổi bật *@
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-primary border-4">
                <div class="card-body text-center p-4">
                    <div class="display-5 text-primary mb-3">🎓</div>
                    <h5 class="fw-bold">Ngành Đào Tạo Đa Dạng</h5>
                    <p class="text-muted small">
                        Hơn @Model.TongSoNganhDangTuyen ngành đào tạo đang mở tuyển sinh thuộc @Model.TongSoKhoa khoa chuyên môn mũi nhọn của nhà trường.
                    </p>
                    <a asp-controller="NganhTuyenSinh" asp-action="CongKhai" class="btn btn-sm btn-outline-primary">Xem ngành tuyển sinh →</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-success border-4">
                <div class="card-body text-center p-4">
                    <div class="display-5 text-success mb-3">📝</div>
                    <h5 class="fw-bold">Nộp Hồ Sơ Trực Tuyến</h5>
                    <p class="text-muted small">
                        Khai báo hồ sơ thí sinh, chọn ngành học yêu thích và nộp hồ sơ xét tuyển trực tuyến mọi lúc, mọi nơi, không cần đến trực tiếp.
                    </p>
                    <a asp-controller="TaiKhoan" asp-action="DangNhap" class="btn btn-sm btn-outline-success">Đăng nhập để nộp hồ sơ →</a>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 border-top border-info border-4">
                <div class="card-body text-center p-4">
                    <div class="display-5 text-info mb-3">🔍</div>
                    <h5 class="fw-bold">Theo Dõi & Tra Cứu 24/7</h5>
                    <p class="text-muted small">
                        Dễ dàng theo dõi tiến độ sơ duyệt hồ sơ, xem lịch phỏng vấn trực tiếp/trực tuyến và nhận kết quả trúng tuyển tức thì.
                    </p>
                    <a asp-controller="LichPhongVan" asp-action="LichCuaToi" class="btn btn-sm btn-outline-info">Tra cứu kết quả ngay →</a>
                </div>
            </div>
        </div>
    </div>

    @* Danh sách ngành tiêu biểu đang tuyển *@
    <div class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="fw-bold text-dark mb-0">🔥 Các ngành đang nhận hồ sơ tuyển sinh</h3>
                <p class="text-muted small mb-0">Đăng ký xét tuyển sớm để tăng cơ hội trúng tuyển</p>
            </div>
            <a asp-controller="NganhTuyenSinh" asp-action="CongKhai" class="btn btn-outline-primary btn-sm">Xem tất cả ngành →</a>
        </div>

        <div class="row g-3">
            @foreach (var ng in Model.NganhDangTuyen)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 hover-shadow">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <span class="badge bg-success mb-2">Đang nhận hồ sơ</span>
                                <h5 class="fw-bold text-primary mb-1">@ng.TenNganh</h5>
                                <div class="text-muted small mb-2">🏛️ Khoa: @ng.Khoa?.TenKhoa</div>
                                <div class="small mb-1"><strong>Chỉ tiêu:</strong> <span class="badge bg-light text-dark border">@ng.ChiTieu</span></div>
                                <div class="small mb-1"><strong>Tổ hợp:</strong> @ng.ToHopXetTuyen</div>
                                <div class="small mb-2"><strong>Điểm tối thiểu:</strong> <span class="text-danger fw-bold">@ng.DiemXetTuyenToiThieu.ToString("0.00")</span></div>
                                <div class="small text-muted mb-3">⏳ Hạn nộp: <strong class="text-dark">@ng.HanNopHoSo.ToString("dd/MM/yyyy")</strong></div>
                            </div>
                            <div class="d-grid gap-2">
                                <a asp-controller="NganhTuyenSinh" asp-action="Details" asp-route-id="@ng.MaNganh" class="btn btn-outline-primary btn-sm">
                                    Chi tiết ngành
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>

    @* Quy trình 5 bước tuyển sinh *@
    <div class="card shadow-sm border-0 bg-white p-4 mb-4">
        <h4 class="fw-bold text-center mb-4 text-primary">🚀 Quy Trình Tuyển Sinh 5 Bước Tại UNETI</h4>
        <div class="row text-center g-3">
            <div class="col">
                <div class="p-3 bg-light rounded-3 h-100">
                    <div class="fw-bold fs-3 text-primary mb-1">1</div>
                    <div class="fw-semibold">Đăng nhập tài khoản</div>
                    <small class="text-muted">Đăng nhập bằng tài khoản thí sinh được cấp hoặc đăng ký mới</small>
                </div>
            </div>
            <div class="col">
                <div class="p-3 bg-light rounded-3 h-100">
                    <div class="fw-bold fs-3 text-primary mb-1">2</div>
                    <div class="fw-semibold">Khai báo hồ sơ</div>
                    <small class="text-muted">Cập nhật thông tin cá nhân, trường THPT, điểm thi & tổ hợp</small>
                </div>
            </div>
            <div class="col">
                <div class="p-3 bg-light rounded-3 h-100">
                    <div class="fw-bold fs-3 text-primary mb-1">3</div>
                    <div class="fw-semibold">Nộp hồ sơ ngành</div>
                    <small class="text-muted">Chọn ngành học còn hạn nộp và gửi nguyện vọng trực tuyến</small>
                </div>
            </div>
            <div class="col">
                <div class="p-3 bg-light rounded-3 h-100">
                    <div class="fw-bold fs-3 text-primary mb-1">4</div>
                    <div class="fw-semibold">Sơ tuyển & Phỏng vấn</div>
                    <small class="text-muted">Cán bộ duyệt sơ tuyển và xếp lịch phỏng vấn (nếu có)</small>
                </div>
            </div>
            <div class="col">
                <div class="p-3 bg-light rounded-3 h-100">
                    <div class="fw-bold fs-3 text-success mb-1">5</div>
                    <div class="fw-semibold text-success">Nhận kết quả</div>
                    <small class="text-muted">Tra cứu kết quả trúng tuyển và hoàn thiện thủ tục nhập học</small>
                </div>
            </div>
        </div>
    </div>
}

@* =========================================================================
   TRƯỜNG HỢP 2: QUẢN TRỊ VIÊN (ADMIN)
   ========================================================================= *@
else if (Model.VaiTro == VaiTro.Admin)
{
    @* Welcome Header *@
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bold text-dark mb-0">Bàn Làm Việc Quản Trị Hệ Thống</h2>
                <span class="badge bg-danger fs-6">Admin</span>
            </div>
            <p class="text-muted mb-0 mt-1">Xin chào, <strong>@Model.HoTen</strong>! Bạn có toàn quyền quản trị danh mục, phân quyền và giám sát toàn hệ thống.</p>
        </div>
        <div>
            <a asp-controller="LichPhongVan" asp-action="Dashboard" class="btn btn-primary me-2">
                📊 Dashboard 9 chỉ số
            </a>
            <a asp-controller="LichPhongVan" asp-action="ThongKe" class="btn btn-outline-primary">
                📈 Báo cáo thống kê LINQ
            </a>
        </div>
    </div>

    @* 4 Thẻ chỉ số tổng quan nhanh *@
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 border-start border-primary border-4">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Tổng Thí Sinh</div>
                    <div class="fs-2 fw-bold text-primary mt-1">@Model.TongSoThiSinh</div>
                    <small class="text-muted">Đã tạo tài khoản/hồ sơ</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 border-start border-info border-4">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Tổng Hồ Sơ Xét Tuyển</div>
                    <div class="fs-2 fw-bold text-info mt-1">@Model.TongSoHoSo</div>
                    <small class="text-muted">Toàn bộ nguyện vọng nộp</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 border-start border-success border-4">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Ngành Đang Tuyển</div>
                    <div class="fs-2 fw-bold text-success mt-1">@Model.TongSoNganhDangTuyen</div>
                    <small class="text-muted">Đang mở cổng nhận hồ sơ</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 border-start border-warning border-4">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Lịch PV Sắp Tới</div>
                    <div class="fs-2 fw-bold text-warning mt-1">@Model.SoLichPhongVanSapToi</div>
                    <small class="text-muted">Đã lên lịch, chưa diễn ra</small>
                </div>
            </div>
        </div>
    </div>

    @* Hub quản lý các phân hệ Module *@
    <h4 class="fw-bold mb-3 text-dark">🚀 Trung Tâm Điều Hành Các Phân Hệ (Modules)</h4>
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0 hover-shadow">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 fs-3 me-3">🏛️</div>
                        <div>
                            <h5 class="fw-bold mb-0">Module 1: Khoa & Tài Khoản</h5>
                            <small class="text-muted">Quản trị danh mục khoa đào tạo</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Quản lý thêm, sửa, xóa các khoa chuyên môn; kiểm soát ràng buộc khoa đang có ngành tuyển sinh.</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="Khoa" asp-action="Index" class="btn btn-outline-primary btn-sm">Quản lý Khoa đào tạo →</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0 hover-shadow">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-3 bg-info bg-opacity-10 text-info rounded-3 fs-3 me-3">🎓</div>
                        <div>
                            <h5 class="fw-bold mb-0">Module 2: Ngành Tuyển Sinh</h5>
                            <small class="text-muted">Chỉ tiêu, tổ hợp & phân trang</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Quản lý danh sách ngành, chỉ tiêu tuyển sinh, tổ hợp xét tuyển, hạn nộp hồ sơ, tìm kiếm & phân trang LINQ.</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="NganhTuyenSinh" asp-action="Index" class="btn btn-outline-info btn-sm">Quản lý Ngành tuyển sinh →</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0 hover-shadow">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-3 bg-secondary bg-opacity-10 text-secondary rounded-3 fs-3 me-3">👥</div>
                        <div>
                            <h5 class="fw-bold mb-0">Module 3: Quản Lý Thí Sinh</h5>
                            <small class="text-muted">Hồ sơ cá nhân & thông tin THPT</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Giám sát danh sách toàn bộ thí sinh đăng ký trong hệ thống, điểm thi THPT, tổ hợp và thành tích.</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="ThiSinh" asp-action="Index" class="btn btn-outline-secondary btn-sm">Danh sách thí sinh →</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0 hover-shadow">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-3 bg-warning bg-opacity-10 text-warning rounded-3 fs-3 me-3">📁</div>
                        <div>
                            <h5 class="fw-bold mb-0">Module 4: Sơ Tuyển Hồ Sơ</h5>
                            <small class="text-muted">Duyệt hồ sơ & kiểm soát chỉ tiêu</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Tiếp nhận hồ sơ xét tuyển, thẩm định sơ tuyển (Đạt / Không đạt), cập nhật nhận xét và cảnh báo vượt chỉ tiêu.</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="HoSoXetTuyen" asp-action="Index" class="btn btn-outline-warning btn-sm">Xử lý sơ tuyển hồ sơ →</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0 hover-shadow">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-3 bg-success bg-opacity-10 text-success rounded-3 fs-3 me-3">📅</div>
                        <div>
                            <h5 class="fw-bold mb-0">Module 5: Lịch & Kết Quả</h5>
                            <small class="text-muted">Lập lịch phỏng vấn & Xét trúng tuyển</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Lập lịch phỏng vấn (chống trùng lịch), ghi nhận điểm đánh giá 0-100, xác nhận trúng tuyển/không trúng tuyển.</p>
                    <div class="d-grid gap-2">
                        <a asp-controller="LichPhongVan" asp-action="Index" class="btn btn-outline-success btn-sm">Quản lý Lịch phỏng vấn →</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100 border-0 hover-shadow">
                <div class="card-body">
                    <div class="d-flex align-items-center mb-3">
                        <div class="p-3 bg-primary bg-opacity-10 text-primary rounded-3 fs-3 me-3">📊</div>
                        <div>
                            <h5 class="fw-bold mb-0">M5.5 & M5.6: Báo Cáo LINQ</h5>
                            <small class="text-muted">Dashboard 9 chỉ số & 10 báo cáo</small>
                        </div>
                    </div>
                    <p class="text-muted small mb-3">Bảng điều khiển 9 chỉ số tuyển sinh theo thời gian thực và 10 chuyên đề thống kê phân tích chuyên sâu bằng LINQ.</p>
                    <div class="d-flex gap-2">
                        <a asp-controller="LichPhongVan" asp-action="Dashboard" class="btn btn-outline-primary btn-sm flex-fill">Dashboard</a>
                        <a asp-controller="LichPhongVan" asp-action="ThongKe" class="btn btn-outline-success btn-sm flex-fill">Thống kê LINQ</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* =========================================================================
   TRƯỜNG HỢP 3: CÁN BỘ TUYỂN SINH
   ========================================================================= *@
else if (Model.VaiTro == VaiTro.CanBoTuyenSinh || Model.VaiTro == VaiTro.CanBo)
{
    @* Welcome Header *@
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bold text-dark mb-0">Bàn Làm Việc Cán Bộ Tuyển Sinh</h2>
                <span class="badge bg-primary fs-6">Cán bộ tuyển sinh</span>
            </div>
            <p class="text-muted mb-0 mt-1">Xin chào, <strong>@Model.HoTen</strong>! Hãy theo dõi và xử lý các hồ sơ xét tuyển và lịch phỏng vấn hôm nay.</p>
        </div>
        <div>
            <a asp-controller="HoSoXetTuyen" asp-action="Index" class="btn btn-warning me-2">
                ⏳ Duyệt hồ sơ sơ tuyển
            </a>
            <a asp-controller="LichPhongVan" asp-action="Create" class="btn btn-primary">
                ➕ Lập lịch phỏng vấn mới
            </a>
        </div>
    </div>

    @* 4 Thẻ chỉ số tiến độ công việc *@
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 border-start border-warning border-4">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Hồ Sơ Chờ Duyệt</div>
                    <div class="fs-2 fw-bold text-warning mt-1">@Model.SoHoSoChoDuyet</div>
                    <small class="text-muted">Cần sơ tuyển ngay</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 border-start border-primary border-4">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Hồ Sơ Đạt Sơ Tuyển</div>
                    <div class="fs-2 fw-bold text-primary mt-1">@Model.SoHoSoDatSoTuyen</div>
                    <small class="text-muted">Sẵn sàng lập lịch phỏng vấn</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 border-start border-info border-4">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Lịch PV Sắp Tới</div>
                    <div class="fs-2 fw-bold text-info mt-1">@Model.SoLichPhongVanSapToi</div>
                    <small class="text-muted">Lịch chưa diễn ra</small>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="card shadow-sm border-0 border-start border-success border-4">
                <div class="card-body">
                    <div class="text-muted small fw-semibold text-uppercase">Hồ Sơ Trúng Tuyển</div>
                    <div class="fs-2 fw-bold text-success mt-1">@Model.SoHoSoTrungTuyen</div>
                    <small class="text-muted">Đã ghi nhận kết quả</small>
                </div>
            </div>
        </div>
    </div>

    @* Lối tắt tác vụ nhanh của Cán bộ *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white fw-bold py-3">
            📋 Các tác vụ xử lý chính trong ngày
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 border rounded bg-light">
                        <h6 class="fw-bold text-warning mb-2">1. Tiếp nhận & Duyệt sơ tuyển</h6>
                        <p class="small text-muted mb-3">Kiểm tra thông tin thí sinh, đối chiếu tổ hợp môn và đánh giá Đạt / Không đạt sơ tuyển.</p>
                        <a asp-controller="HoSoXetTuyen" asp-action="Index" class="btn btn-sm btn-outline-warning w-100">Vào duyệt hồ sơ (M4)</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 border rounded bg-light">
                        <h6 class="fw-bold text-primary mb-2">2. Sắp xếp lịch phỏng vấn</h6>
                        <p class="small text-muted mb-3">Lập lịch phỏng vấn cho thí sinh đã đạt sơ tuyển, kiểm tra không bị trùng lịch thí sinh & người phỏng vấn.</p>
                        <a asp-controller="LichPhongVan" asp-action="Create" class="btn btn-sm btn-outline-primary w-100">Lập lịch mới (M5)</a>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 border rounded bg-light">
                        <h6 class="fw-bold text-success mb-2">3. Hoàn thành & Nhập kết quả</h6>
                        <p class="small text-muted mb-3">Đánh dấu lịch phỏng vấn đã diễn ra, nhập điểm đánh giá (0-100) và phê duyệt kết quả trúng tuyển.</p>
                        <a asp-controller="LichPhongVan" asp-action="Index" class="btn btn-sm btn-outline-success w-100">Danh sách lịch phỏng vấn (M5)</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* =========================================================================
   TRƯỜNG HỢP 4: THÍ SINH
   ========================================================================= *@
else if (Model.VaiTro == VaiTro.ThiSinh)
{
    @* Welcome Header Thí sinh *@
    <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
        <div>
            <div class="d-flex align-items-center gap-2">
                <h2 class="fw-bold text-dark mb-0">Cổng Thông Tin Thí Sinh</h2>
                <span class="badge bg-success fs-6">Thí sinh</span>
            </div>
            <p class="text-muted mb-0 mt-1">Xin chào, <strong>@Model.HoTen</strong>! Theo dõi nguyện vọng xét tuyển và lịch phỏng vấn của bạn tại đây.</p>
        </div>
        <div>
            <a asp-controller="NganhTuyenSinh" asp-action="CongKhai" class="btn btn-primary me-2">
                🎓 Chọn ngành & Nộp hồ sơ mới
            </a>
            <a asp-controller="ThiSinh" asp-action="ThongTinCaNhan" class="btn btn-outline-secondary">
                👤 Cập nhật thông tin cá nhân
            </a>
        </div>
    </div>

    @* Kiểm tra thông tin cá nhân thí sinh *@
    @if (Model.ThongTinThiSinh == null || !Model.ThongTinThiSinh.DiemThiTHPT.HasValue)
    {
        <div class="alert alert-warning shadow-sm border-0 d-flex justify-content-between align-items-center mb-4 p-3">
            <div>
                <strong class="fs-6">⚠️ Bạn chưa hoàn thiện hồ sơ cá nhân / điểm thi THPT!</strong>
                <div class="small text-muted mt-1">Hãy cập nhật họ tên, ngày sinh, số điện thoại, tổ hợp và điểm thi THPT để đủ điều kiện nộp hồ sơ xét tuyển.</div>
            </div>
            <a asp-controller="ThiSinh" asp-action="ThongTinCaNhan" class="btn btn-warning btn-sm fw-bold px-3">
                Cập nhật ngay →
            </a>
        </div>
    }
    else
    {
        @* Card tóm tắt thông tin thí sinh *@
        <div class="card shadow-sm border-0 mb-4 border-start border-success border-4">
            <div class="card-body">
                <div class="row row-cols-2 row-cols-md-4 g-3 align-items-center">
                    <div>
                        <div class="text-muted small">Họ và tên</div>
                        <div class="fw-bold text-dark">@Model.ThongTinThiSinh.HoTen</div>
                    </div>
                    <div>
                        <div class="text-muted small">Trường THPT</div>
                        <div class="fw-bold text-dark">@(Model.ThongTinThiSinh.TruongTHPT ?? "Chưa cập nhật")</div>
                    </div>
                    <div>
                        <div class="text-muted small">Tổ hợp xét tuyển</div>
                        <div class="fw-bold text-primary">@(Model.ThongTinThiSinh.ToHopXetTuyen ?? "Chưa có")</div>
                    </div>
                    <div>
                        <div class="text-muted small">Điểm thi THPT</div>
                        <div class="fw-bold text-danger fs-5">@(Model.ThongTinThiSinh.DiemThiTHPT?.ToString("0.00") ?? "—")</div>
                    </div>
                </div>
            </div>
        </div>
    }

    @* Danh sách các nguyện vọng / hồ sơ đã nộp của thí sinh *@
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h5 class="fw-bold mb-0 text-dark">📋 Các nguyện vọng xét tuyển của bạn</h5>
            <span class="badge bg-light text-dark border">@Model.DanhSachHoSoCuaToi.Count hồ sơ</span>
        </div>
        <div class="card-body p-0">
            @if (!Model.DanhSachHoSoCuaToi.Any())
            {
                <div class="text-center py-5">
                    <div class="display-6 text-muted mb-3">📁</div>
                    <h5 class="fw-bold text-muted">Bạn chưa nộp hồ sơ xét tuyển nào</h5>
                    <p class="text-muted small mb-3">Hãy chọn một ngành đang mở tuyển sinh để nộp nguyện vọng xét tuyển ngay!</p>
                    <a asp-controller="NganhTuyenSinh" asp-action="CongKhai" class="btn btn-primary">
                        🎓 Khám phá các ngành đang tuyển sinh ngay
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã hồ sơ</th>
                                <th>Ngành đăng ký</th>
                                <th>Khoa đào tạo</th>
                                <th>Ngày nộp</th>
                                <th>Trạng thái hồ sơ</th>
                                <th>Lịch phỏng vấn</th>
                                <th>Kết quả</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var hs in Model.DanhSachHoSoCuaToi)
                            {
                                var badgeTrangThai = hs.TrangThai == TrangThaiHoSo.TrungTuyen ? "bg-success"
                                                   : hs.TrangThai == TrangThaiHoSo.KhongTrungTuyen ? "bg-danger"
                                                   : hs.TrangThai == TrangThaiHoSo.ChoPhongVan ? "bg-info text-dark"
                                                   : hs.TrangThai == TrangThaiHoSo.DaPhongVan ? "bg-primary"
                                                   : hs.TrangThai == TrangThaiHoSo.DatSoTuyen ? "bg-warning text-dark"
                                                   : "bg-secondary";

                                var lichMoiNhat = hs.LichPhongVans.OrderByDescending(l => l.ThoiGianBatDau).FirstOrDefault();
                                <tr>
                                    <td class="fw-bold text-muted">#@hs.MaHoSo</td>
                                    <td class="fw-semibold text-primary">@hs.NganhTuyenSinh?.TenNganh</td>
                                    <td>@hs.NganhTuyenSinh?.Khoa?.TenKhoa</td>
                                    <td>@hs.NgayNop.ToString("dd/MM/yyyy")</td>
                                    <td><span class="badge @badgeTrangThai">@hs.TrangThai</span></td>
                                    <td>
                                        @if (lichMoiNhat != null)
                                        {
                                            <div class="small">
                                                <strong>@lichMoiNhat.ThoiGianBatDau.ToString("dd/MM/yyyy HH:mm")</strong>
                                                <div class="text-muted">(@lichMoiNhat.HinhThucPhongVan)</div>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Chưa có lịch</span>
                                        }
                                    </td>
                                    <td>
                                        @if (hs.KetQuaXetTuyen != null)
                                        {
                                            var kq = hs.KetQuaXetTuyen;
                                            <span class="badge @(kq.KetQua == KetQuaTuyen.TrungTuyen ? "bg-success" : "bg-danger")">
                                                @kq.KetQua
                                            </span>
                                            @if (kq.DiemDanhGia.HasValue)
                                            {
                                                <div class="small text-muted fw-bold">@kq.DiemDanhGia điểm</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">Đang xét duyệt</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-controller="HoSoThiSinh" asp-action="TheoDoi" class="btn btn-sm btn-outline-primary">
                                            Chi tiết
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
