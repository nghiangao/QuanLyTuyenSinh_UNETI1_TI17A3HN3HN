@model QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models.TaiKhoanFormViewModel

@{
    ViewData["Title"] = "Xóa tài khoản";
}

<div class="container py-3" style="max-width: 750px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-danger mb-0">Xóa tài khoản</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại</a>
    </div>

    <div class="alert alert-warning shadow-sm">
        Bạn có chắc chắn muốn xóa tài khoản này? Tài khoản đã gắn với hồ sơ thí sinh sẽ không thể xóa.
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Tên đăng nhập</dt>
                <dd class="col-sm-9 fw-semibold">@Model.TenDangNhap</dd>
                <dt class="col-sm-3 text-muted">Họ tên</dt>
                <dd class="col-sm-9">@Model.HoTen</dd>
                <dt class="col-sm-3 text-muted">Vai trò</dt>
                <dd class="col-sm-9">@Model.VaiTro</dd>
            </dl>
        </div>
        <div class="card-footer bg-white d-flex gap-2">
            <form asp-action="Delete" asp-route-id="@Model.MaTaiKhoan" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">Xác nhận xóa tài khoản</button>
            </form>
            <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
        </div>
    </div>
</div>
