@model QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models.TaiKhoanFormViewModel

@{
    ViewData["Title"] = "Cập nhật tài khoản";
    ViewData["RequirePassword"] = false;
}

<h1 class="mb-3">Cập nhật tài khoản</h1>
<form asp-action="Edit" asp-route-id="@Model.MaTaiKhoan" method="post">
    <partial name="_Form" model="Model" view-data="ViewData" />
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
