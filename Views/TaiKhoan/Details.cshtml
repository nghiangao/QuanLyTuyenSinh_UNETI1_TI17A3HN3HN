@model QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models.TaiKhoanFormViewModel

@{
    ViewData["Title"] = "Chi tiết tài khoản";
}

<h1 class="mb-3">Chi tiết tài khoản</h1>
<dl class="row">
    <dt class="col-sm-3">Tên đăng nhập</dt>
    <dd class="col-sm-9">@Model.TenDangNhap</dd>
    <dt class="col-sm-3">Họ tên</dt>
    <dd class="col-sm-9">@Model.HoTen</dd>
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
    <dt class="col-sm-3">Vai trò</dt>
    <dd class="col-sm-9">@Model.VaiTro</dd>
    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">@(Model.TrangThai ? "Hoạt động" : "Đã khóa")</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.MaTaiKhoan" class="btn btn-primary">Sửa</a>
<a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
