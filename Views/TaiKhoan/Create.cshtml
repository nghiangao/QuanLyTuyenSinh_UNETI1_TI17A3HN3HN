@model QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models.TaiKhoanFormViewModel

@{
    ViewData["Title"] = "Thêm tài khoản";
    ViewData["RequirePassword"] = true;
}

<h1 class="mb-3">Thêm tài khoản</h1>
<form asp-action="Create" method="post">
    <partial name="_Form" model="Model" view-data="ViewData" />
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
