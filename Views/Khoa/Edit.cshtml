@model QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models.Khoa

@{
    ViewData["Title"] = "Cập nhật khoa";
}

<h1 class="mb-3">Cập nhật khoa</h1>
<form asp-action="Edit" asp-route-id="@Model.MaKhoa" method="post">
    <partial name="_Form" model="Model" />
    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
