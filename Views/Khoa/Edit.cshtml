@model QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models.Khoa

@{
    ViewData["Title"] = "Cập nhật khoa";
}

<div class="container py-3" style="max-width: 700px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary mb-0">Cập nhật khoa</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại danh sách</a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-4">
            <form asp-action="Edit" asp-route-id="@Model.MaKhoa" method="post">
                @Html.AntiForgeryToken()
                <partial name="_Form" model="Model" />
                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                    <a asp-action="Index" class="btn btn-outline-secondary">Hủy</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
