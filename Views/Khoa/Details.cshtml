@model QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models.Khoa

@{
    ViewData["Title"] = "Chi tiết khoa";
}

<h1 class="mb-3">Chi tiết khoa</h1>
<dl class="row">
    <dt class="col-sm-3">Tên khoa</dt>
    <dd class="col-sm-9">@Model.TenKhoa</dd>
    <dt class="col-sm-3">Email liên hệ</dt>
    <dd class="col-sm-9">@(Model.EmailLienHe ?? "—")</dd>
    <dt class="col-sm-3">Mô tả</dt>
    <dd class="col-sm-9">@(Model.MoTa ?? "—")</dd>
    <dt class="col-sm-3">Trạng thái</dt>
    <dd class="col-sm-9">@(Model.TrangThai ? "Hoạt động" : "Ngừng hoạt động")</dd>
    <dt class="col-sm-3">Ngành tuyển sinh</dt>
    <dd class="col-sm-9">
        @if (Model.NganhTuyenSinhs.Any())
        {
            <ul>
                @foreach (var nganh in Model.NganhTuyenSinhs)
                {
                    <li>@nganh.TenNganh</li>
                }
            </ul>
        }
        else
        {
            <span>Chưa có ngành tuyển sinh.</span>
        }
    </dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.MaKhoa" class="btn btn-primary">Sửa</a>
<a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
