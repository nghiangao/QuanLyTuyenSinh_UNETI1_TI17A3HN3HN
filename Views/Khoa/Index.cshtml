@*
    Giao diện "Quản lý khoa" - dàn lại theo thiết kế Figma "13 · Quản lý khoa":
    bộ lọc nâng cao thu gọn được, chip điều kiện lọc, mã khoa dạng K001, đổi trạng thái hoạt động,
    chỉ cho xóa khoa chưa có ngành liên kết, phân trang giữ điều kiện.

    Giữ nguyên hợp đồng cũ với controller: ViewBag.Search, ViewBag.TrangThai (bool?), tham số GET search, trangThai.
    Thêm tham số GET tùy chọn: sort (ten_asc | ten_desc | nganh_desc), page, pageSize.
    ViewBag tùy chọn (không có vẫn chạy): Sort, Page, PageSize, TotalPages, TotalItems, TongKhoa, TongNganh.
*@
@model IEnumerable<QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models.Khoa>

@{
    ViewData["Title"] = "Quản lý khoa";

    var ds = Model.ToList();
    string? search = ViewBag.Search as string;
    bool? trangThai = ViewBag.TrangThai as bool?;
    string sort = (ViewBag.Sort as string) ?? "ten_asc";

    int page = (ViewBag.Page as int?) ?? 1;
    int pageSize = (ViewBag.PageSize as int?) ?? Math.Max(ds.Count, 1);
    int totalPages = Math.Max(1, (ViewBag.TotalPages as int?) ?? 1);
    int totalItems = (ViewBag.TotalItems as int?) ?? ds.Count;
    int tongKhoa = (ViewBag.TongKhoa as int?) ?? totalItems;
    int tongNganh = (ViewBag.TongNganh as int?) ?? ds.Sum(k => k.NganhTuyenSinhs.Count);
    int batDau = ds.Count == 0 ? 0 : (page - 1) * pageSize + 1;
    int ketThuc = ds.Count == 0 ? 0 : batDau + ds.Count - 1;

    bool coLocNangCao = trangThai.HasValue;

    string Trang(int p) => Url.Action("Index", new
    {
        search,
        sort,
        page = p,
        pageSize,
        trangThai = trangThai?.ToString().ToLower()
    })!;

    string BoLoc(string ten) => Url.Action("Index", new
    {
        search = ten == "search" ? null : search,
        trangThai = ten == "trangThai" ? null : trangThai?.ToString().ToLower(),
        sort,
        pageSize
    })!;
}

<style>
    .kh {
        --ink: #182b46;
        --muted: #63738a;
        --line: #dee5ee;
        --bg: #f3f6fa;
        --primary: #2057a5;
        --soft: #eaf1fc;
        --danger: #b43d43;
        font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
        color: var(--ink);
    }

    .kh * {
        box-sizing: border-box;
    }

    .kh-crumb {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--primary);
        margin-bottom: 12px;
    }

    .kh-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 24px;
        margin-bottom: 24px;
    }

    .kh h1 {
        font-size: 28px;
        font-weight: 700;
        margin: 0 0 8px;
        line-height: 1.2;
    }

    .kh-sub {
        font-size: 14px;
        color: var(--muted);
        margin: 0;
    }

    .kh-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 10px;
        padding: 24px;
        margin-bottom: 24px;
    }

    .kh-card h2 {
        font-size: 16px;
        font-weight: 700;
        margin: 0 0 16px;
    }

    .kh-grid {
        display: grid;
        gap: 20px;
    }

    .kh-grid-2 {
        grid-template-columns: 1fr 1fr;
    }

    .kh-field label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 7px;
    }

    .kh-input {
        width: 100%;
        padding: 12px;
        font-size: 14px;
        border: 1px solid var(--line);
        border-radius: 6px;
        background: #fff;
        color: var(--ink);
    }

    .kh-input:focus {
        outline: 2px solid var(--soft);
        border-color: var(--primary);
    }

    .kh-toggle {
        background: none;
        border: 0;
        padding: 0;
        margin: 16px 0;
        font-size: 13px;
        font-weight: 600;
        color: var(--ink);
        cursor: pointer;
    }

    .kh-actions {
        display: flex;
        gap: 12px;
        align-items: center;
        flex-wrap: wrap;
        margin-top: 16px;
    }

    .kh-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 10px 16px;
        font-size: 13px;
        font-weight: 600;
        border-radius: 6px;
        border: 1px solid var(--line);
        background: #fff;
        color: var(--ink);
        text-decoration: none;
        cursor: pointer;
        line-height: 1.3;
        white-space: nowrap;
    }

    .kh-btn:hover {
        background: var(--bg);
        color: var(--ink);
    }

    .kh-btn-primary {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
    }

    .kh-btn-primary:hover {
        background: #1a4786;
        color: #fff;
    }

    .kh-btn-sm {
        padding: 6px 12px;
        font-size: 12px;
    }

    .kh-btn-danger {
        color: var(--danger);
        border-color: #f0c9cb;
    }

    .kh-btn-danger:hover {
        background: #fceeef;
        color: var(--danger);
    }

    .kh-btn.disabled,
    .kh-btn[disabled] {
        background: var(--bg);
        color: #9aa8ba;
        border-color: var(--line);
        cursor: not-allowed;
        pointer-events: none;
    }

    .kh-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 8px;
        font-size: 12px;
        font-weight: 600;
        border-radius: 6px;
        background: var(--soft);
        color: var(--primary);
        text-decoration: none;
    }

    .kh-hint {
        font-size: 12px;
        color: var(--muted);
        margin: 12px 0 0;
    }

    .kh-wrap {
        border: 1px solid var(--line);
        border-radius: 6px;
        overflow-x: auto;
    }

    .kh-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

    .kh-table th {
        background: var(--bg);
        color: var(--muted);
        font-weight: 600;
        font-size: 12px;
        text-align: left;
        padding: 13px 14px;
        white-space: nowrap;
    }

    .kh-table td {
        padding: 15px 14px;
        border-top: 1px solid var(--line);
        vertical-align: middle;
    }

    .kh-table tbody tr:hover td {
        background: #f8fafd;
    }

    .kh-table .id {
        font-weight: 600;
        white-space: nowrap;
    }

    .kh-table .n {
        text-align: right;
    }

    .kh-badge {
        display: inline-block;
        padding: 4px 8px;
        font-size: 11px;
        font-weight: 600;
        border-radius: 6px;
        white-space: nowrap;
    }

    .kh-green {
        background: #eaf6ee;
        color: #23734d;
    }

    .kh-grey {
        background: #eef1f5;
        color: var(--muted);
    }

    .kh-empty {
        text-align: center;
        padding: 36px;
        color: var(--muted);
    }

    .kh-paging {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-top: 16px;
        gap: 12px;
        flex-wrap: wrap;
    }

    .kh-paging .m {
        font-size: 12px;
        color: var(--muted);
    }

    .kh-ctl {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .kh-note {
        background: var(--soft);
        border-radius: 6px;
        padding: 16px;
        margin-bottom: 24px;
    }

    .kh-note b {
        display: block;
        font-size: 13px;
        color: var(--primary);
        margin-bottom: 6px;
    }

    .kh-note span {
        font-size: 14px;
    }

    .kh-foot {
        display: flex;
        justify-content: space-between;
        border-top: 1px solid var(--line);
        padding-top: 16px;
        font-size: 11px;
        color: var(--muted);
    }

    @@media (max-width:992px) {
        .kh-grid-2 {
            grid-template-columns: 1fr;
        }

        .kh-head {
            flex-direction: column;
        }
    }
</style>

<div class="kh">
    <div class="kh-crumb">13 / Admin / Khoa</div>

    <div class="kh-head">
        <div>
            <h1>Quản lý khoa</h1>
            <p class="kh-sub">@tongKhoa khoa · @tongNganh ngành tuyển sinh. Quản lý danh mục khoa, thông tin liên hệ và
                hoạt động.</p>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="TaiKhoan" asp-action="Index" class="kh-btn">Quản lý tài khoản</a>
                <a asp-action="Create" class="kh-btn kh-btn-primary">+ Tạo khoa</a>
            </div>
        </div>

        @if (TempData["Success"] is string success)
        {
            <div class="alert alert-success shadow-sm">@success</div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="alert alert-danger shadow-sm">@error</div>
        }

        @* ===== Tìm kiếm & bộ lọc ===== *@
        <form method="get" asp-action="Index" class="kh-card">
            <h2>Tìm kiếm &amp; bộ lọc</h2>
            <div class="kh-grid kh-grid-2">
                <div class="kh-field">
                    <label for="search">Tìm kiếm</label>
                    <input id="search" name="search" value="@search" class="kh-input"
                           placeholder="Tên khoa hoặc email liên hệ…" />
                </div>
                <div class="kh-field">
                    <label for="sort">Sắp xếp</label>
                    <select id="sort" name="sort" class="kh-input">
                        <option value="ten_asc" selected="@(sort == "ten_asc")">Tên khoa A–Z</option>
                        <option value="ten_desc" selected="@(sort == "ten_desc")">Tên khoa Z–A</option>
                        <option value="nganh_desc" selected="@(sort == "nganh_desc")">Số ngành nhiều nhất</option>
                    </select>
                </div>
            </div>

            <button type="button" class="kh-toggle" id="khToggle" aria-expanded="@(coLocNangCao ? "true" : "false")">
                Bộ lọc nâng cao <span id="khIcon">@(coLocNangCao ? "▴" : "▾")</span>
            </button>

            <div id="khAdvanced" style="display:@(coLocNangCao ? "block" : "none")">
                <div class="kh-grid kh-grid-2">
                    <div class="kh-field">
                        <label for="trangThai">Hoạt động</label>
                        <select id="trangThai" name="trangThai" class="kh-input">
                            <option value="">Tất cả · Hoạt động / Ngừng hoạt động</option>
                            <option value="true" selected="@(trangThai == true)">Hoạt động</option>
                            <option value="false" selected="@(trangThai == false)">Ngừng hoạt động</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="kh-actions">
                <button type="submit" class="kh-btn kh-btn-primary">Áp dụng</button>
                <a asp-action="Index" class="kh-btn">Xóa bộ lọc</a>
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <a class="kh-chip" href="@BoLoc("search")">Từ khóa: @search ×</a>
                }
                @if (trangThai.HasValue)
                {
                    <a class="kh-chip" href="@BoLoc("trangThai")">@(trangThai.Value ? "Hoạt động" : "Ngừng hoạt động") ×</a>
                }
            </div>
            <p class="kh-hint">Điều kiện tìm kiếm, lọc và sắp xếp được giữ khi chuyển trang.</p>
        </form>

        @* ===== Danh sách khoa ===== *@
        <div class="kh-card">
            <h2>Danh sách khoa</h2>
            <div class="kh-wrap">
                <table class="kh-table">
                    <thead>
                        <tr>
                            <th>Mã khoa</th>
                            <th>Tên khoa</th>
                            <th>Email liên hệ</th>
                            <th class="n">Số ngành</th>
                            <th>Trạng thái</th>
                            <th class="n">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var khoa in ds)
                        {
                            var coNganh = khoa.NganhTuyenSinhs.Count > 0;
                            <tr>
                                <td class="id">K@(khoa.MaKhoa.ToString().PadLeft(3, '0'))</td>
                                <td><strong>@khoa.TenKhoa</strong></td>
                                <td>@(string.IsNullOrWhiteSpace(khoa.EmailLienHe) ? "—" : khoa.EmailLienHe)</td>
                                <td class="n">@khoa.NganhTuyenSinhs.Count</td>
                                <td>
                                    @if (khoa.TrangThai)
                                    {
                                        <span class="kh-badge kh-green">Hoạt động</span>
                                    }
                                    else
                                    {
                                        <span class="kh-badge kh-grey">Ngừng hoạt động</span>
                                    }
                                </td>
                                <td class="n" style="white-space:nowrap">
                                    <a asp-action="Details" asp-route-id="@khoa.MaKhoa" class="kh-btn kh-btn-sm">Xem</a>
                                    <a asp-action="Edit" asp-route-id="@khoa.MaKhoa" class="kh-btn kh-btn-sm">Sửa</a>
                                    <form asp-action="DoiTrangThai" asp-route-id="@khoa.MaKhoa" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="kh-btn kh-btn-sm">@(khoa.TrangThai ? "Ngừng hoạt động" :
                                              "Kích hoạt")</button>
                                        </form>
                                        @if (coNganh)
                                        {
                                            <span class="kh-btn kh-btn-sm disabled"
                                                  title="Khoa đã có ngành liên kết, hãy dùng trạng thái hoạt động thay vì xóa">Xóa</span>
                                        }
                                        else
                                        {
                                            <a asp-action="Delete" asp-route-id="@khoa.MaKhoa"
                                               class="kh-btn kh-btn-sm kh-btn-danger">Xóa</a>
                                        }
                                    </td>
                                </tr>
                            }
                            @if (!ds.Any())
                            {
                                <tr>
                                    <td colspan="6" class="kh-empty">Không có khoa phù hợp.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="kh-paging">
                    <span class="m">@batDau–@ketThuc / @totalItems bản ghi · @pageSize / trang</span>
                    <div class="kh-ctl">
                        <a class="kh-btn @(page <= 1 ? "disabled" : "")" href="@Trang(Math.Max(page - 1, 1))">‹ Trước</a>
                        <span class="kh-chip">Trang @(page) / @totalPages</span>
                        <a class="kh-btn @(page >= totalPages ? "disabled" : "")"
                           href="@Trang(Math.Min(page + 1, totalPages))">Sau ›</a>
                    </div>
                </div>
            </div>

            <div class="kh-note">
                <b>Bảo toàn dữ liệu tuyển sinh</b>
                <span>Chỉ xóa khoa chưa có ngành liên kết. Khi khoa có dữ liệu, dùng trạng thái hoạt động thay vì xóa.</span>
            </div>

            <div class="kh-foot">
                <span>Đề tài 21 · Nhóm 5 · ASP.NET Core MVC</span>
            </div>
        </div>

        @section Scripts {
            <script>
                (function () {
                    var tg = document.getElementById('khToggle'), adv = document.getElementById('khAdvanced'), ic = document.getElementById('khIcon');
                    tg.addEventListener('click', function () {
                        var open = adv.style.display === 'none';
                        adv.style.display = open ? 'block' : 'none';
                        ic.textContent = open ? '▴' : '▾';
                        tg.setAttribute('aria-expanded', open);
                    });
                })();
            </script>
        }
