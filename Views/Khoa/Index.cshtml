@model IEnumerable<QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models.Khoa>

@{
    ViewData["Title"] = "Quản lý khoa";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Quản lý khoa</h1>
    <div class="d-flex gap-2">
        <a asp-controller="TaiKhoan" asp-action="Index" class="btn btn-outline-primary">Quản lý tài khoản</a>
        <a asp-action="Create" class="btn btn-primary">Thêm khoa</a>
    </div>
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<form method="get" class="row g-2 mb-3">
    <div class="col-md-6">
        <input name="search" value="@ViewBag.Search" class="form-control" placeholder="Tìm tên khoa hoặc email liên hệ" />
    </div>
    <div class="col-md-3">
        <select name="trangThai" class="form-select">
            <option value="">Tất cả trạng thái</option>
            @if (ViewBag.TrangThai is true)
            {
                <option value="true" selected>Hoạt động</option>
            }
            else
            {
                <option value="true">Hoạt động</option>
            }
            @if (ViewBag.TrangThai is false)
            {
                <option value="false" selected>Ngừng hoạt động</option>
            }
            else
            {
                <option value="false">Ngừng hoạt động</option>
            }
        </select>
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Tên khoa</th>
                <th>Email liên hệ</th>
                <th>Số ngành</th>
                <th>Trạng thái</th>
                <th class="text-end">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var khoa in Model)
            {
                <tr>
                    <td>@khoa.TenKhoa</td>
                    <td>@(khoa.EmailLienHe ?? "—")</td>
                    <td>@khoa.NganhTuyenSinhs.Count</td>
                    <td>
                        @if (khoa.TrangThai)
                        {
                            <span class="badge text-bg-success">Hoạt động</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Ngừng hoạt động</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Details" asp-route-id="@khoa.MaKhoa" class="btn btn-sm btn-outline-info">Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@khoa.MaKhoa" class="btn btn-sm btn-outline-primary">Sửa</a>
                        <form asp-action="DoiTrangThai" asp-route-id="@khoa.MaKhoa" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-warning">@(khoa.TrangThai ? "Ngừng hoạt động" : "Kích hoạt")</button>
                        </form>
                        <a asp-action="Delete" asp-route-id="@khoa.MaKhoa" class="btn btn-sm btn-outline-danger">Xóa</a>
                    </td>
                </tr>
            }
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-center text-muted">Không có khoa phù hợp.</td></tr>
            }
        </tbody>
    </table>
</div>
