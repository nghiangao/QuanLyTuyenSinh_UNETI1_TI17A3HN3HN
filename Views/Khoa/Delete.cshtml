@model QuanLyTuyenSinh_UNETI1_TI17A3HN3HN.Models.Khoa

@{
    ViewData["Title"] = "Xóa khoa";
    var hasDepartments = Model.NganhTuyenSinhs.Any();
}

<div class="container py-3" style="max-width: 750px">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-danger mb-0">Xóa khoa</h2>
        <a asp-action="Index" class="btn btn-outline-secondary">← Quay lại</a>
    </div>

    @if (hasDepartments)
    {
        <div class="alert alert-warning shadow-sm">
            Khoa này đang có <strong>@Model.NganhTuyenSinhs.Count</strong> ngành tuyển sinh nên không thể xóa. Hãy chuyển khoa sang trạng thái ngừng hoạt động nếu không còn sử dụng.
        </div>
    }
    else
    {
        <div class="alert alert-danger shadow-sm">Bạn có chắc chắn muốn xóa khoa này không? Thao tác này không thể hoàn tác.</div>
    }

    <div class="card shadow-sm mb-3">
        <div class="card-body p-4">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-muted">Tên khoa</dt>
                <dd class="col-sm-9 fw-semibold">@Model.TenKhoa</dd>
                <dt class="col-sm-3 text-muted">Email liên hệ</dt>
                <dd class="col-sm-9">@(Model.EmailLienHe ?? "—")</dd>
                <dt class="col-sm-3 text-muted">Số ngành</dt>
                <dd class="col-sm-9">@Model.NganhTuyenSinhs.Count</dd>
            </dl>
        </div>
        <div class="card-footer bg-white d-flex gap-2">
            @if (!hasDepartments)
            {
                <form asp-action="Delete" asp-route-id="@Model.MaKhoa" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">Xác nhận xóa khoa</button>
                </form>
            }
            <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
        </div>
    </div>
</div>
